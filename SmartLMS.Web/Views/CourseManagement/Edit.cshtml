@model SmartLMS.Models.Course
@{
    ViewData["Title"] = "Chỉnh sửa Khóa Học";
    var instructors = ViewBag.Instructors as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<style>
    .wizard-step { display: none; }
    .wizard-step.active { display: block; }
    .nav-tabs-wizard .nav-link { border: none; background: #f8f9fa; margin-right: 5px; color: #6c757d; font-weight: 600; padding: 12px 20px; border-radius: 8px; }
    .nav-tabs-wizard .nav-link.active { background: #4338ca; color: white; }
    .nav-tabs-wizard .nav-link.done { background: #dcfce7; color: #15803d; }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-edit text-warning mr-2"></i>Edit Course Wizard</h1>
            </div>
            <div class="col-sm-6 text-right">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/CourseManagement">Courses</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-white py-3">
                        <ul class="nav nav-tabs nav-tabs-wizard border-0" id="wizard-tabs">
                            <li class="nav-item">
                                <a class="nav-link active" data-step="1" href="javascript:void(0)">1. Cơ bản</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-step="2" href="javascript:void(0)">2. SEO & AI</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-step="3" href="javascript:void(0)">3. Giá & Ảnh</a>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4">
                        <form asp-action="Edit" method="post" id="form-wizard" enctype="multipart/form-data">
                            <input type="hidden" asp-for="CourseId" />
                            <input type="hidden" asp-for="ThumbnailUrl" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                            @* ── STEP 1: BASIC INFO ── *@
                            <div class="wizard-step active" id="step-1">
                                <div class="row">
                                    <div class="col-md-9">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Tên khóa học</label>
                                            <input asp-for="Title" class="form-control form-control-lg" />
                                            <span asp-validation-for="Title" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Danh mục</label>
                                            <select asp-for="Category" class="form-control form-control-lg">
                                                <option value="Web">Web</option>
                                                <option value="AI">AI</option>
                                                <option value="Mobile">Mobile</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Giảng viên</label>
                                            <select asp-for="InstructorId" class="form-control form-control-lg">
                                                @foreach (var inst in instructors) {
                                                    <option value="@inst.UserId" selected="@(inst.UserId == Model.InstructorId)">@inst.FullName</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Trạng thái</label>
                                            <select asp-for="Status" class="form-control form-control-lg">
                                                <option value="Draft">Draft</option>
                                                <option value="Published">Published</option>
                                                <option value="Archived">Archived</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-4">
                                    <label class="font-weight-bold">Mô tả</label>
                                    <div id="quill-editor" style="height: 200px;">@Html.Raw(Model.Description)</div>
                                    <textarea asp-for="Description" class="d-none" id="hidden-description"></textarea>
                                </div>
                                <div class="text-right">
                                    <button type="button" class="btn btn-primary btn-next px-4" data-next="2">Tiếp theo</button>
                                </div>
                            </div>

                            @* ── STEP 2: SEO & AI ── *@
                            <div class="wizard-step" id="step-2">
                                <div class="form-group mb-3">
                                    <label class="font-weight-bold">SEO Title</label>
                                    <input asp-for="MetaTitle" class="form-control" />
                                </div>
                                <div class="form-group mb-3">
                                    <label class="font-weight-bold">SEO Description</label>
                                    <textarea asp-for="MetaDescription" class="form-control" rows="3"></textarea>
                                </div>
                                <div class="card bg-light border-0">
                                    <div class="card-body">
                                        <label class="small font-weight-bold">AI Base Salary Impact (₫)</label>
                                        <input asp-for="AI_BaseSalaryImpact" class="form-control" type="number" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between mt-4">
                                    <button type="button" class="btn btn-outline-secondary btn-prev" data-prev="1">Quay lại</button>
                                    <button type="button" class="btn btn-primary btn-next px-4" data-next="3">Tiếp theo</button>
                                </div>
                            </div>

                            @* ── STEP 3: PRICING & MEDIA ── *@
                            <div class="wizard-step" id="step-3">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Giá bán</label>
                                            <input asp-for="Price" class="form-control" type="number" id="input-price" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="font-weight-bold">Giá khuyến mãi</label>
                                            <input asp-for="DiscountPrice" class="form-control" type="number" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group mb-4">
                                    <label class="font-weight-bold d-block">Thumbnail</label>
                                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl)) {
                                        <div class="mb-2"><img src="@Model.ThumbnailUrl" style="height: 60px;" class="rounded shadow-sm" /></div>
                                    }
                                    <input type="file" name="thumbnail" class="form-control-file border p-2 rounded w-100" accept="image/*" onchange="previewFiles(this)" />
                                    <div id="thumb-preview-wrap" class="mt-2 text-center bg-light p-3 rounded d-none">
                                        <img id="thumb-img" src="#" style="max-height: 150px;" class="img-fluid rounded shadow-sm" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between mt-4 border-top pt-4">
                                    <button type="button" class="btn btn-outline-secondary btn-prev" data-prev="2">Quay lại</button>
                                    <button type="submit" class="btn btn-success px-5 font-weight-bold shadow">Lưu thay đổi</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        $(document).ready(function() {
            var quill = new Quill('#quill-editor', { theme: 'snow' });
            $('.btn-next').on('click', function() { switchStep($(this).data('next')); });
            $('.btn-prev').on('click', function() { switchStep($(this).data('prev')); });
            function switchStep(step) {
                $('.wizard-step').removeClass('active'); $(`#step-${step}`).addClass('active');
                $('#wizard-tabs .nav-link').removeClass('active'); $(`#wizard-tabs .nav-link[data-step="${step}"]`).addClass('active');
            }
            $('#form-wizard').on('submit', function() { $('#hidden-description').val(quill.root.innerHTML); });
        });
        function previewFiles(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) { $('#thumb-img').attr('src', e.target.result); $('#thumb-preview-wrap').removeClass('d-none'); }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
