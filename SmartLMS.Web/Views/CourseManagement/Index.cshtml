@model IEnumerable<SmartLMS.Models.Course>
@{
    ViewData["Title"] = "Quản lý khóa học";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary font-weight-bold">
            <i class="fas fa-book-open"></i> Quản lý khóa học
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-4">
            <i class="fas fa-plus"></i> Thêm khóa học mới
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-lg">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 text-center align-middle">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3">Hình ảnh</th>
                        <th>Tên khóa học</th>
                        <th>Danh mục</th>
                        <th>Giảng viên</th>
                        <th>Giá (VNĐ)</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="p-3">
                                @if(!string.IsNullOrEmpty(item.ThumbnailUrl)) {
                                    <img src="@item.ThumbnailUrl" class="img-thumbnail rounded" style="max-height:60px" alt="Course Thumbnail" />
                                } else {
                                    <div class="bg-secondary text-white rounded d-flex justify-content-center align-items-center" style="width:80px; height:60px; margin:0 auto;">No Image</div>
                                }
                            </td>
                            <td class="font-weight-bold">@item.Title</td>
                            <td><span class="badge bg-info text-dark">@item.Category</span></td>
                            <td>@(item.Instructor != null ? item.Instructor.FullName : "N/A")</td>
                            <td class="text-danger font-weight-bold">@string.Format("{0:N0}", item.Price) đ</td>
                            <td>
                                @if(item.Status == "Published") {
                                    <span class="badge bg-success">Đã xuất bản</span>
                                } else if(item.Status == "Draft") {
                                    <span class="badge bg-warning text-dark">Bản nháp</span>
                                } else {
                                    <span class="badge bg-secondary">Đã lưu trữ</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-sm btn-outline-danger rounded-pill">
                                    <i class="fas fa-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
