@{
    ViewData["Title"] = "AI Learning Analytics Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/premium-ui.css" />
    <style>
        .stat-card { transition: all 0.3s; border-radius: 20px; overflow: hidden; }
        .stat-card:hover { transform: translateY(-10px); box-shadow: var(--premium-neon); }
        .chart-container { height: 350px; }
    </style>
}

<div class="container-fluid py-4 animate-in">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-white font-weight-bold"><i class="fas fa-brain text-info mr-2"></i> Trí Tuệ Đào Tạo (AI Insights)</h1>
            <p class="text-muted">Phân tích hành vi học tập và dự báo rủi ro dựa trên dữ liệu thời gian thực.</p>
        </div>
    </div>

    <!-- Hàng 1: Thẻ thống kê nhanh -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="glass-panel stat-card p-4 text-center">
                <h6 class="text-white-50">Tỉ lệ rủi ro trung bình</h6>
                <h2 class="text-danger font-weight-bold">14.2%</h2>
                <small class="text-success"><i class="fas fa-arrow-down"></i> -2.1% so với tháng trước</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-panel stat-card p-4 text-center">
                <h6 class="text-white-50">Số lỗi (Mistakes) hôm nay</h6>
                <h2 class="text-warning font-weight-bold">1,204</h2>
                <small class="text-danger"><i class="fas fa-arrow-up"></i> +12%</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-panel stat-card p-4 text-center">
                <h6 class="text-white-50">Huy hiệu đã cấp</h6>
                <h2 class="text-info font-weight-bold">458</h2>
                <small class="text-white">Badge "Grand Master"</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-panel stat-card p-4 text-center">
                <h6 class="text-white-50">Độ chính xác AI</h6>
                <h2 class="text-success font-weight-bold">94.8%</h2>
                <small class="text-white">ML.NET Engine</small>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Biểu đồ -->
    <div class="row">
        <div class="col-lg-8">
            <div class="glass-panel p-4 mb-4">
                <h5 class="text-white mb-4"><i class="fas fa-chart-line mr-2"></i> Xu hướng rủi rớt môn (Predictive Risk Path)</h5>
                <div id="riskChart" class="chart-container"></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="glass-panel p-4 mb-4">
                <h5 class="text-white mb-4"><i class="fas fa-bug mr-2"></i> Phân loại lỗi phổ biến</h5>
                <div id="mistakeDonut" class="chart-container"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // Risk Chart
        var riskOptions = {
            series: [{
                name: 'Rủi ro rớt môn (%)',
                data: [15, 22, 18, 30, 25, 45, 38]
            }],
            chart: { height: 350, type: 'area', background: 'transparent', toolbar: { show: false } },
            theme: { mode: 'dark' },
            colors: ['#38bdf8'],
            stroke: { curve: 'smooth' },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.3 } },
            xaxis: { categories: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'CN'] }
        };
        new ApexCharts(document.querySelector("#riskChart"), riskOptions).render();

        // Mistake Donut
        var mistakeOptions = {
            series: [44, 32, 24],
            labels: ['Lỗi cú pháp (Syntax)', 'Lỗi logic', 'Lỗi Timeout'],
            chart: { type: 'donut', height: 350 },
            theme: { mode: 'dark' },
            colors: ['#ef4444', '#f59e0b', '#10b981'],
            legend: { position: 'bottom' }
        };
        new ApexCharts(document.querySelector("#mistakeDonut"), mistakeOptions).render();
    </script>
}
