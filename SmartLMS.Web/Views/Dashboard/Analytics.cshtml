@{
    ViewData["Title"] = "AI Prediction Analytics";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 font-weight-bold"><i class="fas fa-brain mr-2 text-primary"></i>Phân tích Trí tuệ Nhân tạo (AI)</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- Dropout Risk Forecasting -->
            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white">
                        <h3 class="card-title font-weight-bold"><i class="fas fa-user-graduate mr-2 text-danger"></i>Dự báo rủi ro rớt môn (ML.NET)</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Sinh viên</th>
                                        <th>Khóa học</th>
                                        <th>Tiến độ</th>
                                        <th>Xác suất rủi ro</th>
                                        <th>Cấp độ</th>
                                    </tr>
                                </thead>
                                <tbody id="risk-tbody">
                                    <tr><td colspan="5" class="text-center py-4"><i class="fas fa-spinner fa-spin mr-2"></i>Đang chạy mô hình AI...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Common Mistakes Analysis -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white">
                        <h3 class="card-title font-weight-bold"><i class="fas fa-exclamation-triangle mr-2 text-warning"></i>Phân tích lỗi phổ biến</h3>
                    </div>
                    <div class="card-body">
                        <div id="mistake-chart" style="min-height: 300px;"></div>
                    </div>
                </div>
                
                <div class="card shadow-sm border-0 rounded-lg mt-3 bg-gradient-info text-white">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-lightbulb fa-3x mb-3"></i>
                        <h5>AI Recommendation</h5>
                        <p class="small">Dựa trên dữ liệu, chúng tôi khuyên bạn nên bổ sung thêm bài tập cho các học viên có rủi ro "High".</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        $(document).ready(function() {
            loadAnalyticsData();

            function loadAnalyticsData() {
                $.get('/Dashboard/GetAnalyticsData', function(data) {
                    // Risk Table
                    let riskHtml = '';
                    data.riskPredictions.forEach(p => {
                        let badgeClass = p.riskLevel === 'High' ? 'badge-danger' : (p.riskLevel === 'Medium' ? 'badge-warning' : 'badge-success');
                        riskHtml += `
                            <tr>
                                <td><strong>${p.studentName}</strong></td>
                                <td>${p.courseName}</td>
                                <td>
                                    <div class="progress progress-xs" style="width: 100px;">
                                        <div class="progress-bar bg-info" style="width: ${p.progress}%"></div>
                                    </div>
                                    <small>${p.progress}%</small>
                                </td>
                                <td>${p.probability}%</td>
                                <td><span class="badge ${badgeClass} px-3 py-2">${p.riskLevel}</span></td>
                            </tr>
                        `;
                    });
                    $('#risk-tbody').html(riskHtml);

                    // Mistake Chart
                    const mistakeChart = new ApexCharts(document.querySelector("#mistake-chart"), {
                        series: data.commonMistakes.map(m => m.count),
                        labels: data.commonMistakes.map(m => m.type),
                        chart: { type: 'pie', height: 350 },
                        colors: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                        legend: { position: 'bottom' }
                    });
                    mistakeChart.render();
                });
            }
        });
    </script>
}
