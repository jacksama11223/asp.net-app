@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Content Header -->
<div class="content-header animate-fade">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0" style="font-weight: 700;">Hệ thống Quản trị SmartLMS</h1>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" id="btn-refresh" class="btn btn-outline-primary btn-sm shadow-sm">
                    <i data-lucide="refresh-cw" class="mr-1" style="width:14px; height:14px;"></i> Làm mới dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- 1. 3 Cột Stats (Sử dụng Info-Box) -->
        <div class="row">
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-info elevation-1"><i data-lucide="users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Tổng số Sinh viên</span>
                        <span id="total-students" class="info-box-number text-bold-xl">--</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-success elevation-1"><i data-lucide="check-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Tỉ lệ Hoàn thành</span>
                        <span id="avg-progress" class="info-box-number text-bold-xl">--%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-danger elevation-1"><i data-lucide="alert-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Rủi ro Bỏ học (AI)</span>
                        <span id="dropout-risk" class="info-box-number text-bold-xl">--%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 1.5 ApexCharts Section (WOW Factor) -->
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h3 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-chart-line mr-2 text-primary"></i>Xu hướng tương tác (AI Insights)</h3>
                        <div class="badge badge-pill badge-light text-primary py-2 px-3">Real-time Data</div>
                    </div>
                    <div class="card-body">
                        <div id="engagement-chart" style="min-height: 350px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white border-0 py-3">
                        <h3 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-chart-pie mr-2 text-info"></i>Cơ cấu Người dùng</h3>
                    </div>
                    <div class="card-body">
                        <div id="role-chart" style="min-height: 350px;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- 2. Nâng cấp Bảng bằng DataTables -->
            <div class="col-md-12">
                <div class="card card-outline card-primary shadow-sm">
                    <div class="card-header border-0 bg-white">
                        <h3 class="card-title" style="font-weight: 600;">Giám sát Hiệu suất Sinh viên</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive p-3">
                            <table id="activity-table" class="table table-hover align-middle">
                                <thead>
                                    <tr class="text-muted" style="font-size: 0.85rem; text-transform: uppercase;">
                                        <th>Sinh viên</th>
                                        <th>Khóa học</th>
                                        <th style="width: 250px;">Tiến trình</th>
                                        <th>Trạng thái rủi ro</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="activity-list">
                                    <!-- AJAX Data -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Nổi bật AI Recommendation bằng Callout Custom -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="callout callout-warning shadow-sm animate-fade" style="border-left-width: 5px; background: #fffcf0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 style="color: #856404; font-weight: 700;"><i data-lucide="sparkles" class="mr-2"></i>Đề xuất từ Trí tuệ Nhân tạo (AI)</h5>
                            <p class="mb-0">Hệ thống phát hiện sinh viên có dấu hiệu giảm tương tác. Hãy kiểm tra biểu đồ Radar để biết nguyên nhân cụ thể.</p>
                        </div>
                        <div id="live-alert" class="badge badge-info animate-pulse d-none">MỚI</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Student Detail Offcanvas -->
<div class="offcanvas offcanvas-right shadow-lg" tabindex="-1" id="studentOffcanvas" style="width: 450px; background: #f8fafc;">
    <div class="offcanvas-header bg-indigo p-4 text-white">
        <h5 class="offcanvas-title font-weight-bold" id="offcanvasName">Chi tiết Sinh viên</h5>
        <button type="button" class="close text-white" data-dismiss="offcanvas" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="offcanvas-body p-4">
        <div class="text-center mb-4">
            <div class="avatar-placeholder rounded-circle mx-auto mb-3 bg-soft-primary" style="width: 80px; height: 80px; line-height: 80px; font-size: 2rem; font-weight: 700;">SV</div>
            <h4 id="detail-fullname" class="font-weight-bold mb-0">---</h4>
            <p id="detail-email" class="text-muted">---</p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h6 class="text-uppercase text-xs font-weight-bold text-primary mb-3">Phân tích Rủi ro AI (Radar)</h6>
                <div id="radar-chart"></div>
                <div class="mt-3 p-3 bg-light rounded" style="font-size: 0.9rem;">
                    <strong>Dự đoán:</strong> <span id="risk-analysis-text">Đang phân tích...</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-uppercase text-xs font-weight-bold text-success mb-3">Hành động nhanh</h6>
                <textarea id="nudge-message" class="form-control mb-3" rows="3" placeholder="Nhập tin nhắn động viên..."></textarea>
                <button id="btn-nudge-real" class="btn btn-primary btn-block font-weight-bold">
                    <i data-lucide="send" class="mr-2" style="width: 16px; height: 16px;"></i> Gửi Gmail Nhắc Nhở
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            lucide.createIcons();

            // 1. SignalR Connection Setup
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/dashboardHub")
                .build();

            connection.on("ReceiveNotification", (user, message) => {
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
                Toast.fire({ icon: 'info', title: message });
                $('#live-alert').removeClass('d-none');
            });

            connection.start().catch(err => console.error(err.toString()));

            // 2. Initialize DataTables
            var table = $('#activity-table').DataTable({
                "paging": true, "searching": true, "ordering": true, "info": false, "autoWidth": false,
                "responsive": true, "pageLength": 5,
                "language": { "search": "Tìm kiếm:", "paginate": { "next": "Tiếp", "previous": "Trước" } }
            });

            // 3. Global Chart Instances
            let engagementChart, roleChart, radarChart;

            loadDashboardData();

            $('#btn-refresh').click(function() {
                $(this).find('i').addClass('animate-spin');
                loadDashboardData(true);
            });

            // 4. Load Data & Hub Logic
            function loadDashboardData(withAlert = false) {
                // KPI Stats
                $.get('/Dashboard/GetStats', function(data) {
                    $('#total-students').text(data.totalStudents);
                    $('#avg-progress').text(data.avgCompletionRate + '%');
                    $('#dropout-risk').text(data.dropoutRiskRate + '%');
                });

                // Engagement Chart (Real Data)
                $.get('/Dashboard/GetEngagementChart', function(data) {
                    if(engagementChart) engagementChart.destroy();
                    engagementChart = new ApexCharts(document.querySelector("#engagement-chart"), {
                        series: data.series,
                        chart: { height: 350, type: 'area', toolbar: { show: false } },
                        colors: ['#312e81', '#10b981', '#f59e0b', '#3b82f6', '#ef4444'],
                        fill: { type: 'gradient', gradient: { opacityFrom: 0.45, opacityTo: 0.05 } },
                        xaxis: { categories: data.categories },
                        stroke: { curve: 'smooth', width: 2 }
                    });
                    engagementChart.render();
                });

                // Role Distribution (Real Data)
                $.get('/Dashboard/GetRoleDistribution', function(data) {
                    if(roleChart) roleChart.destroy();
                    roleChart = new ApexCharts(document.querySelector("#role-chart"), {
                        series: data.series,
                        labels: data.labels,
                        chart: { type: 'donut', height: 350 },
                        colors: ['#4338ca', '#f59e0b', '#ef4444']
                    });
                    roleChart.render();
                });

                // Activity Table (Real Data)
                $.get('/Dashboard/GetActivities', function(data) {
                    table.clear();
                    data.forEach(item => {
                        let riskClass = item.riskLevel === 'High' ? 'badge-danger' : (item.riskLevel === 'Medium' ? 'badge-warning' : 'badge-success');
                        table.row.add([
                            `<strong>${item.studentName}</strong>`,
                            item.courseName,
                            `<div class="progress progress-xxs mb-1"><div class="progress-bar bg-primary" style="width: ${item.progress}%;"></div></div><small>${item.progress}%</small>`,
                            `<span class="badge ${riskClass}">${item.riskLevel} Risk</span>`,
                            `<button class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="showStudentDetail('${item.studentId}', '${item.studentName}', '${item.riskLevel}')">
                                <i data-lucide="eye" style="width:14px; height:14px;"></i> Chi tiết
                             </button>`
                        ]);
                    });
                    table.draw();
                    lucide.createIcons();
                    $('#btn-refresh').find('i').removeClass('animate-spin');
                });
            }

            // 5. Student detail (Explanable AI)
            window.showStudentDetail = function(id, name, risk) {
                $('#detail-fullname').text(name);
                $('#detail-email').text(name.toLowerCase().replace(' ', '') + '@@smartlms.edu.vn');
                $('#offcanvasName').text("Phân tích AI: " + name);
                
                // Radar Chart Data (Simulated AI Analysis based on Risk)
                let base = risk === 'High' ? [30, 20, 40, 50, 20] : [80, 70, 90, 85, 95];
                if(radarChart) radarChart.destroy();
                radarChart = new ApexCharts(document.querySelector("#radar-chart"), {
                    series: [{ name: 'Chỉ số', data: base }],
                    chart: { height: 300, type: 'radar', toolbar: {show: false} },
                    xaxis: { categories: ['Tiến độ', 'Tương tác', 'Điểm số', 'Chăm chỉ', 'Video'] },
                    colors: [risk === 'High' ? '#ef4444' : '#10b981']
                });
                radarChart.render();

                $('#risk-analysis-text').text(risk === 'High' ? 'Rủi ro cao do lượt đăng nhập thấp và tiến độ bài tập chậm.' : 'Hoạt động ổn định, có tiềm năng đạt chứng chỉ xuất sắc.');

                $('#studentOffcanvas').addClass('show');
                
                // Nudge logic
                $('#btn-nudge-real').off('click').on('click', function() {
                    let msg = $('#nudge-message').val();
                    if(!msg) { Swal.fire('Lỗi', 'Vui lòng nhập lời nhắn.', 'error'); return; }
                    
                    $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Đang gửi...');
                    
                    $.post('/Dashboard/SendNudge', { message: msg, email: $('#detail-email').text() }, function(res) {
                        Swal.fire('Thành công!', 'Email nhắc nhở đã được gửi qua Gmail.', 'success');
                        $('#studentOffcanvas').removeClass('show');
                        $('#btn-nudge-real').prop('disabled', false).html('<i data-lucide="send" class="mr-2"></i> Gửi Gmail Nhắc Nhở');
                        lucide.createIcons();
                    });
                });
            };

            $('.close').click(function() { $('#studentOffcanvas').removeClass('show'); });
        });
    </script>
    <style>
        .offcanvas { position: fixed; bottom: 0; z-index: 1050; display: flex; flex-direction: column; max-width: 100%; color: #212529; visibility: hidden; background-color: #fff; background-clip: padding-box; outline: 0; transition: transform .3s ease-in-out; }
        .offcanvas-right { top: 0; right: 0; border-left: 1px solid rgba(0,0,0,.2); transform: translateX(100%); }
        .offcanvas.show { transform: none; visibility: visible; }
        .bg-indigo { background: #312e81; }
        .bg-soft-primary { background: #e0e7ff; color: #4338ca; }
        .animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
    </style>
}
