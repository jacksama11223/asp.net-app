@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Content Header -->
<div class="content-header animate-fade">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0" style="font-weight: 700;">Hệ thống Quản trị SmartLMS</h1>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" id="btn-refresh" class="btn btn-outline-primary btn-sm shadow-sm">
                    <i data-lucide="refresh-cw" class="mr-1" style="width:14px; height:14px;"></i> Làm mới dữ liệu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- 1. 3 Cột Stats (Sử dụng Info-Box) -->
        <div class="row">
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-info elevation-1"><i data-lucide="users"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Tổng số Sinh viên</span>
                        <span id="total-students" class="info-box-number text-bold-xl">--</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-success elevation-1"><i data-lucide="check-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Tỉ lệ Hoàn thành</span>
                        <span id="avg-progress" class="info-box-number text-bold-xl">--%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 col-12">
                <div class="info-box shadow-sm border">
                    <span class="info-box-icon bg-danger elevation-1"><i data-lucide="alert-circle"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Rủi ro Bỏ học (AI)</span>
                        <span id="dropout-risk" class="info-box-number text-bold-xl">--%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 1.5 ApexCharts Section (WOW Factor) -->
        <div class="row mt-4">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h3 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-chart-line mr-2 text-primary"></i>Xu hướng tương tác (AI Insights)</h3>
                        <div class="badge badge-pill badge-light text-primary py-2 px-3">Real-time Data</div>
                    </div>
                    <div class="card-body">
                        <div id="engagement-chart" style="min-height: 350px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-header bg-white border-0 py-3">
                        <h3 class="card-title font-weight-bold text-dark mb-0"><i class="fas fa-chart-pie mr-2 text-info"></i>Cơ cấu Người dùng</h3>
                    </div>
                    <div class="card-body">
                        <div id="role-chart" style="min-height: 350px;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <!-- 2. Nâng cấp Bảng bằng DataTables -->
            <div class="col-md-12">
                <div class="card card-outline card-primary shadow-sm">
                    <div class="card-header border-0 bg-white">
                        <h3 class="card-title" style="font-weight: 600;">Giám sát Hiệu suất Sinh viên</h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive p-3">
                            <table id="activity-table" class="table table-hover align-middle">
                                <thead>
                                    <tr class="text-muted" style="font-size: 0.85rem; text-transform: uppercase;">
                                        <th>Sinh viên</th>
                                        <th>Khóa học</th>
                                        <th style="width: 250px;">Tiến trình</th>
                                        <th>Trạng thái rủi ro</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="activity-list">
                                    <!-- AJAX Data -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Nổi bật AI Recommendation bằng Callout Custom -->
        <div class="row mt-3">
            <div class="col-12">
                <div class="callout callout-warning shadow-sm animate-fade" style="border-left-width: 5px; background: #fffcf0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 style="color: #856404; font-weight: 700;"><i data-lucide="sparkles" class="mr-2"></i>Đề xuất từ Trí tuệ Nhân tạo (AI)</h5>
                            <p class="mb-0">Hệ thống phát hiện <strong>3 sinh viên</strong> có dấu hiệu giảm tương tác trong tuần này. Bạn nên gửi email động viên ngay.</p>
                        </div>
                        <button id="btn-nudge" class="btn btn-warning shadow-sm" style="font-weight: 600;">
                            <i data-lucide="mail" class="mr-1" style="width: 16px; height: 16px;"></i> Gửi Email Ngay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            lucide.createIcons();

            // Initialize DataTable
            var table = $('#activity-table').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": false,
                "autoWidth": false,
                "responsive": true,
                "pageLength": 5,
                "language": {
                    "search": "Tìm kiếm:",
                    "paginate": {
                        "next": "Tiếp",
                        "previous": "Trước"
                    }
                }
            });

            loadDashboardData();
            initCharts();

            $('#btn-refresh').click(function() {
                $(this).find('i').addClass('animate-spin');
                loadDashboardData(true);
            });

            // Gửi Email Ngay với SweetAlert2
            $('#btn-nudge').click(function() {
                Swal.fire({
                    title: 'Xác nhận gửi Email',
                    text: "Bạn có chắc chắn muốn gửi email động viên tới nhóm sinh viên này?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xác nhận gửi',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('/Dashboard/SendNudge', function() {
                            Swal.fire(
                                'Đã gửi!',
                                'Email động viên đã được gửi tới 3 sinh viên.',
                                'success'
                            );
                        });
                    }
                });
            });

            function initCharts() {
                // 1. Engagement Area Chart
                var engagementOptions = {
                    series: [{
                        name: 'Lượt học bài',
                        data: [31, 40, 28, 51, 42, 109, 100]
                    }, {
                        name: 'Lượt thảo luận',
                        data: [11, 32, 45, 32, 34, 52, 41]
                    }],
                    chart: {
                        height: 350,
                        type: 'area',
                        toolbar: { show: false },
                        fontFamily: 'Inter, sans-serif'
                    },
                    dataLabels: { enabled: false },
                    stroke: { curve: 'smooth', width: 2 },
                    colors: ['#312e81', '#10b981'],
                    fill: {
                        type: 'gradient',
                        gradient: {
                            shadeIntensity: 1,
                            opacityFrom: 0.45,
                            opacityTo: 0.05,
                            stops: [20, 100, 100, 100]
                        }
                    },
                    xaxis: {
                        categories: ["Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ Nhật"],
                    },
                    tooltip: { x: { format: 'dd/MM' } },
                };

                var engagementChart = new ApexCharts(document.querySelector("#engagement-chart"), engagementOptions);
                engagementChart.render();

                // 2. Role Donut Chart
                var roleOptions = {
                    series: [44, 15, 41],
                    labels: ['Sinh viên', 'Giảng viên', 'Admin'],
                    chart: {
                        type: 'donut',
                        height: 350,
                    },
                    colors: ['#4338ca', '#f59e0b', '#ef4444'],
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '75%',
                                labels: {
                                    show: true,
                                    total: {
                                        show: true,
                                        label: 'Tổng user',
                                        formatter: () => '1,240'
                                    }
                                }
                            }
                        }
                    },
                    legend: { position: 'bottom' }
                };

                var roleChart = new ApexCharts(document.querySelector("#role-chart"), roleOptions);
                roleChart.render();
            }

            function loadDashboardData(withAlert = false) {
                $.get('/Dashboard/GetStats', function(data) {
                    $('#total-students').text(data.totalStudents);
                    $('#avg-progress').text(data.avgCompletionRate + '%');
                    $('#dropout-risk').text(data.dropoutRiskRate + '%');
                });

                $.get('/Dashboard/GetActivities', function(data) {
                    table.clear();
                    data.forEach(item => {
                        let badgeClass = item.riskStatus === 'High Risk' ? 'badge-danger' : 
                                        (item.riskStatus === 'Moderate' ? 'badge-warning' : 'badge-success');
                        
                        table.row.add([
                            `<strong>${item.studentName}</strong>`,
                            item.courseName,
                            `<div>
                                <div class="progress progress-xxs mb-1" style="height: 8px; border-radius: 10px;">
                                    <div class="progress-bar bg-primary" style="width: ${item.progress}%;"></div>
                                </div>
                                <small class="text-muted">${item.progress}% Hoàn thành</small>
                            </div>`,
                            `<span class="badge ${badgeClass}">${item.riskStatus}</span>`,
                            `<button class="btn btn-sm btn-info" onclick="Swal.fire('Tính năng đang phát triển', '', 'info')">
                                <i data-lucide="eye" style="width:14px; height:14px;"></i>
                             </button>`
                        ]);
                    });
                    table.draw();
                    lucide.createIcons();
                    $('#btn-refresh').find('i').removeClass('animate-spin');

                    if (withAlert) {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        Toast.fire({
                            icon: 'success',
                            title: 'Dữ liệu đã được đồng bộ'
                        });
                    }
                });
            }
        });
    </script>
    <style>
        .badge-danger { padding: 8px 12px; border-radius: 4px; }
        .badge-success { padding: 8px 12px; border-radius: 4px; }
        .badge-warning { padding: 8px 12px; border-radius: 4px; }
        
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin { animation: spin 1s linear infinite; }
    </style>
}
