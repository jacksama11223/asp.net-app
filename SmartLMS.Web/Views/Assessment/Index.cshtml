@{
    ViewData["Title"] = "Khảo thí & Game hóa";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0 text-bold-xl"><i class="fas fa-gamepad text-orange mr-2"></i> @ViewData["Title"]</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card glass-card p-4 text-center">
            <h3 class="mt-3">🚧 Tính năng đang được xây dựng</h3>
            <p class="text-muted">Ngân hàng câu hỏi (Question Bank) và Động cơ phần thưởng (XP Engine) chuẩn bị được ra mắt.</p>
            <div class="mt-4">
                <a href="/Assessment/QuizWizard" class="btn btn-outline-primary transition-hover"><i class="fas fa-magic"></i> Trải nghiệm Quiz Wizard (Demo)</a>
            </div>
        </div>
    </div>
</section>
