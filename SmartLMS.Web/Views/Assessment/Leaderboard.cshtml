@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Bảng Xếp Hạng Tuyệt Đỉnh (Leaderboard)";
    var top3 = Model.Take(3).ToList();
    var others = Model.Skip(3).ToList();
}

@section Styles {
    <style>
        .leaderboard-container { min-height: 80vh; padding-bottom: 50px; }
        .podium-section { padding: 40px 0; display: flex; justify-content: center; align-items: flex-end; gap: 15px; }
        .podium-item { position: relative; display: flex; flex-direction: column; align-items: center; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .podium-item:hover { transform: translateY(-10px); }
        
        .podium-avatar { width: 80px; height: 80px; border-radius: 50%; border: 4px solid #fff; margin-bottom: 10px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .podium-base { width: 140px; border-radius: 15px 15px 5px 5px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; font-weight: bold; }
        
        .rank-2 { height: 160px; background: linear-gradient(180deg, #94a3b8, #64748b); order: 1; opacity: 0.9; }
        .rank-1 { height: 220px; background: linear-gradient(180deg, #fbbf24, #d97706); order: 2; z-index: 2; width: 160px; }
        .rank-3 { height: 130px; background: linear-gradient(180deg, #d97706, #92400e); order: 3; opacity: 0.8; }
        
        .crown-master { position: absolute; top: -35px; font-size: 2rem; color: #fbbf24; filter: drop-shadow(0 0 10px rgba(251,191,36,0.6)); }
        
        .list-glass { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.3); border-radius: 25px; overflow: hidden; }
        .user-row { transition: all 0.2s; border-bottom: 1px solid rgba(0,0,0,0.05); }
        .user-row:hover { background: rgba(99, 102, 241, 0.05) !important; }
        
        .avatar-small { width: 40px; height: 40px; border-radius: 50%; background: #6366f1; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; }
    </style>
}

<div class="leaderboard-container">
    <div class="content-header text-center pt-5">
        <h1 class="display-4 text-gradient font-weight-bold">Bảng Vinh Danh Enterprise</h1>
        <p class="text-muted">Dữ liệu thời gian thực được đồng bộ trên toàn bộ hệ thống</p>
    </div>

    <div class="container">
        <!-- Podium Top 3 -->
        <div class="podium-section">
            @if(top3.Count > 1) {
                var p2 = top3[1];
                <div class="podium-item">
                    <div class="podium-avatar bg-secondary d-flex align-items-center justify-content-center text-white font-weight-bold">@p2.Username[0]</div>
                    <div class="podium-base rank-2 shadow">
                        <span class="h3 m-0">2</span>
                        <span class="text-sm">@p2.Username</span>
                        <span class="badge badge-light mt-1">@p2.TotalXP XP</span>
                    </div>
                </div>
            }

            @if(top3.Count > 0) {
                var p1 = top3[0];
                <div class="podium-item">
                    <i class="fas fa-crown crown-master"></i>
                    <div class="podium-avatar bg-warning d-flex align-items-center justify-content-center text-white font-weight-bold" style="border-color: #fbbf24;">@p1.Username[0]</div>
                    <div class="podium-base rank-1 shadow-lg">
                        <span class="h1 m-0">1</span>
                        <span class="h5">@p1.Username</span>
                        <span class="badge badge-light mt-1 font-weight-bold" style="color: #d97706">@p1.TotalXP XP</span>
                    </div>
                </div>
            }

            @if(top3.Count > 2) {
                var p3 = top3[2];
                <div class="podium-item">
                    <div class="podium-avatar bg-dark d-flex align-items-center justify-content-center text-white font-weight-bold">@p3.Username[0]</div>
                    <div class="podium-base rank-3 shadow">
                        <span class="h3 m-0">3</span>
                        <span class="text-sm">@p3.Username</span>
                        <span class="badge badge-light mt-1">@p3.TotalXP XP</span>
                    </div>
                </div>
            }
        </div>

        <!-- Others List -->
        <div class="row mt-5">
            <div class="col-md-10 mx-auto">
                <div class="list-glass shadow-xl">
                    <table class="table table-borderless mb-0">
                        <thead>
                            <tr class="text-muted text-sm">
                                <th class="pl-4">Hạng</th>
                                <th>Học viên</th>
                                <th class="text-right pr-4">Tổng XP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 4; }
                            @foreach (var user in others) {
                                <tr class="user-row">
                                    <td class="pl-4 align-middle">
                                        <span class="font-weight-bold text-muted">#@rank</span>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-small mr-3">@user.Username[0]</div>
                                            <div>
                                                <div class="font-weight-bold">@(user.FullName ?? user.Username)</div>
                                                <div class="text-xs text-muted">@@@user.Username</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-right pr-4 align-middle">
                                        <span class="xp-pill xp-value" data-value="@user.TotalXP">0</span>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        $(function() {
            $('.xp-value').each(function() {
                var target = $(this).data('value');
                var countUpAnim = new countUp.CountUp(this, target, { duration: 2 });
                countUpAnim.start();
            });

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/gamificationHub")
                .build();

            connection.on("ReceiveXPUpdate", function (username, xpGained, totalXP) {
                if (typeof playTing === "function") playTing(); 
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    icon: 'success',
                    title: username + ' vùa nhận +' + xpGained + ' XP!'
                });
                setTimeout(() => { location.reload(); }, 2000);
            });

            connection.start().catch(err => console.error(err.toString()));

            confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });
        });
    </script>
}
