@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Đỉnh Cao Vinh Quang (Leaderboard)";
    var top3 = Model.Take(3).ToList();
    var others = Model.Skip(3).ToList();
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --indigo-primary: #4338ca;
            --indigo-dark: #1e1b4b;
            --gold-accent: #fbbf24;
            --gold-deep: #d97706;
        }

        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }

        .leaderboard-header { 
            padding: 60px 0; background: linear-gradient(135deg, var(--indigo-dark) 0%, var(--indigo-primary) 100%);
            color: white; border-radius: 0 0 50px 50px; text-align: center;
        }

        .podium-container { display: flex; justify-content: center; align-items: flex-end; gap: 20px; margin-top: -60px; padding-bottom: 40px; }
        
        .podium-item { display: flex; flex-direction: column; align-items: center; transition: transform 0.3s; width: 150px; }
        .podium-item:hover { transform: translateY(-10px); }

        .podium-avatar { 
            width: 90px; height: 90px; border-radius: 50%; border: 5px solid white; 
            margin-bottom: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            display: flex; align-items: center; justify-content: center; font-size: 2rem;
        }
        
        .rank-box { 
            width: 100%; border-radius: 20px 20px 10px 10px; color: white; 
            font-weight: 800; display: flex; flex-direction: column; align-items: center;
            justify-content: center; box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .rank-2 { height: 160px; background: #94a3b8; order: 1; opacity: 0.9; }
        .rank-1 { height: 220px; background: linear-gradient(180deg, var(--gold-accent), var(--gold-deep)); order: 2; width: 180px; z-index: 2; border: 3px solid var(--gold-accent); }
        .rank-3 { height: 130px; background: #cd7f32; order: 3; opacity: 0.8; }

        .crown-icon { font-size: 2.5rem; color: var(--gold-accent); margin-bottom: -15px; z-index: 3; filter: drop-shadow(0 0 10px rgba(251,191,36,0.6)); }

        .list-container { 
            background: rgba(255,255,255,0.8); backdrop-filter: blur(20px);
            border-radius: 30px; border: 1px solid rgba(255,255,255,0.3);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.08); overflow: hidden;
            margin-top: 40px;
        }

        .user-row { transition: all 0.2s; border-bottom: 1px solid #f1f5f9; }
        .user-row:hover { background: rgba(67, 56, 202, 0.05) !important; }

        .xp-badge-mini { background: #fef3c7; color: var(--gold-deep); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; }
    </style>
}

<div class="leaderboard-header">
    <div class="container">
        <h1 class="display-4 font-weight-bold">Bảng Vinh Danh Anh Tài</h1>
        <p class="h5 opacity-75">Nơi những học viên xuất sắc nhất được xướng tên</p>
    </div>
</div>

<div class="container pb-5">
    <!-- Podium -->
    <div class="podium-container">
        @if(top3.Count > 1) {
            var p2 = top3[1];
            <div class="podium-item">
                <div class="podium-avatar bg-secondary text-white">@p2.Username[0]</div>
                <div class="rank-box rank-2">
                    <span class="h2 m-0">2</span>
                    <span class="text-sm">@p2.Username</span>
                    <span class="badge badge-light mt-2">@p2.TotalXP XP</span>
                </div>
            </div>
        }

        @if(top3.Count > 0) {
            var p1 = top3[0];
            <div class="podium-item" style="width: 180px;">
                <i class="fas fa-crown crown-icon"></i>
                <div class="podium-avatar bg-warning text-white" style="border-color: var(--gold-accent);">@p1.Username[0]</div>
                <div class="rank-box rank-1">
                    <span class="h1 m-0">1</span>
                    <span class="h5">@p1.Username</span>
                    <span class="badge badge-light mt-2" style="color: var(--gold-deep)">@p1.TotalXP XP</span>
                </div>
            </div>
        }

        @if(top3.Count > 2) {
            var p3 = top3[2];
            <div class="podium-item">
                <div class="podium-avatar bg-dark text-white" style="background: #92400e !important;">@p3.Username[0]</div>
                <div class="rank-box rank-3">
                    <span class="h2 m-0">3</span>
                    <span class="text-sm">@p3.Username</span>
                    <span class="badge badge-light mt-2">@p3.TotalXP XP</span>
                </div>
            </div>
        }
    </div>

    <!-- Others List -->
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="list-container">
                <table class="table table-borderless mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small uppercase font-weight-bold">
                            <th class="pl-4">Hạng</th>
                            <th>Học viên</th>
                            <th class="text-right pr-4">Thành tích</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 4; }
                        @foreach (var user in others) {
                            <tr class="user-row">
                                <td class="pl-4 align-middle">
                                    <span class="h5 text-muted">#@rank</span>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm rounded-circle bg-indigo text-white d-flex align-items-center justify-content-center mr-3" style="width: 40px; height: 40px; background: var(--indigo-primary);">@user.Username[0]</div>
                                        <div>
                                            <div class="font-weight-bold text-indigo">@(user.FullName ?? user.Username)</div>
                                            <div class="text-xs text-muted">@@@user.Username</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-right pr-4 align-middle">
                                    <span class="xp-badge-mini">@user.TotalXP XP</span>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        $(function() {
            confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 }, colors: ['#4338ca', '#fbbf24'] });
        });
    </script>
}
