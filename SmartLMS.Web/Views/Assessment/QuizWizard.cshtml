@{
    ViewData["Title"] = "Trình mô phỏng Bài thi (Quiz Wizard)";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-steps/1.1.0/jquery.steps.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        .wizard > .steps > ul > li { width: 25%; }
        .wizard > .content {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            min-height: 400px;
            padding: 30px;
            border: 1px solid #e2e8f0;
        }
        .wizard > .actions a {
            background: #6366f1 !important;
            border-radius: 8px !important;
            padding: 10px 25px !important;
            font-weight: 600;
        }
        .question-title { font-weight: 700; font-size: 1.35rem; color: #1e1b4b; margin-bottom: 25px; }
        .answer-option {
            display: block; padding: 15px 20px; margin-bottom: 12px;
            border: 2px solid #f1f5f9; border-radius: 10px;
            cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .answer-option:hover { background-color: #f8fafc; border-color: #cbd5e1; transform: translateX(5px); }
        .answer-option.selected { background-color: #eff6ff; border-color: #3b82f6; }
        .answer-option input { display: none; }
        .xp-badge { background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; margin-left: 10px; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="m-0 text-bold-xl"><i class="fas fa-magic text-indigo mr-2"></i> @ViewData["Title"]</h1>
            <div id="quiz-timer" class="h4 text-danger font-weight-bold">00:00</div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div id="quiz-loading" class="text-center p-5">
                    <div class="spinner-border text-indigo" role="status"></div>
                    <p class="mt-3 text-muted">Đang tải đề thi...</p>
                </div>
                <div id="quiz-wizard" class="d-none">
                    <!-- Questions will be injected here -->
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-steps/1.1.0/jquery.steps.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const examId = @ViewBag.ExamId;
        let questions = [];
        let userAnswers = {};

        $(document).ready(function () {
            loadQuiz();
        });

        async function loadQuiz() {
            try {
                // Giả sử API lấy đề thi chi tiết
                const response = await fetch(`/api/assessment/questions?examId=${examId}`, {
                     method: 'POST',
                     headers: { 'Content-Type': 'application/json' },
                     body: JSON.stringify({ startRow: 0, pageSize: 50 })
                });
                const data = await response.json();
                questions = data.rows;
                
                renderQuiz();
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể tải đề thi.', 'error');
            }
        }

        function renderQuiz() {
            const wizard = $("#quiz-wizard");
            questions.forEach((q, index) => {
                const options = JSON.parse(q.options || '[]');
                let optionsHtml = '';
                
                options.forEach((opt, optIdx) => {
                    const label = String.fromCharCode(65 + optIdx); // A, B, C...
                    optionsHtml += `
                        <label class="answer-option" onclick="selectOption(this, ${q.questionId}, '${label}')">
                            <input type="radio" name="q_${q.questionId}" value="${label}">
                            <strong>${label}.</strong> ${opt}
                        </label>`;
                });

                wizard.append(`
                    <h3>Bước ${index + 1}</h3>
                    <section>
                        <div class="question-title">${index + 1}. ${q.content} <span class="xp-badge">+${q.xpValue} XP</span></div>
                        <div class="options-container">${optionsHtml}</div>
                    </section>
                `);
            });

            $("#quiz-loading").addClass('d-none');
            wizard.removeClass('d-none');

            wizard.steps({
                headerTag: "h3",
                bodyTag: "section",
                transitionEffect: "slideLeft",
                labels: { finish: "Nộp bài", next: "Tiếp theo", previous: "Quay lại" },
                onFinished: submitQuiz
            });
        }

        function selectOption(el, qId, val) {
            $(el).siblings().removeClass('selected');
            $(el).addClass('selected');
            userAnswers[qId] = val;
        }

        async function submitQuiz() {
            Swal.fire({
                title: 'Đang chấm điểm...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('/api/assessment/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: examId, answers: userAnswers })
                });

                const result = await response.json();
                
                let badgeText = '';
                if(result.newBadges && result.newBadges.length > 0) {
                    badgeText = `<div class="mt-3 p-3 bg-warning-light rounded text-dark">
                                    <strong>⭐ Chúc mừng! Bạn nhận được huy hiệu:</strong><br>
                                    ${result.newBadges.join(', ')}
                                 </div>`;
                }

                Swal.fire({
                    title: `Kết quả: ${result.score.toFixed(1)}%`,
                    html: `Bạn nhận được <strong>${result.xpEarned} XP</strong>. ${badgeText}`,
                    icon: result.score >= 50 ? 'success' : 'info',
                    confirmButtonText: 'Tuyệt vời!'
                }).then(() => {
                    if(result.score >= 80) triggerConfetti();
                    window.location.href = '/Assessment/Leaderboard';
                });

            } catch (error) {
                Swal.fire('Lỗi!', 'Có lỗi xảy ra khi nộp bài.', 'error');
            }
        }

        function triggerConfetti() {
            var count = 200;
            var defaults = { origin: { y: 0.7 } };

            function fire(particleRatio, opts) {
                confetti(Object.assign({}, defaults, opts, {
                    particleCount: Math.floor(count * particleRatio)
                }));
            }

            fire(0.25, { spread: 26, startVelocity: 55 });
            fire(0.2, { spread: 60 });
            fire(0.35, { spread: 100, decay: 0.91, scalar: 0.8 });
            fire(0.1, { spread: 120, startVelocity: 25, decay: 0.92, scalar: 1.2 });
            fire(0.1, { spread: 120, startVelocity: 45 });
        }
    </script>
}
