@Model
@{
    ViewData["Title"] = "Thử Thách Grand Master";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-steps/1.1.0/jquery.steps.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        :root {
            --indigo-primary: #4338ca;
            --indigo-dark: #1e1b4b;
            --gold-accent: #fbbf24;
            --gold-deep: #d97706;
            --glass-bg: rgba(255, 255, 255, 0.9);
        }

        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }

        .quiz-header { 
            background: linear-gradient(135deg, var(--indigo-dark) 0%, var(--indigo-primary) 100%);
            padding: 40px 0; color: white; border-radius: 0 0 40px 40px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            margin-bottom: -50px;
        }

        .wizard > .steps { margin-bottom: 30px; }
        .wizard > .steps > ul > li { width: 25%; }
        .wizard > .steps a, .wizard > .steps a:hover, .wizard > .steps a:active {
            background: transparent; border: none; color: #94a3b8; font-weight: 600;
        }
        .wizard > .steps .current a { color: var(--gold-accent) !important; }

        .wizard > .content {
            background: var(--glass-bg); backdrop-filter: blur(10px);
            border-radius: 24px; border: 1px solid rgba(255,255,255,0.4);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.05);
            padding: 40px; min-height: 500px;
        }

        .question-card { animation: fadeInUp 0.5s ease-out; }
        .question-title { 
            font-size: 1.6rem; font-weight: 700; color: var(--indigo-dark); 
            margin-bottom: 30px; line-height: 1.4;
        }

        .answer-option {
            display: flex; align-items: center; padding: 20px 25px; margin-bottom: 15px;
            background: white; border: 2px solid #e2e8f0; border-radius: 16px;
            cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-weight: 500; font-size: 1.1rem;
        }
        .answer-option:hover { 
            border-color: var(--indigo-primary); transform: translateY(-3px); 
            box-shadow: 0 10px 15px -3px rgba(67, 56, 202, 0.1);
        }
        .answer-option.selected { 
            background: var(--indigo-primary); color: white; border-color: var(--indigo-primary);
            box-shadow: 0 10px 20px rgba(67, 56, 202, 0.3);
        }
        .answer-option input { display: none; }
        
        .opt-letter { 
            width: 32px; height: 32px; border-radius: 8px; background: #f1f5f9; 
            color: var(--indigo-primary); display: flex; align-items: center; 
            justify-content: center; margin-right: 15px; font-weight: 700;
            transition: all 0.2s;
        }
        .selected .opt-letter { background: rgba(255,255,255,0.2); color: white; }

        .xp-pill { 
            background: linear-gradient(90deg, var(--gold-accent), var(--gold-deep));
            color: var(--indigo-dark); padding: 5px 15px; border-radius: 30px;
            font-size: 0.85rem; font-weight: 800; letter-spacing: 0.5px;
        }

        .wizard > .actions a {
            background: var(--indigo-primary) !important; color: white !important;
            border-radius: 12px !important; padding: 12px 35px !important;
            font-weight: 700; text-transform: uppercase; letter-spacing: 1px;
            transition: all 0.3s; border: none !important;
        }
        .wizard > .actions a:hover { background: var(--indigo-dark) !important; transform: scale(1.05); }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<div class="quiz-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 font-weight-bold m-0"><i class="fas fa-medal mr-3"></i> @ViewData["Title"]</h1>
                <p class="opacity-75 mt-2">Vượt qua thử thách để nhận chứng chỉ và vinh danh trên Bảng Xếp Hạng.</p>
            </div>
            <div class="col-md-4 text-right">
                <div id="quiz-timer" class="h2 font-weight-bold" style="color: var(--gold-accent)">00:00</div>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" style="margin-top: 20px;">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div id="quiz-loading" class="text-center p-5">
                <div class="spinner-border text-indigo" style="width: 3rem; height: 3rem;" role="status"></div>
                <h3 class="mt-4 text-indigo font-weight-bold">Đang triệu hồi đề thi...</h3>
            </div>
            <div id="quiz-wizard" class="d-none">
                <!-- Questions injected here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-steps/1.1.0/jquery.steps.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const examId = @ViewBag.ExamId;
        let questions = [];
        let userAnswers = {};

        $(document).ready(function () {
            loadQuiz();
        });

        async function loadQuiz() {
            try {
                const response = await fetch(`/api/assessment/questions?examId=${examId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ startRow: 0, pageSize: 50 })
                });
                const data = await response.json();
                questions = data.rows;
                renderQuiz();
            } catch (error) {
                Swal.fire('Lỗi!', 'Không thể kết nối đến máy chủ.', 'error');
            }
        }

        function renderQuiz() {
            const wizard = $("#quiz-wizard");
            questions.forEach((q, index) => {
                const options = JSON.parse(q.options || '[]');
                let optionsHtml = '';
                
                options.forEach((opt, optIdx) => {
                    const label = String.fromCharCode(65 + optIdx);
                    optionsHtml += `
                        <label class="answer-option" onclick="selectOption(this, ${q.questionId}, '${label}')">
                            <div class="opt-letter">${label}</div>
                            <input type="radio" name="q_${q.questionId}" value="${label}">
                            <span>${opt}</span>
                        </label>`;
                });

                wizard.append(`
                    <h3></h3>
                    <section class="question-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="text-muted font-weight-bold uppercase">Câu hỏi ${index + 1} / ${questions.length}</span>
                            <span class="xp-pill">+${q.xpValue} XP</span>
                        </div>
                        <div class="question-title">${q.content}</div>
                        <div class="options-container">${optionsHtml}</div>
                    </section>
                `);
            });

            $("#quiz-loading").addClass('d-none');
            wizard.removeClass('d-none');

            wizard.steps({
                headerTag: "h3",
                bodyTag: "section",
                transitionEffect: "fade",
                labels: { finish: "Kết thúc & Nộp bài", next: "Tiếp theo", previous: "Quay lại" },
                onFinished: submitQuiz
            });
        }

        function selectOption(el, qId, val) {
            $(el).siblings().removeClass('selected');
            $(el).addClass('selected');
            userAnswers[qId] = val;
        }

        async function submitQuiz() {
            Swal.fire({
                title: 'Đang gửi kết quả...',
                html: 'Hệ thống AI đang chấm điểm và phân tích năng lực của bạn.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('/api/assessment/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ examId: examId, answers: userAnswers })
                });

                const result = await response.json();
                
                Swal.fire({
                    title: `Điểm số: ${result.score.toFixed(1)}%`,
                    html: `Chúc mừng! Bạn nhận được <strong>${result.xpEarned} XP</strong>.<br><small class="text-muted">Huy hiệu và chứng chỉ (nếu có) đang được xử lý ngầm và sẽ xuất hiện trong Hub vinh danh của bạn.</small>`,
                    icon: result.score >= 50 ? 'success' : 'info',
                    confirmButtonText: 'Xem Bảng Xếp Hạng'
                }).then(() => {
                    if(result.score >= 80) triggerConfetti();
                    window.location.href = '/Assessment/Leaderboard';
                });

            } catch (error) {
                Swal.fire('Lỗi!', 'Có lỗi xảy ra khi nộp bài.', 'error');
            }
        }

        function triggerConfetti() {
            confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 }, colors: ['#4338ca', '#fbbf24', '#ffffff'] });
        }
    </script>
}
