@{
    ViewData["Title"] = "Lắp ráp Đề thi";
}

<style>
    .list-group-item { cursor: move; border-left: 4px solid transparent; transition: all 0.2s; }
    .list-group-item:hover { background: #f8f9fa; transform: translateX(5px); }
    .source-col .list-group-item { border-left-color: #6c757d; }
    .target-col .list-group-item { border-left-color: #6610f2; }
    .drag-container { height: 600px; overflow-y: auto; background: #fafafa; border-radius: 8px; padding: 10px; border: 1px solid #ddd; }
    .badge-xp { float: right; }
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-layer-group mr-2"></i>Exam Assembler</h1>
            </div>
            <div class="col-sm-6">
                <div class="input-group input-group-sm float-right" style="width: 250px;">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-indigo text-white">Mã PIN:</span>
                    </div>
                    <input type="text" class="form-control" value="EXAM-2026-XYZ" id="examPin" readonly>
                    <div class="input-group-append">
                        <button class="btn btn-indigo btn-copy" data-clipboard-target="#examPin" onclick="playTing()" title="Copy to clipboard">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- Cột trái: Ngân hàng câu hỏi -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-gray-dark">
                        <h3 class="card-title">Ngân hàng câu hỏi (Tồn kho)</h3>
                        <div class="card-tools">
                            <input type="text" class="form-control form-control-sm" placeholder="Tìm kiếm...">
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="source-list" class="list-group list-group-flush drag-container source-col">
                            @foreach (var q in ViewBag.Questions) {
                                <div class="list-group-item" data-id="@q.QuestionId">
                                    <span class="text-sm">@Html.Raw(q.Content)</span>
                                    <span class="badge badge-secondary badge-xp">@q.XPValue XP</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Đề thi -->
            <div class="col-md-6">
                <div class="card shadow-sm card-indigo card-outline">
                    <div class="card-header">
                        <h3 class="card-title text-indigo">Cấu trúc đề thi mới</h3>
                        <div class="card-tools">
                            <span class="badge badge-indigo" id="qCount">0 Câu hỏi</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div id="target-list" class="list-group list-group-flush drag-container target-col">
                            <!-- Items dropped here -->
                            <div class="empty-state p-5 text-center text-muted mt-5">
                                <i class="fas fa-mouse-pointer fa-3x mb-3 op-3"></i>
                                <p>Kéo câu hỏi từ cột bên trái thả vào đây để lập đề thi.</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-indigo btn-block shadow" onclick="toastr.success('Đang thực thi lưu cấu trúc và xuất bản đề thi...!')"><i class="fas fa-check-circle mr-1"></i> Lưu & Xuất bản đề thi</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        new Sortable(document.getElementById('source-list'), {
            group: 'exam',
            animation: 150
        });

        new Sortable(document.getElementById('target-list'), {
            group: 'exam',
            animation: 150,
            onAdd: function(evt) {
                document.querySelector('.empty-state').style.display = 'none';
                updateCount();
            },
            onRemove: function(evt) {
                if (document.getElementById('target-list').children.length === 1) { // 1 because of empty-state
                     document.querySelector('.empty-state').style.display = 'block';
                }
                updateCount();
            }
        });

        function updateCount() {
            var count = document.getElementById('target-list').querySelectorAll('.list-group-item').length;
            document.getElementById('qCount').innerText = count + ' Câu hỏi';
        }
    </script>
}
