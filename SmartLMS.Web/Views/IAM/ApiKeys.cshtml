@model IEnumerable<SmartLMS.Models.ApiKey>

@{
    ViewData["Title"] = "Quản lý API Keys - Developer Portal";
}

<link rel="stylesheet" href="/css/enterprise-saas.css">

<div class="enterprise-container">
    <div class="glass-header d-flex justify-content-between align-items-center p-4 mb-4">
        <div>
            <h1 class="text-gradient">Developer Portal</h1>
            <p class="text-muted">Quản lý các khóa truy cập API cho hệ thống tích hợp ngoại vi.</p>
        </div>
        <button class="btn btn-premium" data-bs-toggle="modal" data-bs-target="#generateKeyModal">
            <i class="fas fa-plus-circle me-2"></i>Tạo API Key mới
        </button>
    </div>

    @if (TempData["NewRawKey"] != null)
    {
        <div class="alert alert-premium shadow-sm border-0 mb-4 animate__animated animate__fadeIn">
            <div class="d-flex">
                <div class="me-3 fs-2"><i class="fas fa-shield-alt"></i></div>
                <div>
                    <h4 class="alert-heading text-gradient">Lưu giữ API KEY của bạn!</h4>
                    <p>Vì lý do bảo mật, chúng tôi chỉ hiển thị khóa này <strong>MỘT LẦN DUY NHẤT</strong>. Nếu bạn làm mất, bạn sẽ phải thu hồi và tạo khóa mới.</p>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control bg-dark border-0 text-success fw-bold" id="rawKeyInput" value="@TempData["NewRawKey"]" readonly>
                        <button class="btn btn-outline-success" onclick="copyToClipboard()">
                            <i class="fas fa-copy"></i> Sao chép
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card glass-card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 enterprise-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Tên Key</th>
                            <th>Bản xem trước (Preview)</th>
                            <th>Ngày tạo</th>
                            <th>Lần cuối dùng</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@key.Name</td>
                                <td><code>@key.KeyPreview</code></td>
                                <td>@key.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(key.LastUsed?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa dùng")</td>
                                <td>
                                    @if (key.IsActive == true)
                                    {
                                        <span class="badge bg-success-soft text-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-soft text-danger">Đã thu hồi</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (key.IsActive == true)
                                    {
                                        <form asp-action="RevokeApiKey" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn thu hồi Key này không? Mọi ứng dụng đang dùng nó sẽ mất kết nối.');">
                                            <input type="hidden" name="id" value="@key.KeyId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-floating">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Tạo Key -->
<div class="modal fade" id="generateKeyModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title text-gradient">Tạo API Key mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GenerateApiKey" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên hiển thị (Ví điểm: Website Marketing)</label>
                        <input type="text" name="name" class="form-control" placeholder="Nhập tên để gợi nhớ mục đích dùng Key" required>
                    </div>
                    <p class="text-muted small"><i class="fas fa-info-circle me-1"></i> Key này sẽ có quyền truy cập vào các API Public của tổ chức bạn.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-premium">Tạo ngay</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function copyToClipboard() {
        var copyText = document.getElementById("rawKeyInput");
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyText.value);
        
        Swal.fire({
            title: 'Đã sao chép!',
            text: 'Hãy lưu giữ Key này cẩn thận.',
            icon: 'success',
            timer: 1500,
            showConfirmButton: false
        });
    }
</script>
