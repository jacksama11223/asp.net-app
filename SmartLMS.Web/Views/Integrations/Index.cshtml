@{
    ViewData["Title"] = "Tích hợp & Open API";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0 text-bold-xl"><i class="fas fa-plug text-primary mr-2"></i> @ViewData["Title"]</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card glass-card p-4 text-center">
            <h3 class="mt-3">🚧 Tính năng đang được xây dựng</h3>
            <p class="text-muted">Tạo Live Class qua Zoom API và Đồng bộ CRM bằng Webhooks chuẩn bị ra mắt.</p>
            <div class="mt-4">
                <button class="btn btn-outline-primary transition-hover" onclick="toastr.info('Đang giả lập kiểm thử kết nối Zoom API... Trạng thái: Hợp lệ!');"><i class="fas fa-video"></i> Test kết nối Zoom API</button>
            </div>
        </div>
    </div>
</section>
