@{
    ViewData["Title"] = "Marketing & Chứng chỉ";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0 text-bold-xl"><i class="fas fa-bullhorn text-pink mr-2"></i> @ViewData["Title"]</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card glass-card p-4 text-center">
            <h3 class="mt-3">🚧 Tính năng đang được xây dựng</h3>
            <p class="text-muted">Luồng Email tự động (Auto-responder) và Trình tạo mẫu chứng chỉ (PDF Builder) chuẩn bị ra mắt.</p>
            <div class="mt-4">
                <button class="btn btn-outline-pink transition-hover"><i class="fas fa-file-pdf"></i> Thiết kế Chứng chỉ</button>
            </div>
        </div>
    </div>
</section>
