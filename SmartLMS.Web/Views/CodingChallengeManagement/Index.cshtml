@model IEnumerable<SmartLMS.Models.CodingChallenge>
@{
    ViewData["Title"] = "Quản lý bài tập lập trình";
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-bold text-indigo"><i class="fas fa-code mr-2"></i> Coding Challenges</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="fas fa-plus mr-1"></i> Thêm bài tập mới</a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-indigo shadow-sm">
            <div class="card-body">
                <table id="challengeTable" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tiêu đề</th>
                            <th>Ngôn ngữ</th>
                            <th>Khóa học</th>
                            <th>Điểm (EXP)</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="text-bold">@item.Title</td>
                                <td><span class="badge badge-success">@item.Language.ToUpper()</span></td>
                                <td>@(item.Course?.Title ?? "N/A")</td>
                                <td><span class="text-indigo font-weight-bold">@item.Points</span></td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info shadow-sm" title="Sửa & Quản lý Test Cases">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#challengeTable').DataTable({
                "responsive": true,
                "autoWidth": false,
                "order": [[0, "desc"]]
            });
        });
    </script>
}
