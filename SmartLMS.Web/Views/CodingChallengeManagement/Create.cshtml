@model SmartLMS.Models.CodingChallenge
@{
    ViewData["Title"] = "Tạo bài tập mới";
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-bold text-indigo"><i class="fas fa-plus-circle mr-2"></i> Tạo bài tập mới</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-indigo shadow-sm max-w-4xl mx-auto">
            <div class="card-header">
                <h3 class="card-title text-bold">Thông tin bài tập</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label>Tiêu đề bài tập</label>
                        <input asp-for="Title" class="form-control" placeholder="Ví dụ: Kiểm tra số nguyên tố" required />
                    </div>
                    <div class="form-group">
                        <label>Mô tả đề bài</label>
                        <textarea asp-for="Description" class="form-control" rows="5" required placeholder="Viết mô tả bài tập tại đây..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Điểm thưởng (EXP)</label>
                                <input asp-for="Points" type="number" class="form-control" value="10" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Ngôn ngữ lập trình</label>
                                <select asp-for="Language" class="form-control">
                                    <option value="csharp">C#</option>
                                    <option value="python">Python</option>
                                    <option value="javascript">JavaScript</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Gắn vào khóa học (Tùy chọn)</label>
                        <select asp-for="CourseId" class="form-control" asp-items="@(new SelectList(ViewBag.Courses, "CourseId", "Title"))">
                            <option value="">-- Không gắn vào khóa học --</option>
                        </select>
                    </div>
                </div>
                <div class="card-footer bg-white text-right">
                    <a asp-action="Index" class="btn btn-default mr-2">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm text-bold">Tạo & Tiếp tục cấu hình Test Case</button>
                </div>
            </form>
        </div>
    </div>
</section>
