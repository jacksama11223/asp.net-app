@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card glass-card border-0 shadow-lg p-5 animate__animated animate__zoomIn">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="text-gradient mb-3">Thanh toán thành công!</h1>
                <p class="lead">Cảm ơn bạn đã tin tưởng SmartLMS. Khóa học của bạn đã sẵn sàng.</p>
                <div class="alert bg-success-soft text-success border-0 small">
                    Mã chuẩn đối soát: <strong>@ViewBag.TxnRef</strong>
                </div>
                <div class="mt-4">
                    <a href="/Dashboard" class="btn btn-premium btn-lg w-100">
                        <i class="fas fa-play-circle me-2"></i>Bắt đầu học ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
