@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card glass-card border-0 shadow-lg p-5 animate__animated animate__headShake">
                <div class="mb-4">
                    <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
                </div>
                <h1 class="text-danger mb-3">Thanh toán thất bại</h1>
                <p class="lead text-muted">@ViewBag.Error</p>
                <div class="alert bg-danger-soft text-danger border-0 small">
                    Bạn có thể thử lại bằng phương thức khác hoặc liên hệ bộ phận hỗ trợ.
                </div>
                <div class="mt-4 d-flex gap-2">
                    <a href="/CourseManagement" class="btn btn-outline-secondary w-100">Quay lại danh sách</a>
                    <a href="javascript:history.back()" class="btn btn-premium w-100">Thử lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
