@model IEnumerable<SmartLMS.Models.Course>
@{
    ViewData["Title"] = "Creator Dashboard";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 bg-base-200 p-6 rounded-2xl shadow-xl border border-base-300">
        <div class="flex items-center gap-4 mb-4 md:mb-0">
            <div class="avatar online">
                <div class="w-20 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2">
                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=instructor" />
                </div>
            </div>
            <div>
                <h1 class="text-3xl font-bold text-primary">Chào bạn, @ViewBag.CreatorName!</h1>
                <p class="text-base-content/70 italic">Sáng tạo nội dung, lan tỏa kiến thức cùng SmartLMS.</p>
            </div>
        </div>
        <div class="flex gap-2">
            <a asp-action="Create" class="btn btn-primary btn-md shadow-lg">
                <i class="fas fa-plus mr-2"></i> Tạo khóa học mới
            </a>
            <button class="btn btn-outline btn-md">
                <i class="fas fa-cog mr-2"></i> Cài đặt
            </button>
        </div>
    </div>

    <!-- Statistics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="stats shadow-xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white">
            <div class="stat">
                <div class="stat-figure opacity-80">
                    <i class="fas fa-book-open text-3xl"></i>
                </div>
                <div class="stat-title text-white/80">Khóa học</div>
                <div class="stat-value">@ViewBag.TotalCourses</div>
                <div class="stat-desc text-white/70">Đang hoạt động</div>
            </div>
        </div>

        <div class="stats shadow-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white">
            <div class="stat">
                <div class="stat-figure opacity-80">
                    <i class="fas fa-users text-3xl"></i>
                </div>
                <div class="stat-title text-white/80">Học viên</div>
                <div class="stat-value">@ViewBag.TotalStudents</div>
                <div class="stat-desc text-white/70">↗️ 12% so với tháng trước</div>
            </div>
        </div>

        <div class="stats shadow-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white">
            <div class="stat">
                <div class="stat-figure opacity-80">
                    <i class="fas fa-newspaper text-3xl"></i>
                </div>
                <div class="stat-title text-white/80">Bài viết</div>
                <div class="stat-value">@ViewBag.TotalArticles</div>
                <div class="stat-desc text-white/70">Trong 30 ngày qua</div>
            </div>
        </div>

        <div class="stats shadow-xl bg-gradient-to-br from-pink-500 to-rose-600 text-white">
            <div class="stat">
                <div class="stat-figure opacity-80">
                    <i class="fas fa-star text-3xl"></i>
                </div>
                <div class="stat-title text-white/80">Uy tín</div>
                <div class="stat-value">@ViewBag.Reputation</div>
                <div class="stat-desc text-white/70">Điểm đánh giá trung bình</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Activities -->
        <div class="lg:col-span-2 bg-base-100 rounded-3xl p-6 shadow-2xl border border-base-200">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <i class="fas fa-book text-primary"></i> Khóa học của tôi
                </h3>
                <a href="#" class="link link-primary no-underline text-sm font-medium">Xem tất cả</a>
            </div>
            
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead>
                        <tr>
                            <th>Tên khóa học</th>
                            <th>Chuyên mục</th>
                            <th>Giá</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Category</td>
                                <td>@((item.Price ?? 0).ToString("N0")) đ</td>
                                <td>
                                    <div class="badge @(item.Status == "Published" ? "badge-success" : "badge-warning")">
                                        @item.Status
                                    </div>
                                </td>
                                <td>
                                    <div class="flex gap-2">
                                        <button class="btn btn-ghost btn-xs">Sửa</button>
                                        <button class="btn btn-ghost btn-xs text-error">Xóa</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Tips/Alerts -->
        <div class="space-y-6">
            <div class="card bg-info text-info-content shadow-xl">
                <div class="card-body">
                    <h2 class="card-title"><i class="fas fa-lightbulb"></i> Mẹo hay cho bạn!</h2>
                    <p class="text-sm">Hãy thường xuyên tương tác với học viên qua phần bình luận để tăng điểm uy tín của bạn nhé.</p>
                </div>
            </div>

            <div class="card bg-base-200 shadow-xl border border-base-300">
                <div class="card-body">
                    <h2 class="card-title text-sm uppercase opacity-60">Học viên tiêu biểu</h2>
                    <div class="flex items-center gap-3 mt-2">
                        <div class="avatar">
                            <div class="w-8 rounded-full"><img src="https://api.dicebear.com/7.x/pixel-art/svg?seed=John" /></div>
                        </div>
                        <span class="text-sm font-bold">John Doe</span>
                        <span class="badge badge-outline badge-xs">Vàng</span>
                    </div>
                    <div class="flex items-center gap-3 mt-2">
                        <div class="avatar">
                            <div class="w-8 rounded-full"><img src="https://api.dicebear.com/7.x/pixel-art/svg?seed=Jane" /></div>
                        </div>
                        <span class="text-sm font-bold">Jane Smith</span>
                        <span class="badge badge-outline badge-xs">Bạc</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
