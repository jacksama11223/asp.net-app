@model SmartLMS.Models.Course
@{
    ViewData["Title"] = "Tạo khóa học mới";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-8 flex items-center gap-4">
        <a asp-action="Dashboard" class="btn btn-circle btn-ghost">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-3xl font-bold">Thiết kế khóa học mới</h1>
    </div>

    <div class="card bg-base-100 shadow-2xl border border-base-200">
        <div class="card-body p-10">
            <form asp-action="Create" method="post" class="space-y-8">
                <!-- Cơ bản -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="form-control col-span-2">
                        <label class="label"><span class="label-text font-bold text-lg">Tiêu đề khóa học</span></label>
                        <input asp-for="Title" type="text" placeholder="Ví dụ: Lập trình ASP.NET Core từ Zero đến Hero" class="input input-bordered input-lg focus:input-primary" required />
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-bold">Chuyên mục</span></label>
                        <select asp-for="Category" class="select select-bordered focus:select-primary">
                            <option value="Web Development">Web Development</option>
                            <option value="Artificial Intelligence">AI & Machine Learning</option>
                            <option value="Mobile Apps">Mobile Apps</option>
                            <option value="Data Science">Data Science</option>
                            <option value="Design">UI/UX Design</option>
                        </select>
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-bold">Giá khóa học (VNĐ)</span></label>
                        <input asp-for="Price" type="number" placeholder="599000" class="input input-bordered focus:input-primary" required />
                    </div>
                </div>

                <!-- Nội dung & Thumbnail -->
                <div class="form-control">
                    <label class="label"><span class="label-text font-bold">Mô tả khóa học</span></label>
                    <textarea asp-for="Description" class="textarea textarea-bordered h-40 focus:textarea-primary" placeholder="Mô tả những gì học viên sẽ đạt được sau khóa học..."></textarea>
                </div>

                <div class="form-control">
                    <label class="label"><span class="label-text font-bold">Link ảnh Thumbnail (URL)</span></label>
                    <input asp-for="ThumbnailUrl" type="url" placeholder="https://example.com/image.jpg" class="input input-bordered focus:input-primary" />
                    <label class="label"><span class="label-text-alt opacity-60 italic">Gợi ý: Sử dụng ảnh chất lượng cao để tăng tỷ lệ click.</span></label>
                </div>

                <!-- AI Metrics (Tùy chọn) -->
                <div class="collapse collapse-plus bg-base-200 rounded-xl">
                    <input type="checkbox" /> 
                    <div class="collapse-title font-bold flex items-center gap-2">
                        <i class="fas fa-robot text-primary"></i> Thông số AI dự đoán (Nâng cao)
                    </div>
                    <div class="collapse-content"> 
                        <div class="form-control pt-4">
                            <label class="label"><span class="label-text font-medium text-sm">Mức độ tăng lương dự kiến (%)</span></label>
                            <input asp-for="AI_BaseSalaryImpact" type="number" placeholder="25" class="input input-bordered input-sm" />
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="flex justify-end gap-4 mt-10">
                    <a asp-action="Dashboard" class="btn btn-ghost normal-case">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-10 normal-case text-lg shadow-lg">Lưu & Xuất bản</button>
                </div>
            </form>
        </div>
    </div>
</div>
