@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Creator - SmartLMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.0.0/dist/full.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-inter bg-gradient-to-br from-indigo-50 to-purple-50 min-h-screen flex items-center justify-center p-4">
    <div class="card w-full max-w-md bg-base-100 shadow-2xl">
        <div class="card-body p-10">
            <div class="text-center mb-8">
                <h1 class="text-4xl font-extrabold text-primary mb-2">SmartLMS</h1>
                <p class="text-base-content/60 font-medium italic">Creator Portal Login</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-error mb-6 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="text-sm">@ViewBag.Error</span>
                </div>
            }

            <form action="/Account/Login" method="post" class="space-y-6">
                <div class="form-control">
                    <label class="label"><span class="label-text font-bold">Tên đăng nhập</span></label>
                    <input type="text" name="username" placeholder="Nhập username (VD: tran.minh)" class="input input-bordered focus:input-primary transition-all" required />
                </div>
                <div class="form-control">
                    <label class="label"><span class="label-text font-bold">Mật khẩu</span></label>
                    <input type="password" name="password" placeholder="••••••••" class="input input-bordered focus:input-primary transition-all" required />
                </div>
                
                <div class="flex items-center justify-between text-sm mt-2">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" class="checkbox checkbox-xs checkbox-primary" />
                        <span>Ghi nhớ tôi</span>
                    </label>
                    <a href="#" class="link link-primary no-underline font-medium">Quên mật khẩu?</a>
                </div>

                <div class="form-control mt-8">
                    <button type="submit" class="btn btn-primary shadow-lg hover:shadow-indigo-200 normal-case text-lg">Đăng nhập ngay</button>
                </div>
            </form>

            <div class="divider text-xs opacity-50 my-8">HOẶC</div>

            <div class="text-center">
                <p class="text-sm opacity-70">Bạn chưa có tài khoản Giảng viên?</p>
                <a href="/" class="link link-secondary no-underline font-bold mt-1 inline-block">Quay lại trang chủ cộng đồng</a>
            </div>
        </div>
    </div>
</body>
</html>
