<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartLMS Community Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }
        .tab-active { border-bottom: 4px solid #22d3ee; color: #0891b2; font-weight: 600; }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(226, 232, 240, 0.8); }
    </style>
</head>
<body class="text-slate-800">
    <!-- Header -->
    <header class="sticky top-0 z-50 w-full bg-white border-b border-slate-200 py-3 shadow-sm">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-10 h-10 bg-cyan-500 rounded-lg flex items-center justify-center shadow-lg shadow-cyan-200">
                    <span class="text-white font-bold text-xl">S</span>
                </div>
                <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-cyan-600 to-blue-600">SmartLMS Community</h1>
            </div>
            <div class="flex items-center gap-4">
                <div class="relative">
                    <input type="text" placeholder="Search community..." class="pl-10 pr-4 py-2 bg-slate-100 border-none rounded-full w-64 focus:ring-2 focus:ring-cyan-500 transition-all outline-none">
                    <svg class="w-5 h-5 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
                <button class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2 rounded-full font-semibold transition-all shadow-md">Sign In</button>
            </div>
        </div>
    </header>

    <!-- Main Navigation Tabs -->
    <nav class="bg-white border-b border-slate-200 sticky top-[65px] z-40">
        <div class="container mx-auto px-4 flex gap-8">
            <a asp-action="Index" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "tab-active" : "")">Discussion Forum</a>
            <a asp-action="Resources" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Resources" ? "tab-active" : "")">Resource Sharing</a>
            <a asp-action="Events" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Events" ? "tab-active" : "")">Event Listings</a>
            <a asp-action="Members" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Members" ? "tab-active" : "")">Member Directory</a>
            <a asp-action="QA" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "QA" ? "tab-active" : "")">Q&A Section</a>
            <a asp-action="Groups" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Groups" ? "tab-active" : "")">Study Groups</a>
            <a asp-action="Leaderboard" class="py-4 text-slate-600 hover:text-cyan-600 transition-all @(ViewContext.RouteData.Values["action"]?.ToString() == "Leaderboard" ? "tab-active" : "")">Leaderboard</a>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-8 flex gap-8">
        <!-- Content Area -->
        <div class="flex-1 min-w-0">
            @RenderBody()
        </div>

        <!-- Sidebar (Widgets) -->
        <aside class="w-80 hidden lg:block space-y-6">
            <!-- Announcements Widget -->
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
                    <span class="w-2 h-6 bg-cyan-500 rounded-full"></span>
                    Announcements
                </h3>
                <ul class="space-y-4">
                    <li class="group cursor-pointer">
                        <p class="text-sm font-semibold group-hover:text-cyan-600 transition-all">New Study Group for Calculus starting next week!</p>
                        <span class="text-xs text-slate-400">2 hours ago</span>
                    </li>
                    <li class="group cursor-pointer">
                        <p class="text-sm font-semibold group-hover:text-cyan-600 transition-all">Upcoming Webinar on AI Ethics in Education</p>
                        <span class="text-xs text-slate-400">Yesterday</span>
                    </li>
                </ul>
            </div>

            <!-- Active Members Widget -->
            <div class="glass-card rounded-2xl p-6 shadow-sm">
                <h3 class="font-bold text-lg mb-4 flex items-center gap-2">
                    <span class="w-2 h-6 bg-blue-500 rounded-full"></span>
                    Active Members
                </h3>
                <div class="grid grid-cols-4 gap-3">
                    @for(int i=1; i<=8; i++) {
                        <div class="w-12 h-12 bg-slate-200 rounded-xl overflow-hidden border-2 border-white shadow-sm hover:scale-110 transition-all cursor-pointer">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=User@(i)" alt="Member">
                        </div>
                    }
                </div>
                <button class="w-full mt-4 text-sm font-bold text-cyan-600 hover:bg-cyan-50 py-2 rounded-lg transition-all">View All Members</button>
            </div>
        </aside>
    </main>

    <footer class="bg-white border-t border-slate-200 py-8 mt-12">
        <div class="container mx-auto px-4 text-center text-slate-400 text-sm">
            &copy; 2026 SmartLMS.AI Community Hub. Built for Distributed Learning.
        </div>
    </footer>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
