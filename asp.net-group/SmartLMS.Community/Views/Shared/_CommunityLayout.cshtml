<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartLMS Community Hub</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        slate: { 350: '#94a3b8', 450: '#64748b', 750: '#1e293b' }
                    }
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="text-slate-800 bg-slate-50 flex flex-col min-h-screen overflow-x-hidden">

    <!-- Toast Alert Notice (Hidden by default) -->
    <div id="toastAlert" class="fixed top-8 left-1/2 -translate-x-1/2 z-[55] bg-slate-900 text-white text-xs font-bold px-5 py-3 rounded-2xl shadow-xl flex items-center gap-2 border border-slate-750 opacity-0 pointer-events-none transition-all duration-300 translate-y-[-20px]">
        <i data-lucide="check" class="w-4 h-4 text-emerald-500 shrink-0"></i>
        <span id="toastMessage">Thông báo</span>
    </div>

    <!-- Header -->
    <header class="sticky top-0 z-50 w-full bg-white border-b border-cyan-100 py-4 shadow-sm select-none">
        <div class="container mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
            
            <!-- Logo brand -->
            <a href="/hub" class="flex items-center gap-3 cursor-pointer">
                <div class="w-10 h-10 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-xl flex items-center justify-center shadow-lg shadow-cyan-200">
                    <span class="text-white font-extrabold text-xl">S</span>
                </div>
                <div>
                    <h1 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-cyan-600 to-blue-700 tracking-tight leading-tight">
                        SmartLMS Hub
                    </h1>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider leading-none">distributed learning hub</p>
                </div>
            </a>

            <!-- Search bar & Live accounts actions -->
            <div class="flex flex-wrap items-center justify-end gap-3.5 w-full sm:w-auto">
                <div class="relative">
                    <input type="text" placeholder="Tìm thảo luận, tài liệu, lớp học..." class="pl-10 pr-4 py-2.5 bg-slate-100/80 border-none text-slate-700 placeholder-slate-450 rounded-full w-48 sm:w-64 focus:ring-2 focus:ring-cyan-500 focus:bg-white text-xs transition-all outline-none font-medium" />
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3 text-slate-450"></i>
                </div>

                <div class="flex items-center gap-2.5">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userName = User.Identity.Name ?? "Thành viên";
                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Student";
                        <div class="flex items-center gap-2 pl-3 border-l border-slate-200">
                            <div class="w-9 h-9 rounded-xl overflow-hidden bg-slate-100 border-2 border-white shadow shadow-cyan-100 shrink-0">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@Uri.EscapeDataString(userName)" alt="Avatar" referrerpolicy="no-referrer" />
                            </div>
                            <div class="hidden md:block text-left">
                                <span class="text-xs font-bold text-slate-800 block leading-tight truncate max-w-[100px]">@userName</span>
                                <span class="text-[9px] bg-cyan-50 border border-cyan-100 text-cyan-700 px-2 py-0.5 rounded-full uppercase tracking-tighter font-black">@userRole</span>
                            </div>
                            <a href="/Auth/Logout" class="ml-1 text-[10px] text-slate-400 hover:text-red-500 font-bold transition-colors" title="Đăng xuất">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="/Auth/Login" class="flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-2 rounded-full text-xs font-bold transition-all shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            <span>Đăng Nhập</span>
                        </a>
                        <a href="/Auth/Register" class="flex items-center gap-1.5 border border-cyan-600 text-cyan-600 hover:bg-cyan-50 px-4 py-2 rounded-full text-xs font-bold transition-all shadow-sm">
                            <span>Đăng Ký</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation menu tab list -->
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    }
    <nav class="bg-white border-b border-cyan-100 sticky top-[73px] md:top-[69px] z-40 shadow-sm select-none overflow-x-auto">
        <div class="container mx-auto px-6 flex gap-6 md:gap-8 whitespace-nowrap overflow-x-auto pb-1 min-w-0" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">
            
            <a href="/hub" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Index" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="message-square" class="w-4 h-4"></i> Diễn đàn Thảo luận
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Moderator") || User.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.Role && (c.Value == "Admin" || c.Value == "Moderator")))
            {
                <a href="/admin/moderation" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Moderation" ? "border-indigo-600 text-indigo-600 font-extrabold" : "border-transparent text-slate-500 hover:text-indigo-600")">
                    <i data-lucide="shield-check" class="w-4 h-4"></i> Trạm Kiểm Duyệt
                </a>
            }

            <a href="/hub/resources" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Resources" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="book-open" class="w-4 h-4"></i> Chia sẻ Tài nguyên
            </a>

            <a href="/hub/events" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Events" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="calendar" class="w-4 h-4"></i> Danh sách Sự kiện
            </a>

            <a href="/hub/qa" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "QA" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="help-circle" class="w-4 h-4"></i> Chuyên mục Q&A
            </a>

            <a href="/hub/groups" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Groups" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="graduation-cap" class="w-4 h-4"></i> Nhóm tự học chung
            </a>

            <a href="/hub/members" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Members" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="users" class="w-4 h-4"></i> Danh mục Thành viên
            </a>

            <a href="/hub/leaderboard" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Leaderboard" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="trophy" class="w-4 h-4"></i> Bảng vinh danh
            </a>

            <a href="/hub/mentor" class="py-3.5 text-xs md:text-sm font-semibold transition-all flex items-center gap-1.5 border-b-2 @(currentAction == "Mentor" ? "border-cyan-600 text-cyan-600 font-extrabold" : "border-transparent text-slate-500 hover:text-cyan-600")">
                <i data-lucide="sparkles" class="w-4 h-4 text-pink-500 animate-pulse"></i> Trợ Lý AI Mentor (Hot)
            </a>

        </div>
    </nav>

    <!-- Main Container Workspace layout -->
    <main class="container mx-auto px-4 py-6 md:py-8 flex flex-col lg:flex-row gap-6 md:gap-8 flex-1">
        
        <!-- Horizontal Toolbox & Tags -->
        <div class="flex-1 min-w-0 flex flex-col gap-6">
            <div class="bg-white px-4 py-3 rounded-2xl border border-slate-100 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 select-none">
                <div class="flex items-center gap-2">
                    <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Từ khóa tiêu biểu:</span>
                    <div class="flex flex-wrap gap-2">
                        <button class="px-2 py-1 bg-cyan-100 text-cyan-700 text-[10px] font-bold rounded-lg hover:bg-cyan-200 transition-colors cursor-pointer">#dotnet</button>
                        <button class="px-2 py-1 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-lg hover:bg-blue-200 transition-colors cursor-pointer">#csharp</button>
                        <button class="px-2 py-1 bg-purple-100 text-purple-700 text-[10px] font-bold rounded-lg hover:bg-purple-200 transition-colors cursor-pointer">#database</button>
                        <button class="px-2 py-1 bg-emerald-100 text-emerald-700 text-[10px] font-bold rounded-lg hover:bg-emerald-200 transition-colors cursor-pointer">#algorithms</button>
                        <button class="px-2 py-1 bg-rose-100 text-rose-700 text-[10px] font-bold rounded-lg hover:bg-rose-200 transition-colors cursor-pointer">#ai</button>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            @RenderBody()
        </div>

        <!-- Right Sidebar Widgets -->
        <aside class="w-80 hidden lg:flex flex-col gap-6 shrink-0">
            <!-- User Stats Widget -->
            <div class="bg-white rounded-2xl p-5 border border-cyan-100 shadow-sm shadow-cyan-100/50 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-br from-cyan-100 to-blue-50 rounded-bl-full -z-10 opacity-60"></div>
                
                <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center justify-between">
                    <span>Thành tích của bạn</span>
                    <button class="text-cyan-600 hover:bg-cyan-50 p-1.5 rounded-lg transition-colors"><i data-lucide="bar-chart-2" class="w-4 h-4"></i></button>
                </h3>
                
                <div class="flex items-center gap-4 mb-5">
                    <div class="w-12 h-12 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-cyan-200/50">
                        <i data-lucide="trophy" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="text-2xl font-black text-slate-800 tracking-tight flex items-baseline gap-1">
                            350 <span class="text-xs font-bold text-cyan-600">XP</span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">Hạng 15 toàn hệ thống</p>
                    </div>
                </div>

                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between text-[11px] font-bold mb-1.5">
                            <span class="text-slate-600">Tiến trình level 5</span>
                            <span class="text-cyan-600">70%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
                            <div class="bg-gradient-to-r from-cyan-500 to-blue-500 h-1.5 rounded-full w-[70%]"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Contributors -->
            <div class="bg-white rounded-2xl p-5 border border-slate-150 shadow-sm relative overflow-hidden">
                <h3 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <i data-lucide="flame" class="w-4 h-4 text-orange-500"></i>
                    Thành viên sôi nổi
                </h3>
                
                <div class="space-y-4">
                    <div class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative">
                            <div class="w-9 h-9 rounded-xl overflow-hidden bg-slate-100 border-2 border-white shadow-sm">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=DucMinh" alt="User">
                            </div>
                            <div class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-yellow-400 border-2 border-white rounded-full flex items-center justify-center text-[8px] font-black text-yellow-900">1</div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-slate-800 group-hover:text-cyan-600 transition-colors truncate">Thầy Phạm Đức Minh</h4>
                            <p class="text-[10px] text-slate-500 truncate">12.5k XP &bull; Instructor</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-3 cursor-pointer group">
                        <div class="relative">
                            <div class="w-9 h-9 rounded-xl overflow-hidden bg-slate-100 border-2 border-white shadow-sm">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Hoang" alt="User">
                            </div>
                            <div class="absolute -top-1.5 -right-1.5 w-4 h-4 bg-slate-300 border-2 border-white rounded-full flex items-center justify-center text-[8px] font-black text-slate-700">2</div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-slate-800 group-hover:text-cyan-600 transition-colors truncate">Trần Văn Hoàng</h4>
                            <p class="text-[10px] text-slate-500 truncate">8.2k XP &bull; Student</p>
                        </div>
                    </div>
                </div>
                
                <button class="w-full mt-5 py-2 text-[11px] font-bold text-cyan-600 bg-cyan-50 hover:bg-cyan-100 rounded-xl transition-colors">
                    Xem Bảng Xếp Hạng
                </button>
            </div>
        </aside>

    </main>

    <!-- Footer information panel -->
    <footer class="bg-white border-t border-slate-200 py-6 text-center select-none mt-auto">
        <div class="container mx-auto px-4 text-slate-400 text-xs font-semibold uppercase tracking-wider space-y-1">
            <p>&copy; 2026 SmartLMS.AI Community Hub. Môi trường học tập phân tán cao chu đáo.</p>
            <p class="text-[9px] font-medium text-slate-350">Hệ thống học tập thông minh & vinh danh học thuật trực quan.</p>
        </div>
    </footer>

    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
        
        // Helper function for Toast
        window.showToast = function(message) {
            const toast = document.getElementById('toastAlert');
            const msg = document.getElementById('toastMessage');
            msg.innerText = message;
            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
            }, 3000);
        }
    </script>
    </script>
    
    <!-- TÍCH HỢP MESSENGER CHAT (PHASE 4) -->
    <!-- Alpine.js (Nếu chưa có) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <div id="messengerChatApp" x-data
         class="fixed z-[99] flex flex-col font-sans transition-all duration-300"
         :class="$store.chat.fullScreen ? 'inset-0 bg-white' : 'bottom-4 right-4 sm:bottom-6 sm:right-6 w-[calc(100%-2rem)] sm:w-80 h-[500px] max-h-[80vh] shadow-2xl rounded-2xl bg-white border border-slate-200'"
         x-show="$store.chat.chatOpen"
         style="display: none;"
    >
        <!-- Chat Header -->
        <div class="flex items-center justify-between p-3 border-b border-slate-100 bg-gradient-to-r from-cyan-600 to-indigo-600 text-white rounded-t-2xl" :class="$store.chat.fullScreen ? 'rounded-none' : ''">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                <h3 class="font-bold text-sm tracking-wide">Community Chat</h3>
            </div>
            <div class="flex items-center gap-2 text-white/80">
                <!-- Nút Phóng To / Thu Nhỏ -->
                <button @@click="$store.chat.fullScreen = !$store.chat.fullScreen" class="hover:text-white transition-colors" title="Phóng to toàn trang">
                    <i data-lucide="maximize" class="w-4 h-4" x-show="!$store.chat.fullScreen"></i>
                    <i data-lucide="minimize" class="w-4 h-4" x-show="$store.chat.fullScreen"></i>
                </button>
                <!-- Nút Đóng -->
                <button @@click="$store.chat.chatOpen = false; $store.chat.fullScreen = false" class="hover:text-white transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <!-- Chat Body -->
        <div id="chatMessagesContainer" class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50">
            <template x-for="(msg, index) in $store.chat.messages" :key="index">
                <div class="flex w-full" :class="msg.isMine ? 'justify-end' : 'justify-start'">
                    <div class="flex items-end max-w-[85%] gap-2" :class="msg.isMine ? 'flex-row-reverse' : 'flex-row'">
                        
                        <!-- Avatar -->
                        <template x-if="!msg.isMine">
                            <img :src="msg.avatar" class="w-8 h-8 rounded-full border border-slate-200 shrink-0" />
                        </template>
                        
                        <div class="flex flex-col gap-1 w-full" :class="msg.isMine ? 'items-end' : 'items-start'">
                            <!-- Tên người gửi -->
                            <span x-show="!msg.isMine" class="text-[10px] text-slate-400 mx-1 font-semibold" x-text="msg.name"></span>
                            
                            <!-- Khung chữ và Reactions wrapper -->
                            <div class="relative group" style="width: max-content; max-width: 100%;">
                                <!-- Bubble -->
                                <div class="px-3 py-2 text-sm shadow-sm rounded-2xl break-words"
                                     style="word-break: break-word;"
                                     :class="msg.isMine ? 'bg-cyan-600 text-white rounded-br-sm text-left' : 'bg-white border border-slate-100 text-slate-800 rounded-bl-sm text-left'">
                                    <span x-text="msg.text" class="whitespace-pre-wrap"></span>
                                    
                                    <!-- LINK PREVIEW (RICH EMBED CARD) -->
                                    <template x-if="msg.previewTitle">
                                        <a :href="msg.postUrl" target="_blank" class="block mt-2 bg-slate-50 border border-slate-200 rounded-xl overflow-hidden hover:border-cyan-400 transition-colors cursor-pointer no-underline group block text-left">
                                            <div class="h-24 bg-gradient-to-br from-slate-200 to-slate-100 relative">
                                                <div class="absolute inset-0 flex items-center justify-center group-hover:scale-110 transition-transform">
                                                    <i data-lucide="link" class="w-8 h-8 text-slate-400"></i>
                                                </div>
                                            </div>
                                            <div class="p-3">
                                                <h4 class="text-xs font-bold text-slate-800 line-clamp-1 group-hover:text-cyan-700" x-text="msg.previewTitle"></h4>
                                                <p class="text-[10px] text-slate-500 mt-1 line-clamp-2 leading-tight" x-text="msg.previewDesc"></p>
                                            </div>
                                        </a>
                                    </template>
                                </div>
                                
                                <!-- Nút thả tim (Hiện khi hover) -->
                                <div class="absolute -bottom-3 hidden group-hover:flex items-center justify-center gap-1 bg-white border border-slate-200 rounded-full shadow-sm px-1.5 py-0.5 text-xs z-10"
                                     :class="msg.isMine ? '-left-8' : '-right-8'">
                                    <button class="hover:scale-125 transition-transform" @@click="$store.chat.reactToMessage(msg.id, '❤️')">❤️</button>
                                    <button class="hover:scale-125 transition-transform" @@click="$store.chat.reactToMessage(msg.id, '👍')">👍</button>
                                    <button class="hover:scale-125 transition-transform" @@click="$store.chat.reactToMessage(msg.id, '😂')">😂</button>
                                </div>
                            </div>
                            
                            <!-- Hiển thị Reactions đã thả -->
                            <template x-if="msg.reactions && Object.keys(msg.reactions).length > 0">
                                <div class="flex flex-wrap gap-1 mt-0.5" :class="msg.isMine ? 'justify-end' : 'justify-start'">
                                    <template x-for="(count, emoji) in msg.reactions" :key="emoji">
                                        <button class="text-[10px] bg-white px-1.5 py-0.5 rounded-full border border-slate-200 text-slate-600 shadow-sm hover:bg-slate-50 transition-colors"
                                                @@click="$store.chat.reactToMessage(msg.id, emoji)">
                                            <span x-text="emoji"></span> <span x-text="count" class="font-bold"></span>
                                        </button>
                                    </template>
                                </div>
                            </template>
                            
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Chat Input Area -->
        <div class="p-3 border-t border-slate-100 bg-white" :class="$store.chat.fullScreen ? 'rounded-none' : 'rounded-b-2xl'">
            <form x-on:submit.prevent="$store.chat.sendMessage()" class="flex items-end gap-2 relative">
                <textarea x-model="$store.chat.msgText" rows="1" placeholder="Nhập tin nhắn..." class="flex-1 bg-slate-100 border-none rounded-xl px-4 py-2.5 text-sm text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500/50 resize-none max-h-24 min-h-[44px]" x-on:keydown.enter.prevent="if(!$event.shiftKey) $store.chat.sendMessage()"></textarea>
                <button type="submit" class="p-2.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl transition-transform active:scale-90 shadow-md flex items-center justify-center shrink-0 h-[44px] w-[44px]" :disabled="!$store.chat.msgText.trim()">
                    <i data-lucide="send" class="w-4 h-4 ml-0.5"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- FAB (Nút Mở Chat) -->
    <div x-data>
        <button id="fabChatBtn" @@click="$store.chat.chatOpen = true; setTimeout(()=>lucide.createIcons(), 50)" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 w-14 h-14 bg-gradient-to-tr from-cyan-600 to-indigo-600 text-white rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(8,145,178,0.4)] hover:scale-110 hover:shadow-[0_15px_35px_rgba(8,145,178,0.5)] transition-all z-[98]">
            <i data-lucide="message-circle" class="w-6 h-6"></i>
            <!-- Ping Badge -->
            <span class="absolute top-0 right-0 w-3.5 h-3.5 bg-rose-500 border-2 border-white rounded-full"></span>
        </button>
    </div>

    <!-- SignalR for Real-time Notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.store('chat', {
                chatOpen: false,
                fullScreen: false,
                msgText: '',
                messages: [],
                init() {
                    // Fetch chat history from DB
                    fetch('/api/chat/history')
                        .then(res => res.json())
                        .then(data => {
                            const myName = '@(User.Identity?.Name)';
                            const localGuestName = localStorage.getItem('guestChatName');
                            const myLocalName = localGuestName ? (localGuestName + " (Khách)") : null;
                            
                            this.messages = data.map(msg => {
                                let parsedReactions = {};
                                try { if(msg.reactionsJson) parsedReactions = JSON.parse(msg.reactionsJson); } catch(e){}
                                return {
                                    id: msg.id,
                                    name: msg.name,
                                    avatar: msg.avatar,
                                    text: msg.text,
                                    postUrl: msg.postUrl,
                                    previewTitle: msg.previewTitle,
                                    previewDesc: msg.previewDesc,
                                    reactions: parsedReactions,
                                    isMine: (myName && msg.name === myName) || (!myName && myLocalName && msg.name === myLocalName)
                                };
                            });
                            
                            // Tự cuộn xuống dưới cùng khi load xong
                            setTimeout(() => {
                                const container = document.getElementById('chatMessagesContainer');
                                if(container) container.scrollTop = container.scrollHeight;
                            }, 300);
                        })
                        .catch(err => console.error("Failed to load chat history:", err));
                },
                sendMessage() {
                    if(!this.msgText.trim()) return;

                    let name = '@(User.Identity?.Name)';
                    
                    // Xử lý khách lạ (Guest)
                    if (!name) {
                        let guestName = localStorage.getItem('guestChatName');
                        if (!guestName) {
                            guestName = prompt("Chào bạn! Vui lòng nhập tên của bạn để tham gia nhóm Chat:");
                            if (guestName && guestName.trim()) {
                                localStorage.setItem('guestChatName', guestName.trim());
                            } else {
                                return; // Hủy gửi nếu không nhập tên
                            }
                        }
                        name = guestName + " (Khách)";
                    }

                    const avatar = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name);
                    
                    // Gửi qua SignalR
                    hubConnection.invoke("SendMessageToAll", name, avatar, this.msgText, "", "", "")
                        .catch(err => console.error(err.toString()));
                        
                    this.msgText = '';
                },
                receiveMessage(messageId, senderName, senderAvatar, message, postUrl, previewTitle, previewDesc) {
                    const myName = '@(User.Identity?.Name)';
                    const localGuestName = localStorage.getItem('guestChatName');
                    const myLocalName = localGuestName ? (localGuestName + " (Khách)") : null;
                    const isMine = (myName && senderName === myName) || (!myName && myLocalName && senderName === myLocalName);
                    
                    this.messages.push({
                        id: messageId,
                        name: senderName,
                        avatar: senderAvatar || 'https://ui-avatars.com/api/?name=U',
                        text: message,
                        isMine: isMine,
                        postUrl: postUrl,
                        previewTitle: previewTitle,
                        previewDesc: previewDesc,
                        reactions: {}
                    });
                    
                    if(!this.chatOpen && !isMine) {
                        if(window.showToast) window.showToast("💬 Tin nhắn mới từ " + senderName);
                    }
                    
                    // Auto scroll to bottom
                    setTimeout(() => {
                        const container = document.getElementById('chatMessagesContainer');
                        if(container) container.scrollTop = container.scrollHeight;
                    }, 100);
                },
                reactToMessage(messageId, emoji) {
                    if (!messageId) return;
                    hubConnection.invoke("ReactToMessage", messageId, emoji)
                        .catch(err => console.error(err.toString()));
                },
                updateReaction(messageId, reactionsJson) {
                    const msg = this.messages.find(m => m.id === messageId);
                    if (msg) {
                        try {
                            msg.reactions = JSON.parse(reactionsJson);
                        } catch(e){}
                    }
                }
            });
        });

        const hubConnection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/community")
            .withAutomaticReconnect()
            .build();

        hubConnection.on("ReceiveNotification", function (message) {
            if(window.showToast) window.showToast("🔔 " + message);
        });

        hubConnection.on("ReceiveMessage", function (messageId, senderName, senderAvatar, message, postUrl, previewTitle, previewDesc) {
            if (Alpine && Alpine.store('chat')) {
                Alpine.store('chat').receiveMessage(messageId, senderName, senderAvatar, message, postUrl, previewTitle, previewDesc);
            }
        });
        
        hubConnection.on("MessageReacted", function (messageId, reactionsJson) {
            if (Alpine && Alpine.store('chat')) {
                Alpine.store('chat').updateReaction(messageId, reactionsJson);
            }
        });

        hubConnection.start().catch(function (err) {
            console.error("SignalR Error:", err.toString());
        });

        // Tích hợp Share Modal vào Chat
        window.sendPostToChat = function(postId, title, category) {
            let name = '@(User.Identity?.Name)';
            if (!name) {
                let guestName = localStorage.getItem('guestChatName');
                if (!guestName) {
                    guestName = prompt("Vui lòng nhập tên của bạn trước khi chia sẻ bài viết:");
                    if (guestName && guestName.trim()) {
                        localStorage.setItem('guestChatName', guestName.trim());
                    } else {
                        return;
                    }
                }
                name = guestName + " (Khách)";
            }

            const avatar = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(name);
            const postUrl = `/hub/post/${postId}`;
            
            // Gửi tin nhắn kèm thẻ Preview
            hubConnection.invoke("SendMessageToAll", name, avatar, "Hãy xem bài thảo luận này nhé!", postUrl, title, category)
                .catch(err => console.error(err.toString()));
                
            if(window.showToast) window.showToast("✅ Đã gửi bài viết vào khung chat nhóm!");
            
            // Tự động mở chat
            if (Alpine && Alpine.store('chat')) {
                Alpine.store('chat').chatOpen = true;
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

