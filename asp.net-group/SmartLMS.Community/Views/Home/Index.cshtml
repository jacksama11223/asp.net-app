@using SmartLMS.Models
@model IEnumerable<Post>
@{
    Layout = null;
    var events = ViewBag.Events as IEnumerable<CommunityEvent>;
    var resources = ViewBag.Resources as IEnumerable<CommunityResource>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Group Learning Hub - SmartLMS.AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #F9FAFB; }
        .premium-card { transition: all 0.3s ease; border: 1px solid #E5E7EB; }
        .premium-card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); border-color: #3B82F6; }
        .btn-premium { transition: all 0.2s; }
        .btn-premium:active { transform: scale(0.95); }
    </style>
</head>
<body class="text-gray-800">

    <!-- Header -->
    <header class="bg-white border-b sticky top-0 z-50 px-6 py-4 flex justify-between items-center shadow-sm">
        <div class="flex gap-2">
            <button class="bg-[#00B4D8] text-white px-5 py-2 rounded-lg font-semibold btn-premium shadow-sm">Sign up</button>
            <button class="bg-[#1B263B] text-white px-5 py-2 rounded-lg font-semibold btn-premium shadow-sm">Sign in</button>
        </div>
        <div class="flex items-center gap-4 w-1/3 relative">
            <input type="text" placeholder="Search..." class="w-full bg-gray-50 border border-gray-200 rounded-full py-2 px-10 focus:outline-none focus:ring-2 focus:ring-[#00B4D8] transition-all">
            <svg class="w-5 h-5 text-gray-400 absolute left-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <div class="bg-gray-100 rounded-full w-8 h-8 flex items-center justify-center text-gray-500 cursor-pointer hover:bg-gray-200">?</div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12">
        <!-- Hero Section -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold text-[#1B263B] mb-2">Group Learning Hub</h1>
            <p class="text-gray-500 text-xl font-light">Connect, Share, and Grow Together.</p>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex justify-center border-b mb-10 overflow-x-auto">
            <nav class="flex gap-8">
                <a href="#" class="border-b-4 border-[#3B82F6] py-4 px-2 font-bold text-gray-900">Discussion Forum</a>
                <a href="#" class="border-b-4 border-transparent py-4 px-2 font-semibold text-gray-500 hover:text-gray-900 transition-all">Resource Sharing</a>
                <a href="#" class="border-b-4 border-transparent py-4 px-2 font-semibold text-gray-500 hover:text-gray-900 transition-all">Event Listings</a>
                <a href="#" class="border-b-4 border-transparent py-4 px-2 font-semibold text-gray-500 hover:text-gray-900 transition-all">Member Directory</a>
                <a href="#" class="border-b-4 border-transparent py-4 px-2 font-semibold text-gray-500 hover:text-gray-900 transition-all">Q&A Section</a>
            </nav>
        </div>

        <div class="grid grid-cols-12 gap-8">
            
            <!-- Left Column (Forum Content) -->
            <div class="col-span-8">
                <div class="flex flex-col gap-6">
                    <div class="flex justify-between items-center mb-2">
                        <button class="bg-[#3B82F6] text-white px-8 py-3 rounded-lg font-bold shadow-lg hover:bg-blue-600 btn-premium">Create New Post</button>
                    </div>

                    <div class="flex gap-4 items-center">
                        <input type="text" placeholder="Search forum..." class="flex-grow border border-gray-200 rounded-lg py-2 px-4 focus:ring-2 focus:ring-blue-500">
                        <div class="flex items-center gap-2">
                            <span class="text-gray-500 font-semibold">Sort by:</span>
                            <select class="border border-gray-200 rounded-lg py-2 px-4 focus:outline-none">
                                <option>Latest</option>
                                <option>Popular</option>
                            </select>
                        </div>
                    </div>

                    <!-- Post List -->
                    <div class="space-y-4">
                        @foreach(var post in Model)
                        {
                            <div class="bg-white p-6 rounded-xl premium-card flex justify-between items-center">
                                <div>
                                    <h3 class="text-blue-700 text-xl font-bold mb-2 cursor-pointer hover:underline">@post.Title</h3>
                                    <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
                                        <span>Author: <strong class="text-gray-700">@(post.Author?.FullName ?? "Admin")</strong></span>
                                        <span>|</span>
                                        <span>Last Activity: @post.LastActivityAt.ToString("HH:mm dd/MM/yyyy")</span>
                                    </div>
                                    <div class="flex gap-2">
                                        @if(!string.IsNullOrEmpty(post.Tags))
                                        {
                                            @foreach(var tag in post.Tags.Split(','))
                                            {
                                                <span class="bg-blue-50 text-blue-600 px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider">@tag</span>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="text-gray-400 font-bold">@post.Comments.Count replies</span>
                                </div>
                            </div>
                        }

                        <!-- Pagination Mockup -->
                        <div class="flex justify-center items-center gap-4 mt-10">
                            <button class="bg-gray-100 px-6 py-2 rounded-lg text-gray-500 font-bold hover:bg-gray-200">Prior</button>
                            <button class="bg-gray-100 px-6 py-2 rounded-lg text-gray-500 font-bold hover:bg-gray-200">Next</button>
                            <div class="flex items-center gap-2 text-gray-400">
                                <span>Jump to:</span>
                                <input type="text" class="w-12 border rounded-md py-1 px-2">
                                <button class="bg-gray-100 p-2 rounded-md">➔</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column (Sidebar) -->
            <div class="col-span-4 space-y-6">
                
                <!-- Announcements -->
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                    <h4 class="font-bold text-lg mb-4 text-[#1B263B]">Announcements</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-blue-600 hover:underline">New Study Group for Calculus</a></li>
                        <li><a href="#" class="text-blue-600 hover:underline">Upcoming Webinar on AI Ethics</a></li>
                        <li><a href="#" class="text-blue-600 hover:underline">Group Mentorship Program Launched</a></li>
                    </ul>
                </div>

                <!-- Quick Links -->
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                    <h4 class="font-bold text-lg mb-4 text-[#1B263B]">Quick Links</h4>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-blue-600 hover:underline">Student Page</a></li>
                        <li><a href="#" class="text-blue-600 hover:underline">My Profile</a></li>
                        <li><a href="#" class="text-blue-600 hover:underline">Group Settings</a></li>
                        <li><a href="#" class="text-blue-600 hover:underline">Invite Friends</a></li>
                    </ul>
                </div>

                <!-- Upcoming Events -->
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                    <h4 class="font-bold text-lg mb-4 text-[#1B263B]">Upcoming Events</h4>
                    <div class="space-y-4">
                        @foreach(var evt in events ?? new List<CommunityEvent>())
                        {
                            <div class="border rounded-lg p-4 bg-gray-50">
                                <h5 class="font-bold">@evt.Title</h5>
                                <p class="text-xs text-gray-400 mb-2">@evt.EventDate.ToString("MMM dd, yyyy, h:mm tt") EST</p>
                                <p class="text-xs text-blue-500 mb-3">@evt.Location</p>
                                <button class="bg-[#3B82F6] text-white text-xs px-4 py-2 rounded font-bold w-full">View Details</button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Active Members -->
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm text-center">
                    <h4 class="font-bold text-lg mb-4 text-[#1B263B] text-left">Active Members</h4>
                    <div class="grid grid-cols-3 gap-4">
                        @for(int i=0; i<6; i++) {
                            <div class="flex flex-col items-center">
                                <div class="w-16 h-16 bg-gray-200 border-2 border-gray-300 flex items-center justify-center text-gray-400 relative">
                                    <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20"><path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"></path></svg>
                                    <div class="absolute -right-1 -bottom-1 w-4 h-4 bg-green-500 border-2 border-white rounded-full"></div>
                                </div>
                                <span class="text-xs mt-1 text-gray-500">Member @i</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- New Resources -->
                <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                    <h4 class="font-bold text-lg mb-4 text-[#1B263B]">New Resources</h4>
                    <div class="space-y-4">
                        @foreach(var res in resources ?? new List<CommunityResource>())
                        {
                            <div class="flex justify-between items-start border-b pb-4 last:border-0">
                                <div class="w-2/3">
                                    <h5 class="font-bold text-sm">@res.Title</h5>
                                    <p class="text-[10px] text-gray-400">Uploaded by @(res.Uploader?.FullName ?? "Admin") | @res.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                                <button class="bg-[#2DCE89] text-white text-[10px] px-3 py-1 rounded font-bold">Download</button>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </main>

    <footer class="text-center py-12 text-gray-400 text-sm border-t mt-20">
        &copy; 2026 SmartLMS.AI Community Hub. All rights reserved.
    </footer>

</body>
</html>
