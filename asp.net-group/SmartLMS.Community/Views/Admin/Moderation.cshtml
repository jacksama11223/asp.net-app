@model IEnumerable<SmartLMS.Models.Post>
@{
    Layout = "~/Views/Shared/_CommunityLayout.cshtml";
    ViewData["Title"] = "Trạm kiểm duyệt nội dung (Moderation Board)";
    
    var pendingEvents = ViewBag.PendingEvents as IEnumerable<SmartLMS.Models.CommunityEvent> ?? new List<SmartLMS.Models.CommunityEvent>();
    var pendingQuestions = ViewBag.PendingQuestions as IEnumerable<SmartLMS.Models.CommunityQuestion> ?? new List<SmartLMS.Models.CommunityQuestion>();
    var pendingGroups = ViewBag.PendingGroups as IEnumerable<SmartLMS.Models.StudyGroup> ?? new List<SmartLMS.Models.StudyGroup>();
}

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 font-sans" x-data="{ activeTab: 'posts' }">
    
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                <i data-lucide="shield-check" class="w-6 h-6 text-indigo-600"></i>
                Bảng kiểm duyệt nội dung
            </h1>
            <p class="text-xs text-slate-500 font-semibold mt-1">Dành cho Admin và Moderator xét duyệt mọi nội dung trước khi hiển thị công khai.</p>
        </div>
        <div class="bg-indigo-50 border border-indigo-100 px-4 py-2 rounded-xl flex items-center gap-2">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-indigo-500"></span>
            </span>
            <span class="text-xs font-black text-indigo-800">@ViewBag.PendingCount Nội dung đang chờ</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl mb-6 text-sm font-bold flex items-center gap-2">
            <i data-lucide="check-circle" class="w-5 h-5"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- TABS -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-slate-200 pb-2">
        <button @@click="activeTab = 'posts'" :class="activeTab === 'posts' ? 'text-indigo-600 border-indigo-600 border-b-2 font-black' : 'text-slate-500 font-semibold'" class="px-4 py-2 text-sm transition-all focus:outline-none flex items-center gap-2">
            Bài viết (@(Model.Count()))
        </button>
        <button @@click="activeTab = 'events'" :class="activeTab === 'events' ? 'text-indigo-600 border-indigo-600 border-b-2 font-black' : 'text-slate-500 font-semibold'" class="px-4 py-2 text-sm transition-all focus:outline-none flex items-center gap-2">
            Sự kiện (@(pendingEvents.Count()))
        </button>
        <button @@click="activeTab = 'qa'" :class="activeTab === 'qa' ? 'text-indigo-600 border-indigo-600 border-b-2 font-black' : 'text-slate-500 font-semibold'" class="px-4 py-2 text-sm transition-all focus:outline-none flex items-center gap-2">
            Hỏi đáp Q&A (@(pendingQuestions.Count()))
        </button>
        <button @@click="activeTab = 'groups'" :class="activeTab === 'groups' ? 'text-indigo-600 border-indigo-600 border-b-2 font-black' : 'text-slate-500 font-semibold'" class="px-4 py-2 text-sm transition-all focus:outline-none flex items-center gap-2">
            Nhóm học tập (@(pendingGroups.Count()))
        </button>
    </div>

    <!-- POSTS TAB -->
    <div x-show="activeTab === 'posts'" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        @if (Model != null && Model.Any())
        {
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-[10px] uppercase font-black tracking-wider">
                        <th class="px-6 py-4">Tác giả</th>
                        <th class="px-6 py-4">Chủ đề & Tiêu đề</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var post in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 w-1/4">
                                <div class="flex items-center gap-2.5">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(post.Author?.FullName ?? "U")" class="w-8 h-8 rounded-full border border-slate-200" />
                                    <div>
                                        <div class="text-xs font-black text-slate-800">@post.Author?.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-[9px] bg-cyan-100 text-cyan-800 px-2 py-0.5 rounded font-black uppercase mb-1 inline-block">@post.Category</span>
                                <div class="text-xs font-bold text-slate-700 leading-snug">@post.Title</div>
                                <div class="text-[10px] text-slate-500 mt-1">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center w-32">
                                <div class="flex items-center justify-center gap-2">
                                    <form asp-controller="Admin" asp-action="ApprovePost" asp-route-id="@post.PostId" method="post">
                                        <button type="submit" class="p-2 bg-emerald-50 hover:bg-emerald-500 text-emerald-600 hover:text-white rounded-lg transition-colors cursor-pointer" title="Duyệt bài"><i data-lucide="check" class="w-4 h-4"></i></button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="RejectPost" asp-route-id="@post.PostId" method="post" onsubmit="return confirm('TỪ CHỐI và XÓA bài viết này?');">
                                        <button type="submit" class="p-2 bg-rose-50 hover:bg-rose-500 text-rose-600 hover:text-white rounded-lg transition-colors cursor-pointer" title="Từ chối & Ẩn"><i data-lucide="x" class="w-4 h-4"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="py-12 text-center text-slate-500 font-bold text-sm">Không có bài viết chờ duyệt.</div> }
    </div>

    <!-- EVENTS TAB -->
    <div x-show="activeTab === 'events'" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" style="display:none;">
        @if (pendingEvents.Any())
        {
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-[10px] uppercase font-black tracking-wider">
                        <th class="px-6 py-4">Tên sự kiện</th>
                        <th class="px-6 py-4">Thời gian / Địa điểm</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in pendingEvents)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4">
                                <span class="text-[9px] bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-black uppercase mb-1 inline-block">@item.EventType</span>
                                <div class="text-xs font-bold text-slate-700 leading-snug">@item.Title</div>
                            </td>
                            <td class="px-6 py-4 text-xs font-semibold text-slate-600">
                                <div>@item.EventDate.ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="text-[10px] text-slate-400">@item.Location</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center w-32">
                                <div class="flex items-center justify-center gap-2">
                                    <form asp-controller="Admin" asp-action="ApproveItem" asp-route-type="event" asp-route-id="@item.Id" method="post"><button type="submit" class="p-2 bg-emerald-50 hover:bg-emerald-500 text-emerald-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="check" class="w-4 h-4"></i></button></form>
                                    <form asp-controller="Admin" asp-action="RejectItem" asp-route-type="event" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa?');"><button type="submit" class="p-2 bg-rose-50 hover:bg-rose-500 text-rose-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="py-12 text-center text-slate-500 font-bold text-sm">Không có sự kiện chờ duyệt.</div> }
    </div>

    <!-- QA TAB -->
    <div x-show="activeTab === 'qa'" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" style="display:none;">
        @if (pendingQuestions.Any())
        {
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-[10px] uppercase font-black tracking-wider">
                        <th class="px-6 py-4">Tác giả</th>
                        <th class="px-6 py-4">Nội dung câu hỏi</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in pendingQuestions)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 w-1/4">
                                <div class="flex items-center gap-2.5">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.Author?.FullName ?? "U")" class="w-8 h-8 rounded-full border border-slate-200" />
                                    <div class="text-xs font-black text-slate-800">@item.Author?.FullName</div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-xs font-bold text-slate-700 leading-snug">@item.Title</div>
                                <div class="text-[10px] font-medium text-slate-500 mt-1 line-clamp-2">@item.Content</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center w-32">
                                <div class="flex items-center justify-center gap-2">
                                    <form asp-controller="Admin" asp-action="ApproveItem" asp-route-type="question" asp-route-id="@item.Id" method="post"><button type="submit" class="p-2 bg-emerald-50 hover:bg-emerald-500 text-emerald-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="check" class="w-4 h-4"></i></button></form>
                                    <form asp-controller="Admin" asp-action="RejectItem" asp-route-type="question" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa?');"><button type="submit" class="p-2 bg-rose-50 hover:bg-rose-500 text-rose-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="py-12 text-center text-slate-500 font-bold text-sm">Không có câu hỏi chờ duyệt.</div> }
    </div>

    <!-- GROUPS TAB -->
    <div x-show="activeTab === 'groups'" class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden" style="display:none;">
        @if (pendingGroups.Any())
        {
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 text-[10px] uppercase font-black tracking-wider">
                        <th class="px-6 py-4">Tên nhóm</th>
                        <th class="px-6 py-4">Môn học</th>
                        <th class="px-6 py-4 text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in pendingGroups)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="text-xs font-bold text-slate-700 leading-snug">@item.Name</div>
                                <div class="text-[10px] font-medium text-slate-500 mt-1 line-clamp-1">Trưởng nhóm: @item.Leader?.FullName</div>
                            </td>
                            <td class="px-6 py-4 text-xs font-semibold text-slate-600">@item.Subject</td>
                            <td class="px-6 py-4 whitespace-nowrap text-center w-32">
                                <div class="flex items-center justify-center gap-2">
                                    <form asp-controller="Admin" asp-action="ApproveItem" asp-route-type="group" asp-route-id="@item.Id" method="post"><button type="submit" class="p-2 bg-emerald-50 hover:bg-emerald-500 text-emerald-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="check" class="w-4 h-4"></i></button></form>
                                    <form asp-controller="Admin" asp-action="RejectItem" asp-route-type="group" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa?');"><button type="submit" class="p-2 bg-rose-50 hover:bg-rose-500 text-rose-600 hover:text-white rounded-lg transition-colors cursor-pointer"><i data-lucide="x" class="w-4 h-4"></i></button></form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <div class="py-12 text-center text-slate-500 font-bold text-sm">Không có nhóm học tập chờ duyệt.</div> }
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        lucide.createIcons();
    });
</script>
