@model SmartLMS.Community.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng Nhập";
}

<div>
    <h2 class="text-white font-black text-2xl mb-1">Chào mừng trở lại 👋</h2>
    <p class="text-white/50 text-sm mb-7 font-medium">Đăng nhập để tiếp tục học cùng cộng đồng.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-500/15 border border-red-400/30 rounded-xl p-3 mb-5 text-red-300 text-xs font-semibold">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>⚠️ @error.ErrorMessage</div>
            }
        </div>
    }

    <!form asp-action="Login" asp-controller="Auth" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                📧 Tài khoản / Email
            </label>
            <input id="login-email"
                   asp-for="Email"
                   type="text"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="your@email.com"
                   autocomplete="email" />
            <span asp-validation-for="Email" class="error-text"></span>
        </div>

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                🔒 Mật Khẩu
            </label>
            <input id="login-password"
                   asp-for="Password"
                   type="password"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="••••••••"
                   autocomplete="current-password" />
            <span asp-validation-for="Password" class="error-text"></span>
        </div>

        <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 cursor-pointer select-none">
                <input asp-for="RememberMe" type="checkbox" class="w-3.5 h-3.5 rounded accent-cyan-500" />
                <span class="text-white/60 text-xs font-semibold">Ghi nhớ đăng nhập</span>
            </label>
            <a href="#" class="text-cyan-400 text-xs font-bold hover:text-cyan-300 transition-colors">Quên mật khẩu?</a>
        </div>

        <button id="btn-login"
                type="submit"
                class="btn-primary w-full py-3.5 rounded-xl text-white font-extrabold text-sm tracking-wide mt-2">
            Đăng Nhập vào Hub →
        </button>
    </!form>

    <div class="flex items-center gap-3 my-6">
        <div class="flex-1 h-px bg-white/10"></div>
        <span class="text-white/30 text-xs font-bold">HOẶC</span>
        <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <a href="/Auth/Register"
       class="block w-full py-3 rounded-xl border border-white/15 text-center text-white/70 hover:text-white hover:border-white/30 hover:bg-white/5 text-sm font-bold transition-all">
        Chưa có tài khoản? <span class="text-cyan-400">Đăng ký ngay</span>
    </a>

    <p class="text-center mt-4 text-white/30 text-xs">
        Hoặc <a href="http://141.253.114.218" class="text-cyan-400/70 hover:text-cyan-400 transition-colors font-semibold">đăng nhập qua trang chính (Port 80)</a>
    </p>
</div>
