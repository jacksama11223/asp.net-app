@model SmartLMS.Community.ViewModels.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div>
    <h2 class="text-white font-black text-2xl mb-1">Tạo tài khoản mới 🚀</h2>
    <p class="text-white/50 text-sm mb-7 font-medium">Tham gia cộng đồng học tập .NET lớn nhất Việt Nam.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="bg-red-500/15 border border-red-400/30 rounded-xl p-3 mb-5 text-red-300 text-xs font-semibold space-y-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>⚠️ @error.ErrorMessage</div>
            }
        </div>
    }

    <!form asp-action="Register" asp-controller="Auth" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                👤 Họ và Tên
            </label>
            <input id="reg-fullname"
                   asp-for="FullName"
                   type="text"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="Nguyễn Văn A"
                   autocomplete="name" />
            <span asp-validation-for="FullName" class="error-text"></span>
        </div>

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                📧 Địa Chỉ Email
            </label>
            <input id="reg-email"
                   asp-for="Email"
                   type="email"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="your@email.com"
                   autocomplete="email" />
            <span asp-validation-for="Email" class="error-text"></span>
        </div>

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                🔒 Mật Khẩu
            </label>
            <input id="reg-password"
                   asp-for="Password"
                   type="password"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="Tối thiểu 6 ký tự"
                   autocomplete="new-password" />
            <span asp-validation-for="Password" class="error-text"></span>
        </div>

        <div>
            <label class="text-white/70 text-xs font-bold uppercase tracking-wider block mb-1.5">
                🔒 Xác Nhận Mật Khẩu
            </label>
            <input id="reg-confirm"
                   asp-for="ConfirmPassword"
                   type="password"
                   class="input-field w-full rounded-xl px-4 py-3 text-sm font-medium"
                   placeholder="Nhập lại mật khẩu"
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="error-text"></span>
        </div>

        <p class="text-white/30 text-[10px] leading-relaxed">
            Bằng cách đăng ký, bạn đồng ý với <a href="#" class="text-cyan-400/70 hover:text-cyan-400">Điều khoản dịch vụ</a> và <a href="#" class="text-cyan-400/70 hover:text-cyan-400">Chính sách bảo mật</a> của SmartLMS.
        </p>

        <button id="btn-register"
                type="submit"
                class="btn-primary w-full py-3.5 rounded-xl text-white font-extrabold text-sm tracking-wide mt-2">
            Tạo Tài Khoản Ngay 🎉
        </button>
    </!form>

    <div class="flex items-center gap-3 my-5">
        <div class="flex-1 h-px bg-white/10"></div>
        <span class="text-white/30 text-xs font-bold">HOẶC</span>
        <div class="flex-1 h-px bg-white/10"></div>
    </div>

    <a href="/Auth/Login"
       class="block w-full py-3 rounded-xl border border-white/15 text-center text-white/70 hover:text-white hover:border-white/30 hover:bg-white/5 text-sm font-bold transition-all">
        Đã có tài khoản? <span class="text-cyan-400">Đăng nhập</span>
    </a>
</div>
