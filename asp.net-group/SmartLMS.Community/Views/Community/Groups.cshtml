@model IEnumerable<SmartLMS.Models.StudyGroup>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Nhóm tự học chung";
}

<!-- Thêm Alpine.js cho các hiệu ứng tương tác Form Tạo Nhóm -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ isCreatingGroup: false }">
    <!-- Category header action banner -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wider">
            <img src="/images/icons/course_completed.svg" class="w-4 h-4 text-cyan-500" />
            <span>Danh sách phòng tự học và nhóm học</span>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button 
                @@click="isCreatingGroup = !isCreatingGroup"
                class="flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95"
            >
                <i data-lucide="plus" class="w-4 h-4"></i>
                Tạo nhóm học mới
            </button>
        }
        else
        {
            <a href="/Auth/Login?returnUrl=/hub/groups"
               class="flex items-center gap-1.5 bg-slate-100 hover:bg-cyan-50 text-slate-600 hover:text-cyan-700 text-sm font-bold px-4 py-2 rounded-xl transition-all border border-slate-200">
                <img src="/images/icons/course_locked.svg" class="w-4 h-4" />
                Đăng nhập để tạo nhóm
            </a>
        }
    </div>

    <!-- Creation form slide -->
    <div 
        x-show="isCreatingGroup" 
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="overflow-hidden" style="display: none;"
    >
        <form class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm">Tạo nhóm học viên mới</h3>
                <button type="button" @@click="isCreatingGroup = false" class="text-xs text-slate-400 hover:text-slate-600 font-bold">
                    Hủy bỏ
                </button>
            </div>

            <div class="space-y-3">
                <input type="text" id="group-name" required placeholder="Tên nhóm học tập (Đọc sách lập trình, Ôn giải thuật...)" class="w-full bg-slate-50 border-none rounded-xl px-4 py-3 text-slate-800 font-medium placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 transition-all text-sm" />

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Chọn chủ đề</label>
                        <select id="group-subject" class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value=".NET Development">.NET Development</option>
                            <option value="Algorithms">Algorithms</option>
                            <option value="Database Systems">Database Systems</option>
                            <option value="Design">Design</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Thành viên tối đa</label>
                        <input type="number" id="group-maxmembers" required min="5" max="200" value="50" class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500" />
                    </div>
                </div>

                <textarea id="group-description" required placeholder="Mô tả mục tiêu của nhóm, lịch trình thảo luận chung, kỳ vọng..." rows="3" class="w-full bg-slate-50 border-none rounded-xl p-4 text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all text-sm"></textarea>
            </div>

            <div class="flex justify-end pt-1">
                <button type="button" @@click="submitGroupRequest($data)" class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-sm px-6 py-2 rounded-xl transition-all shadow-md active:scale-95">
                    Xác nhận Tạo Nhóm
                </button>
            </div>
        </form>
    </div>

    <!-- Grid of Study Groups -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        @if (Model != null && Model.Any())
        {
            foreach (var grp in Model)
            {
                // Fake Joined state for UI demo purposes based on user ID logic or just default false
                bool joinedByUser = false; 
                int maxMembers = 50;
                
                <div class="bg-white rounded-3xl border border-slate-100 p-6 flex flex-col justify-between hover:shadow-md transition-all space-y-4" x-data="{ joined: @(joinedByUser.ToString().ToLower()) }">
                    <!-- Header block details -->
                    <div class="cursor-pointer group space-y-2">
                        <div class="flex justify-between items-start gap-2">
                            <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-md uppercase">
                                @grp.Subject
                            </span>
                            
                            <span class="text-[10.5px] font-semibold text-slate-450 flex items-center gap-1 shrink-0">
                                <img src="/images/icons/admin_users_manage.svg" class="w-3 h-3 text-cyan-500" />
                                <strong>@(grp.Members?.Count ?? 1)</strong>/<strong>@maxMembers</strong> thành viên
                            </span>
                        </div>

                        <a href="/hub/groups/@grp.Id" class="font-bold text-slate-800 text-base mt-2 mb-1 leading-snug group-hover:text-cyan-600 transition-colors flex items-center gap-1 w-max">
                            @grp.Name
                            <span class="text-[9px] text-cyan-500 font-bold opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                                (Vào phòng &rarr;)
                            </span>
                        </a>
                        <p class="text-slate-500 text-xs leading-relaxed line-clamp-3">
                            @grp.Description
                        </p>
                    </div>

                    <!-- Extra info (EXP/Progress) from original C# Model -->
                    <div class="bg-slate-50 border border-slate-100 p-3 rounded-2xl flex items-center gap-3 text-xs text-slate-600">
                        <img src="/images/icons/streak_fire.svg" class="w-4 h-4 text-orange-500 shrink-0" />
                        <div class="flex-1">
                            <div class="flex justify-between items-center mb-1">
                                <span class="font-bold text-slate-700 text-[10px] uppercase">EXP: @grp.EXP</span>
                                <span class="text-[10px] font-bold text-cyan-600">Tiến độ @grp.ProgressPercentage%</span>
                            </div>
                            <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-gradient-to-r from-cyan-400 to-blue-500 h-full rounded-full" style="width: @grp.ProgressPercentage%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Creator details and Join CTA button -->
                    <div class="pt-3 border-t border-slate-50 flex items-center justify-between text-xs font-bold">
                        <span class="text-[10.5px] font-bold text-slate-400 flex items-center gap-1">
                            <div class="w-5 h-5 rounded-full overflow-hidden bg-slate-200">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@grp.LeaderId" alt="Leader" />
                            </div>
                            Phòng của: <strong class="text-slate-600 font-bold">@(grp.Leader?.FullName ?? "Member")</strong>
                        </span>

                        <button 
                            @@click="joinGroup(@grp.Id, $data)"
                            :class="joined ? 'bg-cyan-50 text-cyan-600 border border-cyan-100 hover:bg-cyan-100 flex items-center gap-1' : 'bg-cyan-600 hover:bg-cyan-700 text-white hover:shadow border border-transparent'"
                            class="text-xs font-bold px-4 py-2 rounded-xl transition-all shadow-sm"
                        >
                            <span x-show="joined" style="display: none;" class="flex items-center gap-1">
                                <img src="/images/icons/course_completed.svg" class="w-3.5 h-3.5" />
                                Đã gia nhập
                            </span>
                            <span x-show="!joined">Xin vào nhóm</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-1 md:col-span-2 bg-white border border-slate-100 rounded-2xl p-12 text-center text-slate-400 space-y-2">
                <img src="/images/icons/admin_users_manage.svg" class="mx-auto text-slate-300 w-8 h-8" />
                <p class="font-bold">Không tìm thấy nhóm học nào phù hợp.</p>
                <p class="text-xs">Hãy sửa đổi nội dung tìm kiếm hoặc tự tạo một phòng mới!</p>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) { lucide.createIcons(); }
            }, 50);
        });
    });

    async function joinGroup(groupId, componentData) {
        if (componentData.joined) return; // Đã join rồi

        try {
            const res = await fetch(`/api/GroupApi/join/${groupId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            if (res.ok) {
                const data = await res.json();
                window.showToast && window.showToast('✅ ' + data.message);
                componentData.joined = true;
            } else if (res.status === 401) {
                window.location.href = '/Auth/Login?returnUrl=/hub/groups';
            } else {
                const err = await res.json();
                window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi tham gia nhóm.'));
            }
        } catch {
            window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
        }
    }

    async function submitGroupRequest(componentData) {
        const name        = document.getElementById('group-name')?.value?.trim();
        const subject     = document.getElementById('group-subject')?.value?.trim();
        const maxMembers  = parseInt(document.getElementById('group-maxmembers')?.value) || 50;
        const description = document.getElementById('group-description')?.value?.trim();

        if (!name || !description) {
            window.showToast && window.showToast('⚠️ Vui lòng nhập tên nhóm và mô tả!');
            return;
        }

        try {
            const res = await fetch('/api/GroupApi/create', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ name, subject, maxMembers, description }),
            });

            if (res.ok) {
                window.showToast && window.showToast('✅ Yêu cầu tạo nhóm đã được gửi tới Admin!');
                componentData.isCreatingGroup = false;
                // Optional: reload page to see pending groups if they are visible
            } else if (res.status === 401) {
                window.location.href = '/Auth/Login?returnUrl=/hub/groups';
            } else {
                const err = await res.json();
                window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi tạo nhóm'));
            }
        } catch {
            window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
        }
    }
</script>
