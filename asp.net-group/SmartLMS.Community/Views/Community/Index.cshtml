<!-- =========================================================================
     ⚙️ SCRIPT ĐIỀU HƯỚNG TRẠNG THÁI TOÀN BỘ CHỨC NĂNG DƯỚI CLIENT
     ========================================================================= -->
<script>
    // 1. Trạng thái chia sẻ 3 bước
    let selectedSharePostId = '';
    let selectedShareTitle = '';
    let selectedShareTag = '';
    let selectedShareCategory = '';
    let chosenFormat = 'link'; // 'link' | 'markdown' | 'classroom'

    // Flashcard C# Memory Data
    const deck = [
        { front: "Memory Struct vs Class hoạt động ra sao?", back: "Struct (Value type) lưu trực tiếp trên Stack, dọn ngay khi hết scope. Class (Reference type) lưu trên Heap, cần dọn dẹp bởi Garbage Collector." },
        { front: "Hàm .AsNoTracking() hữu ích thế nào?", back: "Bỏ cơ chế kiểm tra trạng thái Change Tracker của Entity Framework Core đối với truy vấn chỉ đọc, giúp tiết kiệm RAM và xử lý SQL nhanh hơn." },
        { front: "Captive Dependency là lỗi gì trong DI?", back: "Lỗi phát sinh khi inject một dịch vụ Scoped (vòng đời ngắn hạn mỗi request) vào một dịch vụ Singleton (vòng đời trọn vẹn của ứng dụng)." }
    ];
    let curCardIdx = 0;
    let cardFlipped = false;

    // Khởi chạy Lucide Icons
    document.addEventListener("DOMContentLoaded", function() {
        lucide.createIcons();
    });

    // ==========================================
    // 🚀 KHU VỰC ĐIỀU CHỈNH 10 BỘ CÔNG CỤ (TOOLKIT)
    // ==========================================
    function selectToolkitModule(modName) {
        document.getElementById("toolkit-grid").classList.add("hidden");
        document.getElementById("btn-back-to-grid").classList.remove("hidden");
        document.getElementById("toolkit-details").classList.remove("hidden");

        // Ẩn tất cả phân hệ
        document.getElementById("mod-ai-draft").classList.add("hidden");
        document.getElementById("mod-cs-sandbox").classList.add("hidden");
        document.getElementById("mod-meme-gen").classList.add("hidden");
        document.getElementById("mod-flashcard").classList.add("hidden");
        document.getElementById("mod-summarizer").classList.add("hidden");
        document.getElementById("mod-others").classList.add("hidden");

        if (modName === 'ai-draft') {
            document.getElementById("mod-ai-draft").classList.remove("hidden");
        } else if (modName === 'cs-sandbox') {
            document.getElementById("mod-cs-sandbox").classList.remove("hidden");
        } else if (modName === 'meme-gen') {
            document.getElementById("mod-meme-gen").classList.remove("hidden");
        } else if (modName === 'flashcard') {
            cardFlipped = false;
            curCardIdx = 0;
            updateFlashcardUI();
            document.getElementById("mod-flashcard").classList.remove("hidden");
        } else if (modName === 'summarizer') {
            document.getElementById("mod-summarizer").classList.remove("hidden");
        } else {
            // Các module 6, 7, 8, 9, 10
            document.getElementById("mod-others").classList.remove("hidden");
            const titleEl = document.getElementById("other-mod-title");
            const descEl = document.getElementById("other-mod-desc");
            
            if (modName === 'error-map') {
                titleEl.innerText = "6. Bản đồ C# Bug - Khảo sát Lộ trình";
                descEl.innerText = "Tra soát mã stacktrace lỗi xem thuộc chuyên đề Giáo án nào (.NET Core, Garbage Collector, Memory Allocation).";
            } else if (modName === 'bounty-maker') {
                titleEl.innerText = "7. Bài viết Treo thưởng XP";
                descEl.innerText = "Gia tăng XP cá nhân làm phần quà thưởng nóng cho thành viên tháo gỡ thành công Bug hệ thống.";
            } else if (modName === 'auditor') {
                titleEl.innerText = "8. Thẩm định chất lượng mẫu";
                descEl.innerText = "Kiểm tra ngữ pháp, thụt lề đầu dòng và code block để gia tăng độ tin chọn của chủ đề.";
            } else if (modName === 'recruiter') {
                titleEl.innerText = "9. Tuyển đồng đội học thớt";
                descEl.innerText = "Xây dựng định mẫu chiêu mộ học tập nhóm, thúc đẩy đóng góp bình luận của lớp học.";
            } else if (modName === 'poll-maker') {
                titleEl.innerText = "10. Thăm dò ý kiến Trưng cầu";
                descEl.innerText = "Dựng bảng bình chọn khảo sát xem đâu là thư viện RabbitMQ hay MassTransit được tin dùng nhất.";
            }
        }
        lucide.createIcons();
    }

    function showToolkitGrid() {
        document.getElementById("toolkit-grid").classList.remove("hidden");
        document.getElementById("btn-back-to-grid").classList.add("hidden");
        document.getElementById("toolkit-details").classList.add("hidden");
    }

    // Module I: AI Draft Assistant Simulator
    function simulateAiDraft() {
        const btn = document.getElementById("btn-ai-draft");
        const prompt = document.getElementById("ai-draft-prompt").value;
        const resBox = document.getElementById("ai-draft-res");
        
        btn.innerText = "Đang soạn...";
        setTimeout(() => {
            btn.innerText = "Gợi ý ⚡";
            resBox.classList.remove("hidden");
            document.getElementById("ai-draft-title").innerText = "Cách dọn dẹp Stream hiệu lực bằng IDisposable trong C#";
            document.getElementById("ai-draft-body").innerText = `/// <summary>
/// Giải phóng tài nguyên unmanaged an toàn đúng chuẩn .NET 8
/// </summary>
public class FileProcessor : IDisposable {
    private FileStream _fs;
    public void Dispose() {
        _fs?.Dispose();
        GC.SuppressFinalize(this); // Tiết kiệm công việc dọn dẹp cho GC
    }
}`;
        }, 800);
    }

    // Module II: C# Sandbox Simulation
    function loadErrorInSandbox() {
        document.getElementById("cs-code-area").value = `using System;
using System.Linq;
class Program {
    static void Main() {
        // Lỗi: Gọi .ToList() nạp toàn bộ vào RAM trước khi lọc điều kiện .Where()
        var list = db.ToList().Where(x => x.Active == true).ToList();
    }
}`;
    }

    function simulateCompileSandbox() {
        const res = document.getElementById("cs-compiler-res");
        res.classList.remove("hidden");
        const code = document.getElementById("cs-code-area").value;
        
        if (code.includes("ToList().Where")) {
            res.innerHTML = "<span class='text-rose-500'>⚠️ CẢNH BÁO PHIÊN BẢN HIỆU NĂNG:</span><br/>Bản code phát sinh lãng phí RAM nghiêm trọng. Gọi .ToList() tải thô toàn bộ bảng rồi mới lọc .Where().<br/>👉 <strong>Khuyên dùng:</strong> Hãy đảo Where() lên trước .ToList()!";
        } else {
            res.innerHTML = "<span class='text-emerald-400'>✅ KHẢO SÁT HIỆU NĂNG HOÀN HẢO:</span><br/>Compilation successful.<br/>Heap Allocation occupancy: ~32 bytes (Tối ưu tuyệt vời trên GC Gen 0).";
        }
    }

    // Module III: Copy Meme Motivation
    function copyMemeQuote() {
        navigator.clipboard.writeText("Mẹo C#: Khi dùng Struct thay vì Class cho dữ liệu nhỏ dưới 16 bytes để bảo toàn Generation 0 của Garbage Collector!");
        alert("Đã sao chép danh ngôn học thuật!");
    }

    // Module IV: Active Recall Flashcard Recall
    function flipFlashcard() {
        cardFlipped = !cardFlipped;
        updateFlashcardUI();
    }

    function updateFlashcardUI() {
        const body = document.getElementById("flashcard-body");
        const text = document.getElementById("flashcard-text");
        
        if (cardFlipped) {
            body.classList.remove("bg-slate-900");
            body.classList.add("bg-emerald-950", "border-emerald-600");
            text.innerText = deck[curCardIdx].back;
        } else {
            body.classList.remove("bg-emerald-950", "border-emerald-600");
            body.classList.add("bg-slate-900");
            text.innerText = deck[curCardIdx].front;
        }
    }

    // Module V: Summary
    function sumbitThreadSummarize() {
        const btn = document.getElementById("btn-sum");
        btn.innerText = "Đang chạy...";
        setTimeout(() => {
            btn.innerText = "Tóm tắt thần tốc ⚡";
            const box = document.getElementById("summarizer-res");
            box.classList.remove("hidden");
            box.innerText = "📌 Tóm tắt hội thảo: Tránh dùng ToList() quá sớm trong truy vấn EF Core để ngăn cản việc kéo quá tải RAM về bộ nhớ đệm client.";
        }, 600);
    }

    function handleOtherModSimulate() {
        alert("Đã khởi động tiến trình giả lập phân hệ học thuật thành công!");
    }


    // ==========================================
    // CHIA SẺ QUA REAL-TIME CHAT (PHASE 7)
    // ==========================================
    function shareViaMessage() {
        closeShareModal();
        if(window.sendPostToChat) {
            window.sendPostToChat(selectedSharePostId, selectedShareTitle, selectedShareCategory || 'Thảo Luận');
        } else {
            window.showToast && window.showToast('❌ Tính năng Chat đang tải, vui lòng thử lại sau.');
        }
    }

    // ==========================================
    // MODULE TOOLKIT LOGIC
    // ==========================================
    // ==========================================
    // 🌟 KHU VỰC THIẾT KẾ CHIA SẺ 3 BƯỚC TUẦN TỰ
    // ==========================================
    function openShareModal(postId, title, tag, category) {
        selectedSharePostId = postId;
        selectedShareTitle = title;
        selectedShareTag = tag;
        selectedShareCategory = category;

        // Reset lời tựa mặc định
        document.getElementById("share-custom-note").value = `Mình thấy chủ đề "${title}" này vô cùng bổ ích cho các bạn đang tự học .NET, cùng mổ xẻ nhé!`;

        // Bật hiển thị modal
        document.getElementById("share-modal").classList.remove("hidden");
        goToShareStep(1);
    }

    function closeShareModal() {
        document.getElementById("share-modal").classList.add("hidden");
    }

    function selectShareFormat(fmt) {
        chosenFormat = fmt;
        
        // Cập nhật giao diện lựa chọn
        document.getElementById("share-opt-link").className = "p-3 border-2 rounded-xl cursor-pointer flex gap-3.5 items-center " + (fmt === 'link' ? "bg-cyan-50/10 border-cyan-500" : "bg-white border-slate-150");
        document.getElementById("share-opt-markdown").className = "p-3 border-2 rounded-xl cursor-pointer flex gap-3.5 items-center hover:bg-slate-50 " + (fmt === 'markdown' ? "bg-indigo-50/10 border-indigo-500" : "bg-white border-slate-150");
        document.getElementById("share-opt-classroom").className = "p-3 border-2 rounded-xl cursor-pointer flex gap-3.5 items-center hover:bg-slate-50 " + (fmt === 'classroom' ? "bg-pink-50/10 border-pink-500" : "bg-white border-slate-150");
    }

    function goToShareStep(step) {
        // Ẩn các bước
        document.getElementById("share-view-step1").classList.add("hidden");
        document.getElementById("share-view-step2").classList.add("hidden");
        document.getElementById("share-view-step3").classList.add("hidden");

        // Cập nhật Step Indicators
        const s1 = document.getElementById("step-1-indicator");
        const s2 = document.getElementById("step-2-indicator");
        const s3 = document.getElementById("step-3-indicator");
        const line12 = document.getElementById("line-1-2");
        const line23 = document.getElementById("line-2-3");

        s1.className = "w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-black " + (step >= 1 ? "bg-cyan-600 text-white" : "bg-slate-200 text-slate-500");
        s2.className = "w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-black " + (step >= 2 ? "bg-cyan-600 text-white" : "bg-slate-200 text-slate-500");
        s3.className = "w-6 h-6 rounded-md flex items-center justify-center text-[10px] font-black " + (step >= 3 ? "bg-emerald-500 text-white" : "bg-slate-200 text-slate-500");

        line12.className = "flex-1 h-0.5 mx-3 " + (step >= 2 ? "bg-cyan-600" : "bg-slate-200");
        line23.className = "flex-1 h-0.5 mx-3 " + (step >= 3 ? "bg-cyan-600" : "bg-slate-200");

        if (step === 1) {
            document.getElementById("share-view-step1").classList.remove("hidden");
        } 
        else if (step === 2) {
            document.getElementById("share-view-step2").classList.remove("hidden");
            
            // Đổ dữ liệu Preview
            document.getElementById("preview-title").innerText = selectedShareTitle;
            const previewSnippet = document.getElementById("preview-snippet");
            const note = document.getElementById("share-custom-note").value;

            if (chosenFormat === 'link') {
                previewSnippet.innerHTML = `🌐 URL: https://smartlms.edu/forum/posts/${selectedSharePostId}?ref=user`;
            } else if (chosenFormat === 'markdown') {
                previewSnippet.innerHTML = `<code>### [C# Thảo Luận] ${selectedShareTitle}<br/>> Lời tựa: ${note}</code>`;
            } else {
                previewSnippet.innerHTML = `📢 Tin báo: Đẩy thông điệp lên nhóm lớp tự động...`;
            }
        } 
        else if (step === 3) {
            document.getElementById("share-view-step3").classList.remove("hidden");
            
            // Sinh mã sao chép cuối cùng
            const finalNote = document.getElementById("share-custom-note").value;
            const finalArea = document.getElementById("final-copy-area");

            if (chosenFormat === 'link') {
                finalArea.value = `📍 [HỌC C# NÂNG CAO] Mời đồng học trao đổi: "${selectedShareTitle}"\n👉 Đường link tham gia ngay: https://smartlms.edu/forum/posts/${selectedSharePostId}\n📝 Tin nhắn từ bạn: ${finalNote}`;
            } else if (chosenFormat === 'markdown') {
                finalArea.value = `### [Thảo Luận] ${selectedShareTitle}\n\n💬 Lời tựa: *${finalNote}*\n\n[Nhấn để truy cập SmartLMS Hub](https://smartlms.edu/forum/posts/${selectedSharePostId})`;
            } else {
                finalArea.value = `📢 [CLASSROOM NOTICE] Bài chia sẻ giáo trình đôn đốc đã đẩy thành công lên nhóm lớp!`;
            }
        }
        lucide.createIcons();
    }

    function copyFinalShareText() {
        const copyText = document.getElementById("final-copy-area");
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyText.value);
        alert("Đã sao chép tri thức thành công vào bộ nhớ tạm!");
    }

    // ==========================================
    // 🌟 KHU VỰC INLINE COMMENT & UPVOTE (GIAI ĐOẠN 4)
    // ==========================================
    async function upvotePostFeed(postId, btn) {
        const res = await fetch(`/hub/post/${postId}/upvote`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            document.getElementById(`feedVoteCount_${postId}`).innerText = data.newVoteCount;
            btn.classList.add('text-rose-600');
            btn.classList.remove('text-slate-500');
        }
    }

    function toggleCommentPanel(postId) {
        const panel = document.getElementById(`inlineComment_${postId}`);
        panel.classList.toggle('hidden');
    }

    async function submitInlineComment(e, postId) {
        e.preventDefault();
        const contentArea = document.getElementById(`inlineContent_${postId}`);
        const content = contentArea.value;
        if (!content.trim()) return;

        const btn = document.getElementById(`btnInlineSubmit_${postId}`);
        btn.disabled = true;
        btn.innerText = 'Đang gửi...';

        const formData = new FormData();
        formData.append('content', content);

        try {
            const res = await fetch(`/hub/post/${postId}/comment`, {
                method: 'POST',
                body: formData
            });
            
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    const c = data.comment;
                    const html = `
                        <div class="flex gap-3 animate-fade-in bg-slate-50 p-3 rounded-xl border border-slate-100">
                            <a href="/profile/${c.authorId}">
                                <img src="${c.authorAvatar}" class="w-6 h-6 rounded-full border border-slate-200" />
                            </a>
                            <div class="flex-1">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-xs font-black text-slate-800">${c.authorName}</span>
                                    <span class="text-[9px] text-slate-400">${c.createdAt}</span>
                                </div>
                                <div class="text-[11px] text-slate-600">${c.content}</div>
                            </div>
                        </div>
                    `;
                    document.getElementById(`inlineCommentsList_${postId}`).insertAdjacentHTML('beforeend', html);
                    contentArea.value = '';
                    
                    // Update comment count UI
                    const countSpan = document.getElementById(`feedCommentCount_${postId}`);
                    const currentCount = parseInt(countSpan.innerText) || 0;
                    countSpan.innerText = `${currentCount + 1} bình luận`;
                }
            } else {
                alert('Có lỗi xảy ra khi bình luận.');
            }
        } finally {
            btn.disabled = false;
            btn.innerText = 'Gửi nhanh';
        }
    }
</script>
