@model IEnumerable<SmartLMS.Models.Post>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Forum Feed";
}

<div class="space-y-6">
    <!-- Create Post Bar -->
    <div class="glass-card rounded-2xl p-6 shadow-sm">
        <div class="flex gap-4">
            <div class="w-12 h-12 rounded-full bg-slate-200 overflow-hidden shrink-0">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Me" alt="My Profile">
            </div>
            <div class="flex-1">
                <textarea placeholder="Share your knowledge or ask for help..." class="w-full bg-slate-50 border-none rounded-2xl p-4 text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all" rows="2"></textarea>
                <div class="flex justify-between items-center mt-4">
                    <div class="flex gap-2">
                        <button class="p-2 text-slate-500 hover:bg-cyan-50 hover:text-cyan-600 rounded-lg transition-all" title="Add Image">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </button>
                        <button class="p-2 text-slate-500 hover:bg-blue-50 hover:text-blue-600 rounded-lg transition-all" title="Add Video">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        </button>
                        <button class="p-2 text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 rounded-lg transition-all" title="Attach File">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                        </button>
                    </div>
                    <button class="bg-cyan-600 hover:bg-cyan-700 text-white px-8 py-2 rounded-xl font-bold shadow-lg transition-all">Post to Hub</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Feed -->
    <div class="space-y-6">
        @foreach (var post in Model)
        {
            <div class="glass-card rounded-2xl p-6 hover:shadow-lg transition-all">
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-200 overflow-hidden">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@post.AuthorId" alt="Author">
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-slate-800">@(post.Author?.FullName ?? "Unknown")</span>
                                <span class="bg-slate-100 text-[10px] font-bold text-slate-500 px-2 py-0.5 rounded-full uppercase tracking-tighter">Student</span>
                            </div>
                            <p class="text-xs text-slate-400">@post.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt")</p>
                        </div>
                    </div>
                    <button class="text-slate-400 hover:text-slate-600"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"></path></svg></button>
                </div>

                <h3 class="text-xl font-bold text-slate-800 mb-3">@post.Title</h3>
                <p class="text-slate-600 leading-relaxed mb-4">@post.Content</p>

                <!-- Multimedia Placeholder (If any) -->
                @if(post.Id % 3 == 0) {
                    <div class="w-full h-64 bg-slate-100 rounded-2xl mb-4 overflow-hidden border border-slate-200">
                        <img src="https://source.unsplash.com/random/800x600?technology,coding&sig=@post.Id" class="w-full h-full object-cover" alt="Post media">
                    </div>
                }

                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                    <div class="flex items-center gap-6">
                        <button class="flex items-center gap-2 text-slate-500 hover:text-cyan-600 font-bold transition-all group">
                            <div class="p-2 group-hover:bg-cyan-50 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg></div>
                            <span class="text-sm">24</span>
                        </button>
                        <button class="flex items-center gap-2 text-slate-500 hover:text-blue-600 font-bold transition-all group">
                            <div class="p-2 group-hover:bg-blue-50 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg></div>
                            <span class="text-sm">@post.Comments.Count</span>
                        </button>
                        <button class="flex items-center gap-2 text-slate-500 hover:text-indigo-600 font-bold transition-all group">
                            <div class="p-2 group-hover:bg-indigo-50 rounded-lg"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg></div>
                            <span class="text-sm">Repost</span>
                        </button>
                    </div>
                    <button class="p-2 text-slate-400 hover:text-slate-600"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg></button>
                </div>
            </div>
        }
    </div>
</div>
