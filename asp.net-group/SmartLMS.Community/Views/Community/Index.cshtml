@using System.Collections.Generic
@model SmartLms.Community.ViewModels.ForumFeedViewModel
@using System.Text.Encodings.Web

@*
    =========================================================================
    🌟 FILE ĐÓNG GÓI DIỄN ĐÀN THẢO LUẬN & HỘP CÔNG CỤ THÔNG MINH (FORUM FEED + WORKSPACE TOOLKIT)
    =========================================================================
    - Ngôn ngữ: ASP.NET Core Razor Pages / CSHTML Views (.NET 8+)
    - Styling: Tailwind CSS (Sử dụng trực tiếp các class CSS tương thích với React)
    - Thư viện Icons: Lucide Icons CDN (thay thế cho lucide-react)
    - Interactivity: JavaScript thuần (Vanilla JS) hoặc JQuery để duy trì tối đa tốc độ chuyển đổi.
    - Cấu trúc: Đóng gói tất cả Logic trạng thái (States) thành các biến JS giúp dán trực tiếp vào Razor MVC
*@

@{
    ViewData["Title"] = "Diễn Đàn Thảo Luận Kỹ Thuật C# - SmartLMS";
    Layout = "_CommunityLayout";
}

<!-- IMPORT LUCIDE ICONS CDN & TAILWIND CSS -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://unpkg.com/lucide@latest"></script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 text-left font-sans text-slate-900 bg-slate-50/50 min-h-screen">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- ==========================================
             CỘT CHÍNH (LEFT CONTROLS + POSTS LIST)
             ========================================== -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- CTA ĐĂNG BÀI CAO CẤP (NÂNG CẤP TỪ NÚT ĐƠN GIẢN) -->
            <div class="relative bg-gradient-to-r from-cyan-600 via-indigo-600 to-purple-700 rounded-2xl p-6 shadow-xl overflow-hidden flex flex-col sm:flex-row items-center justify-between gap-4 group">
                <!-- Background decoration -->
                <div class="absolute -top-12 -right-12 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
                <i data-lucide="sparkles" class="absolute bottom-4 left-1/3 w-8 h-8 text-white opacity-20 animate-pulse"></i>

                <div class="relative z-10 text-white">
                    <h1 class="text-lg sm:text-xl font-black tracking-tight flex items-center gap-2">
                        <i data-lucide="terminal-square" class="w-5 h-5"></i>
                        DIỄN ĐÀN HỌC THUẬT C#
                    </h1>
                    <p class="text-xs font-semibold text-cyan-50 mt-1 opacity-90 max-w-sm">Gặp lỗi NullReference? Bế tắc thuật toán? Đăng câu hỏi ngay để trải nghiệm trình soạn thảo Code Auditor tối ưu AI.</p>
                </div>

                <a href="/hub/post/new" class="relative z-10 shrink-0 bg-white hover:bg-cyan-50 text-indigo-700 text-xs font-black px-6 py-3 rounded-xl transition-all shadow-lg hover:shadow-cyan-500/50 flex items-center gap-2 cursor-pointer border-none hover:scale-105 active:scale-95 no-underline">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                    Biên soạn bài viết cao cấp
                </a>
            </div>

            <!-- DANH SÁCH BÀI ĐĂNG (RAZOR LOOP) -->
            <div class="space-y-4" id="posts-container">
                @if (Model.Posts != null && Model.Posts.Any())
                {
                    @foreach (var post in Model.Posts)
                    {
                        <div class="bg-white border border-slate-150 rounded-2xl p-5 shadow-xs transition-transform hover:translate-y-[-1px] space-y-4" id="post-@post.Id">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <img src="@post.AuthorAvatar" alt="@post.AuthorName" class="w-8 h-8 rounded-full border border-slate-200" />
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-xs font-black text-slate-800">@post.AuthorName</span>
                                            <span class="text-[9px] bg-slate-100/80 text-slate-450 font-extrabold px-1.5 py-0.5 rounded">@post.AuthorRole</span>
                                        </div>
                                        <span class="text-[9.5px] text-slate-400 font-mono">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                                <span class="text-[10px] font-black bg-cyan-100 text-cyan-700 px-2.5 py-0.5 rounded-md uppercase tracking-wide">
                                    #@post.Tag
                                </span>
                            </div>

                            <div class="space-y-1">
                                <a href="/hub/post/@post.Id" class="block text-sm font-black text-slate-850 hover:text-indigo-650 transition-colors cursor-pointer no-underline">@post.Title</a>
                                <p class="text-xs text-slate-600 leading-relaxed whitespace-pre-line">@post.Content</p>
                            </div>

                            <!-- PHẦN TƯƠNG TÁC: LIKE, COMMENT, CHIA SẺ -->
                            <div class="flex items-center gap-4 pt-3 border-t border-slate-100">
                                <button type="button" onclick="upvotePostFeed(@post.Id, this)" class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-rose-600 transition-all bg-transparent border-none cursor-pointer">
                                    <i data-lucide="heart" class="w-4 h-4"></i>
                                    <span id="feedVoteCount_@post.Id">@post.Likes</span>
                                </button>
                                <button type="button" onclick="toggleCommentPanel(@post.Id)" class="flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-cyan-600 transition-all bg-transparent border-none cursor-pointer">
                                    <i data-lucide="message-square" class="w-4 h-4"></i>
                                    <span id="feedCommentCount_@post.Id">@post.CommentsCount bình luận</span>
                                </button>
                                
                                <!-- NÚT CHIA SẺ LÍ TƯỞNG (Kích hoạt 3-Step Sharing) -->
                                <button type="button" onclick="openShareModal('@post.Id', '@JavaScriptEncoder.Default.Encode(post.Title)', '@JavaScriptEncoder.Default.Encode(post.Tag)', '@JavaScriptEncoder.Default.Encode(post.Category)')" class="flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-indigo-600 transition-all bg-transparent border-none cursor-pointer ml-auto">
                                    <i data-lucide="share-2" class="w-4 h-4"></i>
                                    <span>Chia sẻ</span>
                                </button>
                            </div>

                            <!-- KHU VỰC INLINE COMMENT TẠO BỞI AI -->
                            <div id="inlineComment_@post.Id" class="hidden mt-4 pt-4 border-t border-slate-100">
                                <form onsubmit="submitInlineComment(event, @post.Id)" class="flex gap-3">
                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(User.Identity?.Name ?? "U")&background=random" class="w-8 h-8 rounded-full border border-slate-200" />
                                    <div class="flex-1">
                                        <textarea id="inlineContent_@post.Id" required rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-700 placeholder-slate-400 focus:bg-white focus:border-cyan-500/50 outline-none resize-none transition-all shadow-inner" placeholder="Viết bình luận nhanh..."></textarea>
                                        <div class="flex justify-end mt-2">
                                            <button type="submit" id="btnInlineSubmit_@post.Id" class="bg-cyan-600 hover:bg-cyan-700 text-white px-4 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer border-none flex items-center gap-2">
                                                <span>Gửi nhanh</span>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                                <div id="inlineCommentsList_@post.Id" class="space-y-3 mt-4">
                                    @if (post.Comments != null && post.Comments.Any())
                                    {
                                        foreach (var c in post.Comments)
                                        {
                                            <div class="flex gap-3 bg-slate-50 p-3 rounded-xl border border-slate-100">
                                                <a href="/profile/@c.AuthorId">
                                                    <img src="@c.AuthorAvatar" class="w-6 h-6 rounded-full border border-slate-200" alt="@c.AuthorName" />
                                                </a>
                                                <div class="flex-1">
                                                    <div class="flex items-center gap-2 mb-1">
                                                        <span class="text-xs font-black text-slate-800">@c.AuthorName</span>
                                                        <span class="text-[9px] text-slate-400">@c.CreatedAt</span>
                                                    </div>
                                                    <div class="text-[11px] text-slate-600 whitespace-pre-wrap">@c.Content</div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="bg-white border border-slate-150 rounded-2xl p-8 text-center text-slate-450 text-xs font-semibold">
                        Không tìm thấy bài đăng nào phù hợp để thảo luận.
                    </div>
                }
            </div>
        </div>

        <!-- =========================================================================
             CỘT PHẢI: HỘP CÔNG CỤ THẢO LUẬN THÔNG MINH (10 ADVANCED INTEGRATION MODULES)
             ========================================================================= -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-gradient-to-br from-slate-50 to-cyan-50/25 border border-cyan-150/80 rounded-2xl p-5 shadow-xs space-y-4">
                
                <!-- TIÊU ĐỀ HỘP CÔNG CỤ -->
                <div class="flex items-center justify-between pb-2 border-b border-cyan-100">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-cyan-600 flex items-center justify-center text-white shadow-md shadow-cyan-100/60">
                            <i data-lucide="sparkles" class="w-4 h-4 animate-pulse"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-black text-slate-800 uppercase tracking-wide">Hộp Công Cụ Thảo Luận</h3>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider">10 Phân hệ hỗ trợ tối ưu mã nguồn</p>
                        </div>
                    </div>
                    
                    <button id="btn-back-to-grid" onclick="showToolkitGrid()" class="hidden text-[10px] text-cyan-650 hover:text-cyan-800 font-black flex items-center gap-0.5 cursor-pointer bg-white px-2 py-1 rounded-md border border-slate-150 transition-all shadow-3xs">
                        ← Trở lại
                    </button>
                </div>

                <!-- KHU VỰC CHỌN 10 CÔNG CỤ (GRID SELECTOR) -->
                <div id="toolkit-grid" class="grid grid-cols-2 gap-2.5">
                    <!-- Module 1: AI Draft Assistant -->
                    <button onclick="selectToolkitModule('ai-draft')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-orange-50 text-orange-600 group-hover:bg-orange-100/40 transition-colors">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">1. Trợ lý AI Bút</span>
                        <span class="text-[8px] text-slate-400 leading-none">Soạn thảo ý kiến</span>
                    </button>

                    <!-- Module 2: C# Compiler Sandbox -->
                    <button onclick="selectToolkitModule('cs-sandbox')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-cyan-55 text-cyan-600 group-hover:bg-cyan-100/40 transition-colors">
                            <i data-lucide="terminal" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">2. Hộp cát C#</span>
                        <span class="text-[8px] text-slate-400 leading-none">Chấm hiệu suất RAM</span>
                    </button>

                    <!-- Module 3: Quote & Meme Motivation -->
                    <button onclick="selectToolkitModule('meme-gen')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-purple-55 text-purple-600 group-hover:bg-purple-100/40 transition-colors">
                            <i data-lucide="flame" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">3. Động lực & Meme</span>
                        <span class="text-[8px] text-slate-400 leading-none">Tăng lực đồng nhóm</span>
                    </button>

                    <!-- Module 4: Active Recall Flashcard -->
                    <button onclick="selectToolkitModule('flashcard')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-blue-55 text-blue-600 group-hover:bg-blue-100/40 transition-colors">
                            <i data-lucide="book-open" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">4. Flashcard C#</span>
                        <span class="text-[8px] text-slate-400 leading-none">Ôn tập gốc rễ</span>
                    </button>

                    <!-- Module 5: Thread Summarizer -->
                    <button onclick="selectToolkitModule('summarizer')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-emerald-55 text-emerald-600 group-hover:bg-emerald-100/40 transition-colors">
                            <i data-lucide="layers" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">5. Tóm tắt Đàm luận</span>
                        <span class="text-[8px] text-slate-400 leading-none">Nắm cốt thớt rườm</span>
                    </button>

                    <!-- Module 6: Error Map Level -->
                    <button onclick="selectToolkitModule('error-map')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-indigo-55 text-indigo-600 group-hover:bg-indigo-100/40 transition-colors">
                            <i data-lucide="compass" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">6. Bản đồ C# Bug</span>
                        <span class="text-[8px] text-slate-400 leading-none">Lộ trình dọn rác GC</span>
                    </button>

                    <!-- Module 7: Reward Bounty (Treo thưởng XP) -->
                    <button onclick="selectToolkitModule('bounty-maker')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-amber-55 text-amber-600 group-hover:bg-amber-100/40 transition-colors">
                            <i data-lucide="trophy" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">7. Bài viết Treo XP</span>
                        <span class="text-[8px] text-slate-400 leading-none">Dành điểm giải mã</span>
                    </button>

                    <!-- Module 8: Quality Content Checker -->
                    <button onclick="selectToolkitModule('auditor')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-rose-55 text-rose-600 group-hover:bg-rose-100/40 transition-colors">
                            <i data-lucide="award" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">8. Kiểm khảo chất</span>
                        <span class="text-[8px] text-slate-400 leading-none">Check chuẩn bài đăng</span>
                    </button>

                    <!-- Module 9: Team recruiter -->
                    <button onclick="selectToolkitModule('recruiter')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-teal-55 text-teal-600 group-hover:bg-teal-100/40 transition-colors">
                            <i data-lucide="users" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">9. Tuyển đồng lực</span>
                        <span class="text-[8px] text-slate-400 leading-none">Rủ tụ tập mổ bug</span>
                    </button>

                    <!-- Module 10: LMS Interactive Polls -->
                    <button onclick="selectToolkitModule('poll-maker')" class="p-3 bg-white hover:bg-cyan-50/20 border border-slate-150 rounded-xl transition-all hover:scale-[1.01] hover:shadow-2xs cursor-pointer flex flex-col items-center text-center space-y-1.5 group border-none">
                        <div class="p-2 rounded-lg bg-pink-55 text-pink-600 group-hover:bg-pink-100/40 transition-colors">
                            <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
                        </div>
                        <span class="text-[10px] font-black text-slate-850 leading-tight">10. Trưng trưng cầu</span>
                        <span class="text-[8px] text-slate-400 leading-none">Biểu quyết ý tập</span>
                    </button>
                </div>

                <!-- KHU VỰC CHI TIẾT CHO TỪNG PHÂN HỆ ĐƯỢC CHỌN -->
                <div id="toolkit-details" class="hidden">
                    
                    <!-- MODULE 1: AI DRAFT WORKSPACE -->
                    <div id="mod-ai-draft" class="hidden space-y-3 text-xs">
                        <div class="flex items-center gap-1">
                            <i data-lucide="sparkles" class="w-4 h-4 text-orange-500"></i>
                            <span class="font-black text-slate-800">Trợ Lý Soạn Thảo AI - Định dạng giáo trình</span>
                        </div>
                        <p class="text-[11px] text-slate-500 font-semibold">AI định dạng bài đăng chuẩn tắc chỉ bằng một từ khóa.</p>
                        <div class="flex gap-1.5">
                            <input type="text" id="ai-draft-prompt" value="hỏi cách dùng IDisposable giải phóng file stream" class="flex-1 bg-white border border-slate-150 px-2.5 py-2 rounded-lg outline-none text-xs font-semibold" />
                            <button onclick="simulateAiDraft()" id="btn-ai-draft" class="bg-cyan-600 hover:bg-cyan-700 text-white text-[10px] font-black px-3 py-2 rounded-lg cursor-pointer border-none">Gợi ý ⚡</button>
                        </div>
                        <div id="ai-draft-res" class="hidden p-3 bg-slate-100 border border-slate-200 rounded-lg space-y-2">
                            <strong id="ai-draft-title" class="font-black block text-slate-800 text-[10.5px]"></strong>
                            <p id="ai-draft-body" class="whitespace-pre-wrap text-[10px] bg-white p-2 border border-slate-150 rounded text-slate-600 max-h-36 overflow-y-auto leading-relaxed font-mono"></p>
                        </div>
                    </div>

                    <!-- MODULE 2: C# COMPILER SANDBOX -->
                    <div id="mod-cs-sandbox" class="hidden space-y-3 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="font-black text-slate-800">C# Compiler Sandbox - Phân tích GC</span>
                            <button onclick="loadErrorInSandbox()" class="text-[9px] bg-rose-50 hover:bg-rose-100 border border-rose-150 px-1.5 py-0.5 rounded text-rose-700 cursor-pointer">Nạp code ToList() lỗi</button>
                        </div>
                        <textarea id="cs-code-area" class="w-full bg-slate-900 text-cyan-300 font-mono text-[10px] p-2.5 rounded-lg border-none focus:outline-none resize-none" rows="5">using System;
class Program {
    static void Main() {
        int[] num = {1,2,3};
        Console.WriteLine("GC allocation gen: " + GC.GetGeneration(num));
    }
}</textarea>
                        <button onclick="simulateCompileSandbox()" class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-extrabold py-2 rounded-lg cursor-pointer border-none">Đo hiệu năng ô nhớ ⚡</button>
                        <div id="cs-compiler-res" class="hidden p-3 bg-slate-950 text-emerald-400 font-mono text-[9px] rounded-lg space-y-2 leading-relaxed whitespace-pre-wrap border border-slate-800"></div>
                    </div>

                    <!-- MODULE 3: INSPIRED MOTIVATION OR MEME -->
                    <div id="mod-meme-gen" class="hidden space-y-3 text-xs">
                        <div class="flex items-center gap-1">
                            <i data-lucide="flame" class="w-4 h-4 text-purple-500"></i>
                            <span class="font-black text-slate-800">Động lực & Giáo khoa tối ưu C#</span>
                        </div>
                        <div class="p-4 bg-orange-50/40 border border-amber-200 rounded-xl space-y-1 text-center font-sans">
                            <span class="text-[9px] bg-amber-100 text-amber-800 border-none font-black px-1.5 py-0.5 rounded">MEMORY OPTIMIZATION</span>
                            <p class="font-bold text-slate-700 leading-normal italic text-[11px] pt-1">"Khi dùng Struct thay vì Class cho dữ liệu nhỏ dưới 16 bytes để bảo toàn Generation 0 của Garbage Collector!"</p>
                        </div>
                        <button onclick="copyMemeQuote()" class="w-full bg-slate-900 hover:bg-slate-800 text-white font-black py-2 rounded-lg cursor-pointer border-none text-[10.5px]">Sao chép danh ngôn học thuật</button>
                    </div>

                    <!-- MODULE 4: ACTIVE RECALL FLASHCARD -->
                    <div id="mod-flashcard" class="hidden space-y-3 text-xs">
                        <span class="font-black text-slate-800 block">Flashcard Ôn tập Chủ động C#</span>
                        <div onclick="flipFlashcard()" id="flashcard-body" class="h-32 bg-slate-900 text-white border border-slate-800 rounded-xl p-4 flex flex-col justify-between text-center cursor-pointer select-none transition-all">
                            <span class="text-[8px] text-slate-400 tracking-wider">Hỏi căn bản</span>
                            <p id="flashcard-text" class="text-[11px] font-black">Memory Struct vs Class hoạt động ra sao?</p>
                            <span class="text-[9px] text-cyan-400 underline decoration-dashed">Xem câu trả lời →</span>
                        </div>
                    </div>

                    <!-- MODULE 5: THREAD REPORT SUMMARIZER -->
                    <div id="mod-summarizer" class="hidden space-y-3 text-xs">
                        <span class="font-black text-slate-800 block">Trình tóm tắt đàm thoại diễn đàn</span>
                        <p class="text-[10px] text-slate-450 leading-relaxed font-semibold">Tóm tắt các chuỗi phản hồi dài dòng thành một cốt lõi giải pháp.</p>
