@model IEnumerable<SmartLMS.Models.User>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Member Directory";
}

<div class="space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Member Directory</h2>
            <p class="text-slate-500">Connect with mentors, leaders, and fellow students.</p>
        </div>
    </div>

    <!-- Member Search & Filters -->
    <div class="glass-card rounded-2xl p-4 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="relative">
            <input type="text" placeholder="Search by name or skill..." class="w-full bg-white border border-slate-200 rounded-xl pl-10 pr-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <svg class="w-5 h-5 absolute left-3 top-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <select class="bg-white border border-slate-200 rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <option>All Roles</option>
            <option>Mentor</option>
            <option>Student</option>
            <option>Study Leader</option>
        </select>
        <select class="bg-white border border-slate-200 rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <option>All Skills</option>
            <option>Python</option>
            <option>ASP.NET Core</option>
            <option>UI/UX Design</option>
        </select>
    </div>

    <!-- Member Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var member in Model)
        {
            <div class="glass-card rounded-3xl p-6 text-center hover:shadow-xl transition-all group">
                <div class="relative inline-block mb-4">
                    <div class="w-24 h-24 rounded-full border-4 border-white shadow-lg overflow-hidden mx-auto bg-slate-100">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@member.UserId" alt="@member.FullName">
                    </div>
                    <div class="absolute bottom-0 right-0 w-6 h-6 bg-green-500 border-4 border-white rounded-full" title="Online"></div>
                </div>

                <h4 class="text-xl font-bold text-slate-800">@member.FullName</h4>
                <p class="text-xs font-bold text-cyan-600 uppercase tracking-widest mb-4">@member.Role</p>

                <!-- Skills -->
                <div class="flex flex-wrap justify-center gap-2 mb-6">
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-3 py-1 rounded-full">Python</span>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-3 py-1 rounded-full">ML</span>
                    <span class="bg-slate-100 text-slate-500 text-[10px] font-bold px-3 py-1 rounded-full">Docker</span>
                </div>

                <!-- Badges -->
                <div class="flex justify-center gap-3 mb-6">
                    <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center text-blue-500 border border-blue-100" title="Top Mentor">🏆</div>
                    <div class="w-8 h-8 bg-orange-50 rounded-lg flex items-center justify-center text-orange-500 border border-orange-100" title="Fast Learner">⚡</div>
                    <div class="w-8 h-8 bg-purple-50 rounded-lg flex items-center justify-center text-purple-500 border border-purple-100" title="Code Reviewer">🔍</div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <button class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2 rounded-xl text-sm transition-all shadow-md">View Profile</button>
                    <button class="bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 font-bold py-2 rounded-xl text-sm transition-all">Message</button>
                </div>
            </div>
        }
    </div>
</div>
