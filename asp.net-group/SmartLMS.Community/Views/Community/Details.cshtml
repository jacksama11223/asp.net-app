@model SmartLMS.Models.Post
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = Model.Title;
    var authorName = Model.Author?.FullName ?? "Ẩn danh";
    var avatarUrl = Model.Author?.KYCDocUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(authorName)}&background=random";
}

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="shareManager()">
    <!-- Bài viết chính -->
    <article class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8 space-y-6">
        <div class="flex justify-between items-center">
            <a href="/hub" class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-cyan-600 transition-colors">
                &larr; Trở về Bảng tin
            </a>
            
            <button @@click="openShare('POST', @Model.PostId)" class="inline-flex items-center gap-2 text-sm font-bold text-cyan-600 hover:text-cyan-700 transition-colors bg-cyan-50 px-3 py-1.5 rounded-lg shadow-sm active:scale-95">
                <i data-lucide="share-2" class="w-4 h-4"></i> Chia sẻ
            </button>
        </div>

        <div class="flex items-center gap-4 mb-2">
            <a href="/profile/@Model.AuthorId" title="Xem hồ sơ">
                <img src="@avatarUrl" alt="@authorName" class="w-12 h-12 rounded-full ring-2 ring-slate-100 object-cover cursor-pointer hover:ring-cyan-400 transition-all shadow-sm" />
            </a>
            <div>
                <a href="/profile/@Model.AuthorId" class="text-slate-800 font-black text-base hover:text-cyan-600 transition-colors">@authorName</a>
                <div class="text-slate-400 text-xs mt-0.5 flex items-center gap-2 font-semibold">
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <span>•</span>
                    <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider border border-slate-200">@Model.Category</span>
                </div>
            </div>
        </div>

        <h1 class="text-2xl lg:text-3xl font-black text-slate-800 leading-tight">@Model.Title</h1>

        <div class="prose max-w-none text-slate-700 leading-relaxed prose-pre:bg-slate-50 prose-pre:border prose-pre:border-slate-200 prose-pre:rounded-xl prose-code:text-cyan-700">
            @Html.Raw(Model.Content.Replace("\n", "<br/>"))
        </div>

        <div class="flex items-center justify-between pt-6 border-t border-slate-100">
            <div class="flex items-center gap-4">
                <button onclick="upvotePost(@Model.PostId, this)" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-50 text-slate-500 hover:bg-rose-50 hover:text-rose-600 transition-colors text-sm font-bold cursor-pointer border border-slate-100">
                    <i data-lucide="heart" class="w-4 h-4"></i>
                    <span id="voteCount_@Model.PostId">@Model.VoteCount</span>
                </button>
                <button class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-slate-500 hover:text-cyan-600 hover:bg-cyan-50 transition-colors text-sm font-bold border border-transparent">
                    <i data-lucide="message-square" class="w-4 h-4"></i>
                    @(Model.Comments?.Count ?? 0)
                </button>
            </div>
            
            <div class="flex items-center gap-2">
                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    foreach (var tag in Model.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="px-2.5 py-1 rounded-lg bg-slate-50 border border-slate-100 text-slate-500 text-xs font-bold shadow-sm">#@tag.Trim()</span>
                    }
                }
            </div>
        </div>
    </article>

    <!-- Khu vực Bình luận -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-8 space-y-6">
        <h3 class="text-lg font-black text-slate-800 border-b border-slate-100 pb-4">Bình luận (@(Model.Comments?.Count ?? 0))</h3>
        
        <!-- Form nhập bình luận (AJAX) -->
        <form id="commentForm" onsubmit="submitComment(event, @Model.PostId)" class="space-y-3 pt-2">
            <label class="text-sm font-bold text-slate-800">Viết bình luận của bạn</label>
            <div class="flex gap-4 items-start">
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(User.Identity?.Name ?? "U")&background=random" class="w-10 h-10 rounded-full ring-2 ring-slate-100 mt-1 shadow-sm" />
                <div class="flex-1 space-y-3">
                    <textarea id="commentContent" name="content" required rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700 placeholder-slate-400 focus:bg-white focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 outline-none resize-none transition-all" placeholder="Nhập nội dung thảo luận... (Bấm [[ để trích dẫn Bài viết/QA, @ cho Sự kiện, # cho Nhóm)"></textarea>
                    
                    <div class="flex justify-end">
                        <button type="submit" id="btnSubmitComment" class="bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-2.5 rounded-xl text-sm font-bold transition-all shadow-md active:scale-95 flex items-center gap-2 cursor-pointer border-none">
                            <span>Gửi bình luận</span>
                            <svg class="w-4 h-4 hidden animate-spin" id="commentSpinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <!-- Danh sách bình luận -->
        <div id="commentsList" class="space-y-6 pt-6 border-t border-slate-100">
            @if (Model.Comments != null && Model.Comments.Any())
            {
                foreach (var c in Model.Comments.Where(x => !x.IsDeleted).OrderBy(x => x.CreatedAt))
                {
                    var cAuthor = c.Author?.FullName ?? $"User {c.AuthorId}";
                    var cAvatar = c.Author?.KYCDocUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(cAuthor)}&background=random";
                    <div class="flex gap-4">
                        <a href="/profile/@c.AuthorId" title="Xem hồ sơ" class="shrink-0">
                            <img src="@cAvatar" alt="@cAuthor" class="w-10 h-10 rounded-full border border-slate-200 hover:border-cyan-500 hover:shadow-md transition-all cursor-pointer" />
                        </a>
                        <div class="flex-1">
                            <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 shadow-sm relative">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <a href="/profile/@c.AuthorId" class="text-slate-800 font-black text-sm hover:text-cyan-600 transition-colors">@cAuthor</a>
                                        <span class="text-slate-400 text-[10px] font-bold">@c.CreatedAt.ToString("dd/MM HH:mm")</span>
                                    </div>
                                </div>
                                <div class="text-slate-700 text-sm leading-relaxed whitespace-pre-wrap">
                                    @Html.Raw(c.Content)
                                </div>
                            </div>
                            <div class="flex items-center gap-4 mt-2 px-2">
                                <button class="text-slate-400 hover:text-rose-500 text-xs font-bold transition-colors flex items-center gap-1">
                                    <i data-lucide="heart" class="w-3.5 h-3.5"></i> Thích
                                </button>
                                <button class="text-slate-400 hover:text-cyan-600 text-xs font-bold transition-colors flex items-center gap-1">
                                    <i data-lucide="reply" class="w-3.5 h-3.5"></i> Phản hồi
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div id="noCommentMsg" class="text-center py-10 bg-slate-50 rounded-2xl border border-slate-100">
                    <i data-lucide="message-square-dashed" class="w-10 h-10 mx-auto text-slate-300 mb-3"></i>
                    <p class="text-slate-500 text-sm font-semibold">Chưa có bình luận nào. Hãy là người đầu tiên bóc tem!</p>
                </div>
            }
        </div>
    </div>
    
    <!-- Share Modal (Alpine JS) -->
    <div x-show="isOpen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm" style="display: none;" x-transition>
        <div @@click.away="isOpen = false" class="bg-white rounded-3xl w-full max-w-md p-8 space-y-5 shadow-2xl">
            <h3 class="text-xl font-black text-slate-800 flex items-center gap-2">
                <i data-lucide="share-2" class="w-5 h-5 text-cyan-600"></i> Chia sẻ nội dung
            </h3>
            
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gửi đến</label>
                <select x-model="targetType" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 text-sm font-bold text-slate-700">
                    <option value="Chat">Nhóm Chat Tổng (General Chat)</option>
                    <option value="Group">Một nhóm học (Group)</option>
                    <option value="User">Tin nhắn cá nhân (User)</option>
                </select>
            </div>
            
            <div class="space-y-3" x-show="targetType !== 'Chat'">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">ID Người nhận / Nhóm</label>
                <input type="number" x-model="targetId" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 text-sm font-bold text-slate-700" placeholder="Nhập ID...">
            </div>
            
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Lời nhắn (Tùy chọn)</label>
                <textarea x-model="message" rows="2" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 text-sm placeholder-slate-400 resize-none font-semibold text-slate-700" placeholder="Này, xem cái này đi..."></textarea>
            </div>
            
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                <button @@click="isOpen = false" class="px-5 py-2.5 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">Hủy</button>
                <button @@click="submitShare" :disabled="isSharing" class="px-5 py-2.5 bg-cyan-600 text-white rounded-xl hover:bg-cyan-700 disabled:bg-slate-400 transition-colors font-black shadow-md flex items-center gap-2">
                    <i data-lucide="send" class="w-4 h-4"></i> <span x-text="isSharing ? 'Đang gửi...' : 'Gửi đi'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if(window.lucide) { lucide.createIcons(); }
        });

        // Upvote Logic
        async function upvotePost(postId, btn) {
            try {
                const res = await fetch(`/hub/post/${postId}/upvote`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    document.getElementById(`voteCount_${postId}`).innerText = data.newVoteCount;
                    btn.classList.add('bg-rose-50', 'text-rose-600', 'border-rose-100');
                    btn.classList.remove('bg-slate-50', 'text-slate-500', 'border-slate-100');
                } else {
                    window.showToast && window.showToast('⚠️ ' + (data.message || 'Lỗi khi upvote.'));
                }
            } catch(e) {
                console.error(e);
            }
        }

        // Comment Submit Logic
        async function submitComment(e, postId) {
            e.preventDefault();
            const contentInput = document.getElementById('commentContent');
            const content = contentInput.value;
            if (!content.trim()) return;

            const btn = document.getElementById('btnSubmitComment');
            const spinner = document.getElementById('commentSpinner');
            btn.disabled = true;
            spinner.classList.remove('hidden');

            const formData = new FormData();
            formData.append('content', content);

            try {
                const res = await fetch(`/hub/post/${postId}/comment`, {
                    method: 'POST',
                    body: formData
                });
                
                if (res.ok) {
                    const data = await res.json();
                    if (data.success) {
                        const noComment = document.getElementById('noCommentMsg');
                        if (noComment) noComment.remove();

                        const c = data.comment;
                        const formattedContent = c.content;
                        
                        const html = `
                            <div class="flex gap-4 animate-fade-in">
                                <a href="/profile/${c.authorId}" title="Xem hồ sơ" class="shrink-0">
                                    <img src="${c.authorAvatar}" alt="${c.authorName}" class="w-10 h-10 rounded-full border border-slate-200 hover:border-cyan-500 hover:shadow-md transition-all cursor-pointer" />
                                </a>
                                <div class="flex-1">
                                    <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 shadow-sm relative">
                                        <div class="flex items-center justify-between mb-2">
                                            <div class="flex items-center gap-2">
                                                <a href="/profile/${c.authorId}" class="text-slate-800 font-black text-sm hover:text-cyan-600 transition-colors">${c.authorName}</a>
                                                <span class="text-slate-400 text-[10px] font-bold">${c.createdAt}</span>
                                            </div>
                                        </div>
                                        <div class="text-slate-700 text-sm leading-relaxed whitespace-pre-wrap">${formattedContent}</div>
                                    </div>
                                    <div class="flex items-center gap-4 mt-2 px-2">
                                        <button class="text-slate-400 hover:text-rose-500 text-xs font-bold transition-colors flex items-center gap-1"><i data-lucide="heart" class="w-3.5 h-3.5"></i> Thích</button>
                                        <button class="text-slate-400 hover:text-cyan-600 text-xs font-bold transition-colors flex items-center gap-1"><i data-lucide="reply" class="w-3.5 h-3.5"></i> Phản hồi</button>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        const list = document.getElementById('commentsList');
                        list.insertAdjacentHTML('beforeend', html);
                        document.getElementById('commentForm').reset();
                        if(window.lucide) { lucide.createIcons(); }
                        window.showToast && window.showToast('✅ Bình luận đã được gửi!');
                    }
                } else if (res.status === 401) {
                    window.location.href = `/Auth/Login?returnUrl=/hub/post/${postId}`;
                } else {
                    window.showToast && window.showToast('❌ Lỗi gửi bình luận.');
                }
            } catch (err) {
                window.showToast && window.showToast('❌ Lỗi kết nối.');
            } finally {
                btn.disabled = false;
                spinner.classList.add('hidden');
            }
        }

        // Share Manager Logic (Alpine)
        function shareManager() {
            return {
                isOpen: false,
                isSharing: false,
                contentType: '',
                contentId: 0,
                targetType: 'Chat', // Default to General Chat
                targetId: '',
                message: '',

                openShare(type, id) {
                    this.contentType = type;
                    this.contentId = id;
                    this.isOpen = true;
                    this.targetId = '';
                    this.message = '';
                    setTimeout(() => { if(window.lucide) lucide.createIcons(); }, 50);
                },

                async submitShare() {
                    // Xử lý gửi Chat Tổng
                    if (this.targetType === 'Chat') {
                        if(window.sendPostToChat) {
                            window.sendPostToChat(this.contentId, '@JavaScriptEncoder.Default.Encode(Model.Title)', '@JavaScriptEncoder.Default.Encode(Model.Category)');
                            this.isOpen = false;
                            window.showToast && window.showToast('✅ Đã đẩy lên Chat Tổng!');
                            return;
                        } else {
                            window.showToast && window.showToast('❌ Chat đang tải hoặc không khả dụng.');
                            return;
                        }
                    }

                    // Gửi qua API Share cho Group/User
                    if (!this.targetId) {
                        window.showToast && window.showToast('⚠️ Vui lòng nhập ID người nhận hoặc nhóm!');
                        return;
                    }

                    this.isSharing = true;
                    try {
                        const res = await fetch('/api/ShareApi/share', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                targetType: this.targetType,
                                targetId: parseInt(this.targetId),
                                contentType: this.contentType,
                                contentId: this.contentId,
                                message: this.message
                            })
                        });

                        if (res.ok) {
                            this.isOpen = false;
                            window.showToast && window.showToast('✅ Đã chia sẻ thành công!');
                        } else if (res.status === 401) {
                            window.location.href = '/Auth/Login';
                        } else {
                            const err = await res.json();
                            window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi khi chia sẻ.'));
                        }
                    } catch (e) {
                        window.showToast && window.showToast('❌ Lỗi kết nối đến máy chủ.');
                    } finally {
                        this.isSharing = false;
                    }
                }
            };
        }
    </script>
}
