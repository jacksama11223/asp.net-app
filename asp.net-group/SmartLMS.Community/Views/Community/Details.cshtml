@model SmartLMS.Models.Post
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = Model.Title;
    var authorName = Model.Author?.FullName ?? "Ẩn danh";
    var avatarUrl = Model.Author?.AvatarUrl ?? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(authorName)}&background=random";
}

<div class="max-w-4xl mx-auto pb-10">
    <a href="/hub" class="inline-flex items-center gap-2 text-white/50 hover:text-white mb-6 text-sm font-semibold transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Quay lại Bảng tin
    </a>

    <!-- Bài viết chính -->
    <article class="bg-gray-800/40 border border-white/10 rounded-2xl p-6 lg:p-8 backdrop-blur-xl mb-6">
        <div class="flex items-center gap-4 mb-6">
            <a href="/profile/@Model.AuthorId" title="Xem hồ sơ">
                <img src="@avatarUrl" alt="@authorName" class="w-12 h-12 rounded-full ring-2 ring-cyan-500/30 object-cover cursor-pointer hover:ring-cyan-400 transition-all" />
            </a>
            <div>
                <a href="/profile/@Model.AuthorId" class="text-white font-bold text-base hover:text-cyan-400 transition-colors">@authorName</a>
                <div class="text-white/40 text-xs mt-0.5 flex items-center gap-2">
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <span>•</span>
                    <span class="bg-white/10 px-2 py-0.5 rounded-md text-[10px] text-cyan-300 font-bold uppercase tracking-wider">@Model.Category</span>
                </div>
            </div>
        </div>

        <h1 class="text-2xl lg:text-3xl font-black text-white mb-6 leading-tight">@Model.Title</h1>

        <div class="prose prose-invert max-w-none mb-8 text-white/80 leading-relaxed prose-pre:bg-black/50 prose-pre:border prose-pre:border-white/10 prose-pre:rounded-xl">
            <!-- Chuyển Markdown sang HTML cơ bản. Cần Markdig nếu muốn parse markdown xịn -->
            @Html.Raw(Model.Content.Replace("\n", "<br/>"))
        </div>

        <div class="flex items-center justify-between pt-6 border-t border-white/10">
            <div class="flex items-center gap-4">
                <button class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-cyan-500/10 text-cyan-400 hover:bg-cyan-500/20 transition-colors text-sm font-bold">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                    @Model.VoteCount
                </button>
                <button class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-white/50 hover:text-white hover:bg-white/5 transition-colors text-sm font-bold">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    @(Model.Comments?.Count ?? 0)
                </button>
            </div>
            
            <div class="flex items-center gap-2">
                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    foreach (var tag in Model.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="px-2.5 py-1 rounded-lg bg-white/5 text-white/60 text-xs font-semibold">#@tag.Trim()</span>
                    }
                }
            </div>
        </div>
    </article>

    <!-- Khu vực Bình luận -->
    <div class="bg-gray-800/40 border border-white/10 rounded-2xl p-6 lg:p-8 backdrop-blur-xl">
        <h3 class="text-lg font-black text-white mb-6">Bình luận (@(Model.Comments?.Count ?? 0))</h3>
        
        <!-- Form nhập bình luận (Sẽ kết nối Backend ở Giai đoạn 2) -->
        <div class="flex gap-4 mb-8">
            <img src="https://ui-avatars.com/api/?name=You&background=random" class="w-10 h-10 rounded-full ring-2 ring-white/10" />
            <div class="flex-1">
                <textarea rows="3" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-sm text-white placeholder-white/30 focus:ring-2 focus:ring-cyan-500/50 outline-none resize-none transition-all" placeholder="Viết bình luận của bạn... (Hỗ trợ Markdown)"></textarea>
                <div class="flex justify-end mt-2">
                    <button class="bg-cyan-500 hover:bg-cyan-400 text-black px-5 py-2 rounded-lg text-sm font-bold transition-all shadow-[0_0_15px_rgba(6,182,212,0.4)] hover:shadow-[0_0_25px_rgba(6,182,212,0.6)]">
                        Gửi bình luận
                    </button>
                </div>
            </div>
        </div>

        <!-- Danh sách bình luận -->
        <div class="space-y-6">
            @if (Model.Comments != null && Model.Comments.Any())
            {
                foreach (var c in Model.Comments.Where(x => !x.IsDeleted).OrderBy(x => x.CreatedAt))
                {
                    <div class="flex gap-4">
                        <a href="/profile/@c.AuthorId"><img src="https://ui-avatars.com/api/?name=@c.AuthorId&background=random" class="w-10 h-10 rounded-full ring-1 ring-white/20" /></a>
                        <div class="flex-1">
                            <div class="bg-black/30 rounded-2xl rounded-tl-none p-4 border border-white/5">
                                <div class="flex items-center gap-2 mb-2">
                                    <a href="/profile/@c.AuthorId" class="text-white font-bold text-sm">User @c.AuthorId</a>
                                    <span class="text-white/30 text-[10px]">@c.CreatedAt.ToString("dd/MM HH:mm")</span>
                                </div>
                                <div class="text-white/70 text-sm">
                                    @Html.Raw(c.Content.Replace("\n", "<br/>"))
                                </div>
                            </div>
                            <div class="flex items-center gap-4 mt-2 px-2">
                                <button class="text-white/40 hover:text-cyan-400 text-xs font-bold transition-colors">Thích</button>
                                <button class="text-white/40 hover:text-cyan-400 text-xs font-bold transition-colors">Phản hồi</button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-8">
                    <p class="text-white/40 text-sm font-medium">Chưa có bình luận nào. Hãy là người đầu tiên bóc tem!</p>
                </div>
            }
        </div>
    </div>
</div>
