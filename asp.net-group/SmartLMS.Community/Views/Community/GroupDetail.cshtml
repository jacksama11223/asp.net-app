@model SmartLMS.Models.StudyGroup
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Không gian Nhóm: " + Model.Name;
}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6">
    <!-- Group Header -->
    <div class="bg-gradient-to-r from-cyan-600 to-blue-600 rounded-3xl p-8 text-white shadow-md relative overflow-hidden">
        <a href="/hub/groups" class="relative z-10 inline-flex items-center gap-2 text-xs font-bold text-white/70 hover:text-white transition-colors mb-4">
            &larr; Tất cả Nhóm học
        </a>
        <div class="relative z-10 space-y-4">
            <span class="bg-white/20 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest backdrop-blur-sm">@Model.Subject</span>
            <h1 class="text-3xl font-black">@Model.Name</h1>
            <p class="text-white/80 max-w-2xl leading-relaxed">@Model.Description</p>
            
            <div class="flex items-center gap-6 pt-2 text-sm font-bold text-white/90">
                <div class="flex items-center gap-2">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>@((Model.Members?.Count ?? 0) + 1) / 50 thành viên</span>
                </div>
                <div class="flex items-center gap-2">
                    <i data-lucide="star" class="w-4 h-4 text-amber-300"></i>
                    <span>@Model.EXP XP (Rank Nhóm)</span>
                </div>
            </div>
        </div>
        <i data-lucide="users-2" class="absolute -right-10 -bottom-10 w-64 h-64 text-white/10"></i>
    </div>

    <!-- Group Layout: Main Content (Left) & Sidebar (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" x-data="groupPosts(@Model.Id)">
        <!-- Main Board -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Form Đăng bài / Thảo luận -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 space-y-4">
                <div class="flex items-center gap-3 mb-2">
                    <div class="w-8 h-8 bg-slate-200 rounded-full overflow-hidden">
                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(User.Identity?.Name ?? "U")" alt="You" />
                    </div>
                    <span class="text-sm font-bold text-slate-700">Tạo thảo luận mới</span>
                </div>
                
                <textarea x-model="newPostContent" placeholder="Chia sẻ tài liệu, đặt câu hỏi cho nhóm..." rows="3" class="w-full bg-slate-50 border border-slate-100 p-4 rounded-xl text-sm outline-none focus:ring-2 focus:ring-cyan-500 placeholder-slate-400 resize-none transition-all"></textarea>
                
                <!-- Hiển thị file đính kèm -->
                <div x-show="attachments.length > 0" class="flex flex-wrap gap-2 mt-2" style="display: none;">
                    <template x-for="(file, index) in attachments" :key="index">
                        <div class="flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600">
                            <i data-lucide="paperclip" class="w-3 h-3 text-cyan-600"></i>
                            <span x-text="file.fileName"></span>
                            <button type="button" @@click="attachments.splice(index, 1)" class="text-rose-500 hover:text-rose-700 ml-1">&times;</button>
                        </div>
                    </template>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-slate-50">
                    <div class="flex gap-2 relative">
                        <!-- Nút Đính kèm tài liệu -->
                        <input type="file" id="fileUpload" class="hidden" @@change="uploadFile($event)" style="display: none;">
                        <button @@click="document.getElementById('fileUpload').click()" class="text-xs font-bold text-slate-500 hover:text-cyan-600 flex items-center gap-1.5 px-3 py-1.5 rounded-lg hover:bg-cyan-50 transition-colors">
                            <i data-lucide="paperclip" class="w-4 h-4"></i> Đính kèm
                        </button>
                    </div>
                    <button @@click="submitPost()" :disabled="isSubmitting" class="bg-cyan-600 hover:bg-cyan-700 disabled:bg-slate-400 text-white font-bold text-sm px-6 py-2 rounded-xl transition-all shadow-md active:scale-95 flex items-center gap-2">
                        <i data-lucide="send" class="w-4 h-4"></i> <span x-text="isSubmitting ? 'Đang đăng...' : 'Đăng bài'"></span>
                    </button>
                </div>
            </div>

            <!-- Danh sách Bài thảo luận -->
            <div class="space-y-4">
                <template x-for="post in posts" :key="post.id">
                    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center font-bold text-sm border border-amber-200">
                                    <img :src="`https://api.dicebear.com/7.x/avataaars/svg?seed=${post.authorId}`" class="rounded-full" />
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-slate-800">
                                        <span x-text="post.authorName"></span>
                                        <span x-show="post.authorId == @Model.LeaderId" class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.5 rounded font-black ml-1 uppercase">Trưởng nhóm</span>
                                    </p>
                                    <p class="text-[10px] text-slate-400 font-bold" x-text="new Date(post.createdAt).toLocaleString()"></p>
                                </div>
                            </div>
                        </div>

                        <div class="text-sm text-slate-600 leading-relaxed whitespace-pre-wrap" x-html="formatMentions(post.content)"></div>

                        <!-- Nếu bài viết có AttachmentIds thì có thể gọi API fetch chi tiết attachment, tạm ẩn -->
                        <div x-show="post.attachmentIds" class="bg-slate-50 border border-slate-100 rounded-xl p-3 flex items-center gap-3 mt-3 group/file cursor-pointer hover:bg-cyan-50 hover:border-cyan-100 transition-colors">
                            <div class="bg-cyan-100 text-cyan-600 p-2 rounded-lg">
                                <i data-lucide="paperclip" class="w-5 h-5"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-bold text-slate-700 truncate group-hover/file:text-cyan-700">Tài liệu đính kèm</p>
                            </div>
                        </div>

                        <!-- Interactions -->
                        <div class="flex items-center gap-6 pt-4 border-t border-slate-50 text-xs font-bold text-slate-500">
                            <button class="flex items-center gap-1.5 hover:text-rose-500 transition-colors"><i data-lucide="heart" class="w-4 h-4"></i> <span x-text="post.likesCount"></span></button>
                            <button class="flex items-center gap-1.5 hover:text-cyan-600 transition-colors"><i data-lucide="message-circle" class="w-4 h-4"></i> <span x-text="post.commentsCount + ' Bình luận'"></span></button>
                        </div>
                    </div>
                </template>

                <div x-show="posts.length === 0" class="text-center py-10 text-slate-400 text-sm font-medium">
                    <i data-lucide="message-square" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                    Chưa có bài viết nào trong nhóm này. Hãy là người đầu tiên!
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Members List -->
            <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
                <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-4">Thành viên (@((Model.Members?.Count ?? 0) + 1))</h3>
                <div class="space-y-3 max-h-80 overflow-y-auto pr-2 custom-scrollbar">
                    <!-- Leader -->
                    <div class="flex items-center justify-between p-2 rounded-xl bg-amber-50 border border-amber-100/50">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-amber-200 text-amber-700 rounded-full flex items-center justify-center font-bold text-xs">L</div>
                            <span class="text-sm font-bold text-amber-900">@(Model.Leader?.FullName ?? "Leader")</span>
                        </div>
                        <span class="text-[10px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Trưởng nhóm</span>
                    </div>
                    
                    <!-- Members -->
                    @if (Model.Members != null)
                    {
                        foreach(var m in Model.Members)
                        {
                            <div class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-slate-200 text-slate-600 rounded-full flex items-center justify-center font-bold text-xs">M</div>
                                    <span class="text-sm font-semibold text-slate-700">Thành viên ID: @m.UserId</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) { lucide.createIcons(); }
            }, 50);
        });
    });

    function groupPosts(groupId) {
        return {
            posts: [],
            newPostContent: '',
            attachments: [], // { id, fileName, fileUrl }
            isSubmitting: false,

            formatMentions(content) {
                if (!content) return '';
                let html = content.replace(/</g, '&lt;').replace(/>/g, '&gt;'); // Basic XSS protection
                html = html.replace(/@@(\d+)/g, '<a href="/hub/events/$1" class="text-indigo-600 font-bold hover:underline">@@SựKiện-$1</a>');
                html = html.replace(/#(\d+)/g, '<a href="/hub/groups/$1" class="text-purple-600 font-bold hover:underline">#Nhóm-$1</a>');
                html = html.replace(/\[SHARED_QA:(\d+)\]/g, '<div class="p-3 bg-slate-100 border border-slate-200 rounded-lg my-2 text-xs font-bold"><i data-lucide="help-circle" class="w-4 h-4 inline"></i> <a href="/hub/qa/$1" class="text-indigo-600">Đính kèm Câu hỏi QA-$1</a></div>');
                html = html.replace(/\[SHARED_EVENT:(\d+)\]/g, '<div class="p-3 bg-slate-100 border border-slate-200 rounded-lg my-2 text-xs font-bold"><i data-lucide="calendar" class="w-4 h-4 inline"></i> <a href="/hub/events/$1" class="text-indigo-600">Đính kèm Sự kiện Event-$1</a></div>');
                html = html.replace(/\[SHARED_RESOURCE:(\d+)\]/g, '<div class="p-3 bg-slate-100 border border-slate-200 rounded-lg my-2 text-xs font-bold"><i data-lucide="file" class="w-4 h-4 inline"></i> <a href="/hub/resources" class="text-indigo-600">Đính kèm Tài nguyên Res-$1</a></div>');
                return html;
            },

            async init() {
                await this.fetchPosts();
            },

            async fetchPosts() {
                try {
                    const res = await fetch(`/api/GroupApi/${groupId}/posts`);
                    if (res.ok) {
                        this.posts = await res.json();
                    }
                } catch (e) {
                    console.error("Lỗi tải bài viết", e);
                }
            },

            async uploadFile(event) {
                const file = event.target.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append("file", file);

                try {
                    window.showToast && window.showToast('ℹ️ Đang tải lên file...');
                    const res = await fetch('/api/AttachmentApi/upload', {
                        method: 'POST',
                        body: formData
                    });

                    if (res.ok) {
                        const data = await res.json();
                        this.attachments.push(data);
                        window.showToast && window.showToast('✅ Đã đính kèm file!');
                    } else {
                        const err = await res.json();
                        window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi tải lên.'));
                    }
                } catch (e) {
                    window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
                }
            },

            async submitPost() {
                if (!this.newPostContent.trim()) {
                    window.showToast && window.showToast('⚠️ Vui lòng nhập nội dung!');
                    return;
                }

                this.isSubmitting = true;
                const attachmentIds = this.attachments.map(a => a.id).join(',');

                try {
                    const res = await fetch(`/api/GroupApi/${groupId}/posts`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content: this.newPostContent, attachmentIds })
                    });

                    if (res.ok) {
                        this.newPostContent = '';
                        this.attachments = [];
                        window.showToast && window.showToast('✅ Bài viết đã được đăng!');
                        await this.fetchPosts();
                    } else if (res.status === 401) {
                        window.location.href = '/Auth/Login';
                    } else {
                        const err = await res.json();
                        window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi đăng bài.'));
                    }
                } catch (e) {
                    window.showToast && window.showToast('❌ Lỗi kết nối.');
                } finally {
                    this.isSubmitting = false;
                }
            }
        };
    }
</script>
