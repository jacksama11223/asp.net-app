@model IEnumerable<SmartLMS.Models.UserActivityPoint>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Bảng xếp hạng (Leaderboard)";
}

<!-- Thêm Alpine.js -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ congratsLog: {} }">
    <!-- Dynamic top motivational block -->
    <div class="bg-gradient-to-r from-cyan-600 to-blue-600 rounded-3xl p-6 text-white flex flex-col md:flex-row justify-between items-center gap-4 shadow-lg shadow-cyan-100/50">
        <div class="space-y-1 text-center md:text-left">
            <span class="bg-white/15 text-white/95 text-[9px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1.5 w-max mx-auto md:mx-0">
                <img src="/images/icons/badge_mentor.svg" class="w-3.5 h-3.5 text-amber-300 animate-spin" />
                Bảng vinh danh SmartLMS
            </span>
            <h3 class="font-bold text-lg md:text-xl">Bảng xếp hạng Cộng đồng Học Tập</h3>
            <p class="text-white/80 text-xs">Cố gắng tích lũy điểm học tập bằng cách trả lời câu hỏi và làm bài để được vinh danh!</p>
        </div>

        <div class="flex gap-4 items-center bg-white/10 p-3 rounded-2xl border border-white/10 text-center text-xs">
            <div>
                <span class="block text-[10px] text-white/70">Top Hoạt động Tuần</span>
                <strong class="text-base text-amber-300 flex items-center gap-1 justify-center mt-0.5">
                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                    +340 Điểm
                </strong>
            </div>
        </div>
    </div>

    <!-- Leaderboard Entries List Table -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-6 text-center w-16">Thứ Hạng</th>
                        <th class="py-4 px-6">Thành viên</th>
                        <th class="py-4 px-6 text-center">LMS Role</th>
                        <th class="py-4 px-6 text-right">Tổng LMS Điểm</th>
                        <th class="py-4 px-6 text-center select-none">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @{ int rank = 1; var rnd = new Random(); }
                    @if (Model != null)
                    {
                        @foreach (var entry in Model)
                        {
                            var weeklyGain = rnd.Next(10, 100);
                            var role = entry.User?.Role ?? "Student";
                            var fullName = entry.User?.FullName ?? "Member";
                            
                            var roleClass = role == "Instructor" ? "bg-rose-50 text-rose-700 border-rose-100" :
                                            role == "Mentor" ? "bg-amber-50 text-amber-700 border-amber-100" :
                                            role == "Admin" ? "bg-purple-50 text-purple-700 border-purple-100" :
                                            "bg-cyan-50 text-cyan-700 border-cyan-100";

                            <tr class="hover:bg-slate-50/50 transition-colors group cursor-pointer @(rank <= 3 ? "bg-slate-50/20" : "")">
                                <!-- Rank Badge Column -->
                                <td class="py-4 px-6 text-center">
                                    <div class="flex justify-center">
                                        @if (rank == 1)
                                        {
                                            <div class="w-7 h-7 bg-amber-500 rounded-full flex items-center justify-center text-white shadow shadow-amber-300">
                                                <img src="/images/icons/trophy_cup.svg" class="w-3.5 h-3.5 animate-bounce" />
                                            </div>
                                        }
                                        else if (rank == 2)
                                        {
                                            <div class="w-7 h-7 bg-slate-200 rounded-full flex items-center justify-center text-slate-800 font-bold text-xs shadow border border-slate-300">
                                                2
                                            </div>
                                        }
                                        else if (rank == 3)
                                        {
                                            <div class="w-7 h-7 bg-amber-700 rounded-full flex items-center justify-center text-amber-100 font-bold text-xs shadow border border-amber-600">
                                                3
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="w-7 h-7 bg-slate-100 rounded-full flex items-center justify-center text-slate-500 font-bold text-xs">
                                                @rank
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Member Column -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3 cursor-pointer group-hover:text-cyan-600 transition-colors">
                                        <div class="w-10 h-10 rounded-xl overflow-hidden bg-slate-100 border border-slate-100 shrink-0 group-hover:ring-2 group-hover:ring-cyan-500 transition-all">
                                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@entry.UserId" alt="@fullName" />
                                        </div>
                                        <div class="min-w-0">
                                            <span class="font-bold text-slate-800 text-sm block truncate group-hover:text-cyan-600 transition-colors">
                                                @fullName 
                                                <span class="text-[9px] text-cyan-500 font-bold opacity-0 group-hover:opacity-100 transition-opacity">(Hồ sơ &rarr;)</span>
                                            </span>
                                            <div class="flex flex-wrap gap-1 mt-0.5">
                                                <span class="bg-slate-50 text-[9px] font-bold text-slate-400 px-1.5 py-0.5 rounded border border-slate-100">
                                                    Top Learner
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Role column -->
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-block text-[9px] font-bold px-2 py-0.5 rounded-full border uppercase tracking-wider @roleClass">
                                        @role
                                    </span>
                                </td>

                                <!-- Points Balance Column -->
                                <td class="py-4 px-6 text-right">
                                    <div>
                                        <span class="font-bold text-slate-800 text-sm">
                                            @entry.Points.ToString("N0")
                                        </span>
                                        <span class="block text-[10px] text-emerald-600 font-bold mt-0.5">
                                            Tăng +@weeklyGain tuần này
                                        </span>
                                    </div>
                                </td>

                                <!-- Action congratulations Column -->
                                <td class="py-4 px-6 text-center select-none">
                                    <button
                                        @@click="congratsLog['@entry.UserId'] = (congratsLog['@entry.UserId'] || 0) + 1"
                                        :class="congratsLog['@entry.UserId'] > 0 ? 'bg-amber-50 text-amber-600 scale-105 border border-amber-200' : 'bg-slate-100 hover:bg-amber-50 text-slate-500 hover:text-amber-600 border border-slate-100'"
                                        class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1.5 rounded-xl transition-all"
                                    >
                                        <i data-lucide="star" class="w-3.5 h-3.5" :class="congratsLog['@entry.UserId'] > 0 ? 'fill-amber-400 text-amber-400 animate-pulse' : ''"></i>
                                        <span>Chúc mừng</span>
                                        <span x-show="congratsLog['@entry.UserId'] > 0" style="display: none;" x-text="congratsLog['@entry.UserId']" class="bg-amber-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full scale-95">
                                        </span>
                                    </button>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) {
                    lucide.createIcons();
                }
            }, 50);
        });
    });
</script>
