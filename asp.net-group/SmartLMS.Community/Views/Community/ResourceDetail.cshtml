@model SmartLMS.Models.CommunityResource
@{
    ViewData["Title"] = Model.Title;
    Layout = "_CommunityLayout";
}

@section Styles {
    <!-- PDF.js dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>
}

<div class="h-[calc(100vh-80px)] w-full max-w-7xl mx-auto flex flex-col bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-xl mt-4">
    <!-- Header Document Viewer -->
    <div class="relative z-10 flex items-center justify-between px-6 py-4 bg-white border-b border-slate-100">
        <div class="flex items-center gap-4">
            <a href="/hub/resources" class="p-2 bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-800 rounded-xl transition-all mr-2">
                <img src="/images/icons/nav_back_arrow.svg" class="w-5 h-5" />
            </a>
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-rose-600 text-white flex items-center justify-center shadow-lg shadow-rose-500/30">
                <img src="/images/icons/course_read_doc.svg" class="w-5 h-5" />
            </div>
            <div>
                <h3 class="text-base font-black text-slate-800 leading-tight truncate max-w-2xl tracking-wide">@Model.Title</h3>
                <p class="text-[11px] text-cyan-400 font-bold tracking-widest uppercase mt-0.5 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                    SmartLMS Secure Viewer - @(Model.Uploader?.FullName ?? "Học viên")
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="@Model.FileUrl" target="_blank" class="flex items-center gap-2 px-4 py-2 bg-cyan-50 hover:bg-cyan-100 text-cyan-700 hover:text-cyan-800 rounded-xl transition-all font-bold text-xs shadow-sm border border-cyan-200">
                <img src="/images/icons/course_download.svg" class="w-4 h-4" />
                <span class="hidden sm:inline">Tải về máy</span>
            </a>
        </div>
    </div>

    <!-- Viewer Body (Split) -->
    <div class="flex-1 overflow-hidden flex flex-col lg:flex-row bg-slate-50">
        <!-- PDF Viewer (Left) -->
        <div class="w-full lg:w-2/3 h-[50vh] lg:h-full flex flex-col border-b lg:border-b-0 lg:border-r border-slate-200 bg-slate-50"
             x-data="premiumPdfViewer()" 
             x-init="initViewer('@Model.FileUrl' || 'https://mozilla.github.io/pdf.js/web/compressed.tracemonkey-pldi-09.pdf')">
            
            <!-- Toolbar ảo của PDF.js -->
            <div x-show="viewerMode === 'pdf'" class="h-12 bg-white flex items-center justify-between px-4 border-b border-slate-200 flex-shrink-0 relative z-20 shadow-sm">
                <div class="flex items-center gap-4">
                    <!-- Dark Mode Toggle -->
                    <button @@click="toggleDarkMode()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-bold transition-all" :class="isDarkMode ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-600'">
                        <svg x-show="!isDarkMode" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <svg x-show="isDarkMode" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                        <span class="hidden md:inline" x-text="isDarkMode ? 'Dark Mode' : 'Light Mode'"></span>
                    </button>
                </div>

                <!-- Pagination Controls -->
                <div class="flex items-center gap-3 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-200">
                    <button @@click="prevPage()" :disabled="pageNum <= 1" class="text-slate-500 hover:text-slate-800 disabled:opacity-30 transition-colors p-1">
                        <img src="/images/icons/nav_back_arrow.svg" class="w-4 h-4" />
                    </button>
                    <span class="text-xs font-bold text-slate-500 font-mono tracking-widest">
                        Trang <span x-text="pageNum" class="text-slate-800"></span> / <span x-text="totalPages"></span>
                    </span>
                    <button @@click="nextPage()" :disabled="pageNum >= totalPages" class="text-slate-500 hover:text-slate-800 disabled:opacity-30 transition-colors p-1">
                        <img src="/images/icons/nav_back_arrow.svg" class="w-4 h-4 transform rotate-180" />
                    </button>
                </div>

                <!-- Zoom Controls -->
                <div class="flex items-center gap-1">
                    <button @@click="zoomOut()" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path></svg>
                    </button>
                    <span class="text-[10px] font-bold text-cyan-600 w-10 text-center" x-text="Math.round(scale * 100) + '%'"></span>
                    <button @@click="zoomIn()" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Nội dung Canvas Render PDF / DOC / IMG -->
            <div class="flex-1 overflow-auto bg-slate-100 flex justify-center p-4 relative custom-scrollbar">
                
                <!-- Hiệu ứng tải cho PDF -->
                <div x-show="isLoadingPdf" class="absolute inset-0 flex flex-col items-center justify-center bg-white/80 z-10 backdrop-blur-sm">
                    <svg class="animate-spin h-10 w-10 text-cyan-500 mb-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <p class="text-cyan-600 font-bold tracking-widest uppercase text-sm animate-pulse">Đang nạp tài liệu...</p>
                </div>

                <!-- PDF Viewer -->
                <canvas x-show="viewerMode === 'pdf'" x-ref="pdfCanvas" class="shadow-2xl transition-all duration-300" 
                        :style="isDarkMode ? 'filter: invert(90%) hue-rotate(180deg) contrast(1.1);' : 'filter: none;'">
                </canvas>
                
                <!-- Image Viewer -->
                <img x-show="viewerMode === 'image'" :src="pdfUrl" class="max-w-full h-auto object-contain shadow-2xl rounded-lg" />
                
                <!-- Word/Office Viewer -->
                <iframe x-show="viewerMode === 'word'" :src="getGoogleDocsViewerUrl()" class="w-full h-full border-0 bg-white rounded-lg shadow-inner"></iframe>
                
                <!-- Fallback Unsupported -->
                <div x-show="viewerMode === 'unsupported'" class="flex flex-col items-center justify-center h-full w-full opacity-60">
                    <img src="/images/icons/course_read_doc.svg" class="w-16 h-16 mb-4 grayscale" />
                    <p class="text-slate-500 font-bold">Không hỗ trợ xem trực tiếp định dạng này.</p>
                </div>
                
            </div>
        </div>

        <!-- Discussion Panel (Right) -->
        <div class="w-full lg:w-1/3 h-[50vh] lg:h-full flex flex-col bg-white border-l border-slate-200" 
             x-data="resourceDiscussion()" 
             x-init="openResource(@Model.Id)">
             
            <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50 flex-shrink-0">
                <h4 class="text-sm font-black text-slate-800 uppercase tracking-widest flex items-center gap-2">
                    <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
                    Thảo luận (<span x-text="comments.length"></span>)
                </h4>
            </div>

            <!-- Khu vực cuộn của Thảo luận -->
            <div class="flex-1 overflow-y-auto p-4 custom-scrollbar flex flex-col gap-4">
                <!-- Form Bình luận Gốc -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex-shrink-0">
                    <div class="flex gap-4">
                        <div class="w-10 h-10 rounded-full bg-slate-100 flex-shrink-0 flex items-center justify-center">
                            <img src="/images/icons/avatar_default_user.svg" class="w-5 h-5 opacity-50" />
                        </div>
                        <div class="flex-1">
                            <textarea x-model="newComment" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-800 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 resize-none transition-all" placeholder="Bạn có thắc mắc gì về tài liệu này? Hãy gõ @@AI nếu bạn muốn trợ lý ảo giải đáp tự động..."></textarea>
                            <div class="flex justify-between items-center mt-3">
                                <div class="text-xs text-slate-500 italic">Mẹo: Bạn có thể sử dụng Markdown và gõ <strong class="text-cyan-600">@@AI</strong> để gọi bot.</div>
                                <button type="button" @@click="postComment(null)" :disabled="!newComment.trim() || isLoading" class="bg-cyan-600 hover:bg-cyan-500 disabled:bg-slate-700 disabled:text-slate-500 text-white font-bold text-sm px-6 py-2.5 rounded-xl transition-all shadow-md flex items-center gap-2">
                                    <img src="/images/frames/n_t_g_i_b_nh_lu_n.svg" class="w-4 h-4" onerror="this.src='/images/icons/social_share.svg'" />
                                    Gửi
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Danh sách bình luận -->
                <div class="flex-1 flex flex-col">
                    <div x-show="isLoading" class="text-slate-500 text-sm text-center py-8 flex flex-col items-center gap-3">
                        <svg class="animate-spin h-6 w-6 text-cyan-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        Đang tải bình luận...
                    </div>
                    <div x-show="!isLoading && comments.length === 0" class="text-slate-500 text-sm text-center py-10 border-2 border-dashed border-slate-200 rounded-xl">
                        Chưa có thảo luận nào.
                    </div>
                    
                    <div class="space-y-6 mt-2">
                        <template x-for="comment in comments" :key="comment.id">
                            <div class="text-sm border-b border-slate-100 pb-5 last:border-0">
                                <div class="flex items-start justify-between">
                                    <div class="flex items-center gap-3 mb-2">
                                        <img :src="comment.authorAvatar" class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 shadow-sm" />
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-bold text-slate-800 text-sm" x-text="comment.authorName"></span>
                                                <span x-show="comment.authorName === '🤖 SmartLMS AI'" class="bg-indigo-50 text-indigo-600 text-[9px] px-1.5 py-0.5 rounded uppercase font-black tracking-wider border border-indigo-200 flex items-center gap-1"><img src="/images/icons/avatar_system_bot.svg" class="w-3 h-3" /> AI Bot</span>
                                            </div>
                                            <span class="text-xs text-slate-500" x-text="new Date(comment.createdAt).toLocaleString()"></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <p class="text-slate-700 text-sm leading-relaxed ml-13 mb-3 whitespace-pre-wrap" x-text="comment.content"></p>
                                
                                <div class="ml-13 flex items-center gap-4 text-xs font-bold text-slate-500">
                                    <button @@click="upvote(comment.id)" class="hover:text-cyan-600 flex items-center gap-1 bg-slate-50 px-2.5 py-1 rounded-md transition-colors border border-slate-200"><span class="text-[10px]">▲</span> <span x-text="comment.upvotes"></span></button>
                                    <button @@click="activeReplyId = activeReplyId === comment.id ? null : comment.id" class="hover:text-cyan-600 flex items-center gap-1 transition-colors">
                                        <img src="/images/icons/comment_reply.svg" class="w-3.5 h-3.5" style="filter: invert(0.5);" /> Phản hồi
                                    </button>
                                </div>

                                <!-- Form Trả lời -->
                                <div x-show="activeReplyId === comment.id" class="ml-13 mt-4 flex gap-3 items-start" x-transition>
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=CurrentUser" class="w-8 h-8 rounded-full bg-slate-100 opacity-80" />
                                    <div class="flex-1">
                                        <textarea x-model="replyContent" @@keydown.enter="postComment(comment.id)" rows="2" class="w-full bg-white border border-slate-200 rounded-xl p-3 text-sm text-slate-800 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 resize-none transition-all" placeholder="Viết phản hồi..."></textarea>
                                        <div class="flex justify-end gap-2 mt-2">
                                            <button @@click="activeReplyId = null" class="px-4 py-1.5 text-xs text-slate-500 hover:text-slate-700 font-bold">Hủy</button>
                                            <button @@click="postComment(comment.id)" class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-1.5 rounded-lg text-xs font-bold transition-colors">Gửi</button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Replies -->
                                <div class="ml-13 mt-4 space-y-4 border-l-2 border-slate-200 pl-4">
                                    <template x-for="reply in comment.replies" :key="reply.id">
                                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                                            <div class="flex items-start justify-between">
                                                <div class="flex items-center gap-2 mb-1.5">
                                                    <img :src="reply.authorAvatar" class="w-7 h-7 rounded-full bg-slate-100 border border-slate-200" />
                                                    <div>
                                                        <div class="flex items-center gap-1.5">
                                                            <span class="font-bold text-slate-700 text-xs" x-text="reply.authorName"></span>
                                                            <span x-show="reply.authorName === '🤖 SmartLMS AI'" class="bg-indigo-50 text-indigo-600 text-[8px] px-1 py-0.5 rounded uppercase font-black tracking-wider border border-indigo-200 flex items-center gap-1"><img src="/images/icons/avatar_system_bot.svg" class="w-2.5 h-2.5" /> AI Bot</span>
                                                        </div>
                                                        <span class="text-[10px] text-slate-500" x-text="new Date(reply.createdAt).toLocaleString()"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <p class="text-slate-600 text-sm leading-relaxed ml-9 mb-2 whitespace-pre-wrap" x-text="reply.content"></p>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/components/premium-pdf-viewer.js"></script>
    <script src="~/js/components/resource-discussion.js"></script>
}
