@model IEnumerable<SmartLMS.Models.CommunityResource>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Resource Sharing";
}

<div class="space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Resource Library</h2>
            <p class="text-slate-500">Discover and share study materials with the community.</p>
        </div>
        <button class="bg-slate-800 hover:bg-slate-900 text-white px-6 py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"></path></svg>
            Upload New Resource
        </button>
    </div>

    <!-- Filters -->
    <div class="glass-card rounded-2xl p-4 flex gap-4 items-center">
        <span class="text-sm font-bold text-slate-400 uppercase tracking-wider">Filter by:</span>
        <select class="bg-white border border-slate-200 rounded-lg px-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <option>All File Types</option>
            <option>PDF</option>
            <option>Video</option>
            <option>Code</option>
        </select>
        <select class="bg-white border border-slate-200 rounded-lg px-4 py-2 outline-none focus:ring-2 focus:ring-cyan-500">
            <option>All Subjects</option>
            <option>Calculus</option>
            <option>Python</option>
            <option>Machine Learning</option>
        </select>
    </div>

    <!-- Resource List -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var res in Model)
        {
            <div class="glass-card rounded-2xl p-6 hover:shadow-xl hover:scale-[1.01] transition-all group">
                <div class="flex gap-4">
                    <div class="w-16 h-16 bg-cyan-100 rounded-2xl flex items-center justify-center text-cyan-600">
                        @if(res.FileType == "PDF") {
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        } else if(res.FileType == "Video") {
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                        } else {
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                        }
                    </div>
                    <div class="flex-1">
                        <div class="flex justify-between items-start">
                            <h4 class="font-bold text-lg group-hover:text-cyan-600 transition-all">@res.Title</h4>
                            <div class="flex items-center gap-1 text-orange-400 font-bold">
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                @res.Rating.ToString("F1")
                            </div>
                        </div>
                        <p class="text-sm text-slate-500 mt-1">Uploaded by @(res.Uploader?.FullName ?? "Unknown")</p>
                        <div class="flex gap-2 mt-4">
                            <span class="bg-slate-100 text-slate-600 text-xs font-bold px-3 py-1 rounded-full">@res.Subject</span>
                            <span class="bg-cyan-50 text-cyan-600 text-xs font-bold px-3 py-1 rounded-full">@res.FileType</span>
                        </div>
                    </div>
                </div>
                <div class="mt-6 flex gap-3">
                    <button class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white font-bold py-2 rounded-xl transition-all flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Download
                    </button>
                    <button class="px-4 border border-slate-200 hover:bg-slate-50 rounded-xl transition-all">
                        <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    </button>
                </div>
            </div>
        }
    </div>
</div>
