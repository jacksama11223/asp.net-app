@model IEnumerable<SmartLMS.Models.CommunityResource>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Kho tài nguyên & Đề thi";
}

<!-- Thêm Alpine.js cho bộ lọc và modal -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ 
    isUploading: false, 
    activeSubject: 'All', 
    viewingPdf: false, 
    currentPdfTitle: '', 
    currentPdfUrl: '' 
}">
    <!-- Search and filter header -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-2 flex items-center gap-1">
                <i data-lucide="book-open" class="w-3.5 h-3.5 text-slate-400"></i> Môn học:
            </span>
            <button @@click="activeSubject = 'All'" :class="activeSubject === 'All' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                Tất cả tài liệu
            </button>
            <button @@click="activeSubject = '.NET Development'" :class="activeSubject === '.NET Development' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                .NET Development
            </button>
            <button @@click="activeSubject = 'Database Systems'" :class="activeSubject === 'Database Systems' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                Database Systems
            </button>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button 
                @@click="isUploading = !isUploading"
                class="flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95"
            >
                <i data-lucide="upload" class="w-4 h-4"></i>
                Đăng tài liệu mới
            </button>
        }
        else
        {
            <a href="/Auth/Login?returnUrl=/hub/resources"
               class="flex items-center gap-1.5 bg-slate-100 hover:bg-cyan-50 text-slate-600 hover:text-cyan-700 text-sm font-bold px-4 py-2 rounded-xl transition-all border border-slate-200">
                <i data-lucide="lock" class="w-4 h-4"></i>
                Đăng nhập để đăng tài liệu
            </a>
        }
    </div>

    <!-- Upload Slide Panel -->
    <div 
        x-show="isUploading"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        class="overflow-hidden" style="display: none;"
    >
        <form class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                    <i data-lucide="upload" class="w-4 h-4 text-cyan-500"></i>
                    Chia sẻ tài liệu & Đề thi thử
                </h3>
                <button type="button" @@click="isUploading = false" class="text-xs text-slate-400 hover:text-slate-600 font-bold">
                    Hủy bỏ
                </button>
            </div>

            <div class="space-y-3">
                <input type="text" required placeholder="Tiêu đề tài liệu (ví dụ: Tổng hợp đề thi thử DSA kỳ 1 năm 2025)" class="w-full bg-slate-50 border-none rounded-xl px-4 py-3 text-slate-800 font-medium placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 transition-all text-sm" />

                <textarea required placeholder="Mô tả nội dung tài liệu, cách tải hoặc tóm tắt các điểm quan trọng..." rows="3" class="w-full bg-slate-50 border-none rounded-xl p-4 text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all text-sm"></textarea>

                <div class="grid grid-cols-4 gap-3">
                    <div class="col-span-2 space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Môn học / Lĩnh vực</label>
                        <select class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value=".NET Development">.NET Development</option>
                            <option value="Database Systems">Database Systems</option>
                            <option value="General Info">General Info</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Định dạng</label>
                        <select class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value="PDF">PDF</option>
                            <option value="DOCX">DOCX</option>
                            <option value="ZIP">ZIP</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Dung lượng</label>
                        <input type="text" value="2.4 MB" class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button type="button" @@click="uploadResource()" class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-sm px-6 py-2 rounded-xl transition-all shadow-md active:scale-95">
                    Xác nhận tải lên
                </button>
            </div>
        </form>
    </div>

    <!-- Grid of Resources -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @if (Model != null && Model.Any())
        {
            foreach (var res in Model)
            {
                var isLiked = false; // Fake state
                
                <div 
                    x-show="activeSubject === 'All' || activeSubject === '@res.Subject'"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 scale-95"
                    x-transition:enter-end="opacity-100 scale-100"
                    @@click="viewingPdf = true; currentPdfTitle = decodeURIComponent('@Uri.EscapeDataString(res.Title)'); currentPdfUrl = '@res.FileUrl' || 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf';"
                    class="bg-white rounded-2xl p-5 border border-slate-100 flex gap-4 hover:shadow-lg hover:border-cyan-200 transition-all group cursor-pointer relative overflow-hidden"
                    x-data="{ liked: @(isLiked.ToString().ToLower()), likesCount: @res.VoteCount, downloads: @(new Random().Next(10, 500)) }"
                >
                    <!-- Ánh sáng lướt qua khi hover -->
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/40 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite] pointer-events-none z-10"></div>

                    <!-- Left File Type Graphic Icon -->
                    <div class="w-12 h-14 bg-cyan-50 group-hover:bg-cyan-100/80 rounded-xl flex flex-col items-center justify-center border border-cyan-100/50 shrink-0 text-cyan-600 font-bold transition-all">
                        <i data-lucide="file-text" class="w-5 h-5 mb-0.5"></i>
                        <span class="text-[9px] uppercase tracking-wider">@(res.FileType ?? "PDF")</span>
                    </div>

                    <!-- Right Details -->
                    <div class="flex-1 min-w-0 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start gap-2">
                                <span class="bg-slate-100 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-md">
                                    @res.Subject
                                </span>
                                <span class="text-[10px] text-slate-400 font-medium">
                                    3.5 MB
                                </span>
                            </div>
                            <h4 class="font-bold text-slate-800 text-sm mt-1 mb-1 leading-snug group-hover:text-cyan-600 transition-all truncate">
                                @res.Title
                            </h4>
                            <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed">
                                @res.Description
                            </p>
                        </div>

                        <!-- Footer of resource -->
                        <div class="pt-3 mt-3 border-t border-slate-50 flex items-center justify-between text-xs text-slate-400">
                            <div class="flex items-center gap-1.5">
                                <div class="w-5 h-5 rounded-full overflow-hidden bg-slate-200">
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@res.UploaderId" alt="Author" />
                                </div>
                                <span class="font-medium truncate max-w-[100px] text-slate-500">@(res.Uploader?.FullName ?? "Member")</span>
                            </div>

                            <div class="flex items-center gap-2">
                                <button 
                                    @@click.stop="liked = !liked; likesCount = liked ? likesCount + 1 : likesCount - 1"
                                    :class="liked ? 'text-rose-500 font-bold' : ''"
                                    class="flex items-center gap-1 p-1 hover:text-rose-600 transition-all"
                                >
                                    <i data-lucide="thumbs-up" class="w-3.5 h-3.5" :class="liked ? 'fill-rose-500 text-rose-500' : ''"></i>
                                    <span x-text="likesCount"></span>
                                </button>

                                <button 
                                    @@click.stop="downloads++; window.showToast && window.showToast('Bắt đầu tải file tài liệu học tập của SmartLMS thành công!')"
                                    class="flex items-center gap-1 bg-slate-100 hover:bg-cyan-600 hover:text-white text-slate-600 px-2.5 py-1 rounded-lg font-bold transition-all"
                                >
                                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                                    <span x-text="downloads"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-1 md:col-span-2 bg-white border border-slate-100 rounded-2xl p-12 text-center text-slate-400 space-y-2">
                <i data-lucide="file" class="mx-auto text-slate-300 w-8 h-8"></i>
                <p class="font-bold">Không tìm thấy tài liệu phù hợp.</p>
                <p class="text-xs">Hãy sửa đổi nội dung tìm kiếm hoặc chuyển sang bộ lọc khác.</p>
            </div>
        }
    </div>

    <!-- TÍCH HỢP PREMIUM PDF VIEWER MODAL -->
    <template x-teleport="body">
        <div x-show="viewingPdf" 
             class="fixed inset-0 z-[9999] flex items-center justify-center p-4 sm:p-6 font-sans" 
             style="display: none;">
            
            <!-- Backdrop mờ tối -->
            <div class="absolute inset-0 bg-slate-900/90 backdrop-blur-md" 
                 x-show="viewingPdf" 
                 x-transition.opacity 
                 @@click="viewingPdf = false"></div>
                 
            <!-- Modal Content - Thiết kế Glassmorphism -->
            <div class="relative w-full max-w-6xl h-[92vh] bg-slate-900/80 backdrop-blur-xl rounded-3xl shadow-[0_0_50px_rgba(8,145,178,0.15)] overflow-hidden flex flex-col border border-slate-700/50"
                 x-show="viewingPdf" 
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95 translate-y-8"
                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                 x-transition:leave-end="opacity-0 scale-95 translate-y-8">
                 
                <!-- Ánh sáng trang trí glow -->
                <div class="absolute -top-40 -right-40 w-96 h-96 bg-cyan-500/20 rounded-full blur-[100px] pointer-events-none"></div>
                <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-500/20 rounded-full blur-[100px] pointer-events-none"></div>

                <!-- Header Document Viewer -->
                <div class="relative z-10 flex items-center justify-between px-6 py-4 bg-slate-900/50 border-b border-slate-700/50">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-rose-600 text-white flex items-center justify-center shadow-lg shadow-rose-500/30">
                            <i data-lucide="file-text" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-base font-black text-white leading-tight truncate max-w-2xl tracking-wide" x-text="currentPdfTitle">Loading...</h3>
                            <p class="text-[11px] text-cyan-400 font-bold tracking-widest uppercase mt-0.5 flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                                SmartLMS Secure Viewer
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <button class="flex items-center gap-2 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl transition-all font-bold text-xs shadow-sm border border-slate-600/50" title="Tải xuống">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">Tải về máy</span>
                        </button>
                        <button @@click="viewingPdf = false" class="p-2 bg-rose-500/10 text-rose-400 hover:text-white hover:bg-rose-500 rounded-xl transition-all" title="Đóng">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>

                <!-- Viewer Body -->
                <div class="relative z-10 flex-1 p-2 sm:p-6 overflow-hidden flex">
                    <!-- Khung Iframe hiển thị PDF -->
                    <div class="flex-1 bg-slate-800/50 rounded-2xl border border-slate-700/50 overflow-hidden shadow-inner relative flex flex-col">
                        <!-- Toolbar ảo của PDF -->
                        <div class="h-8 bg-slate-900 flex items-center justify-between px-4 border-b border-slate-700">
                            <div class="flex gap-1.5">
                                <div class="w-2.5 h-2.5 rounded-full bg-rose-500"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>
                                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
                            </div>
                            <span class="text-[9px] text-slate-500 font-mono tracking-widest">application/pdf</span>
                        </div>
                        <!-- Nội dung PDF -->
                        <iframe :src="currentPdfUrl" class="w-full flex-1 bg-white" frameborder="0"></iframe>
                    </div>

                    <!-- Side Panel Tương tác (Có thể bình luận tài liệu sau này) -->
                    <div class="hidden lg:flex w-80 ml-6 flex-col gap-4">
                        <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-5 backdrop-blur-sm">
                            <h4 class="text-xs font-black text-slate-300 uppercase tracking-widest mb-4">Thông tin file</h4>
                            <div class="space-y-3 text-xs text-slate-400">
                                <div class="flex justify-between"><span>Định dạng:</span><strong class="text-white">PDF Document</strong></div>
                                <div class="flex justify-between"><span>Kích thước:</span><strong class="text-white">3.5 MB</strong></div>
                                <div class="flex justify-between"><span>Quét mã độc:</span><strong class="text-emerald-400 flex items-center gap-1"><i data-lucide="shield-check" class="w-3 h-3"></i> An toàn</strong></div>
                            </div>
                        </div>

                        <div class="flex-1 bg-slate-800/50 border border-slate-700/50 rounded-2xl p-5 backdrop-blur-sm flex flex-col">
                            <h4 class="text-xs font-black text-slate-300 uppercase tracking-widest mb-4">Ghi chú học tập</h4>
                            <textarea class="flex-1 w-full bg-slate-900/50 border border-slate-700 rounded-xl p-3 text-xs text-slate-300 focus:outline-none focus:border-cyan-500 resize-none" placeholder="Ghi chú nhanh khi đọc tài liệu..."></textarea>
                            <button class="mt-3 w-full bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs py-2 rounded-xl transition-colors shadow-lg shadow-cyan-500/20">Lưu ghi chú</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</div>

<style>
    @@keyframes shimmer {
        100% { transform: translateX(100%); }
    }
</style>

<script>
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) { lucide.createIcons(); }
            }, 50);
        });
    });

    async function uploadResource() {
        // Collect form data
        const title = document.querySelector('input[placeholder*="Tiêu đề"]')?.value?.trim();
        const desc  = document.querySelector('textarea')?.value?.trim();
        
        if (!title) {
            window.showToast && window.showToast('⚠️ Vui lòng nhập tiêu đề tài liệu!');
            return;
        }

        try {
            const res = await fetch('/api/ResourceApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: title, description: desc, fileType: "PDF", subject: ".NET Development" })
            });

            if (res.ok) {
                const data = await res.json();
                window.showToast && window.showToast('✅ ' + data.message);
                setTimeout(() => location.reload(), 1500);
            } else if (res.status === 401) {
                window.location.href = '/Auth/Login?returnUrl=/hub/resources';
            } else {
                const err = await res.json();
                window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi tải lên tài liệu.'));
            }
        } catch {
            window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
        }
    }
</script>
