@model IEnumerable<SmartLMS.Models.CommunityResource>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Kho tài nguyên & Đề thi";
}

<!-- Thêm Alpine.js cho bộ lọc và modal -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ 
    ...shareManager(),
    isUploading: false, 
    uploadProgress: 0,
    isUploadingFile: false,
    activeSubject: 'All',
    activeFormat: 'All',
    searchQuery: '',
    viewingPdf: false, 
    currentPdfTitle: '', 
    currentPdfUrl: '',
    currentResourceId: null
}">
    
    <!-- Load Component Scripts -->
    <script defer src="/js/components/resource-discussion.js"></script>
    <script defer src="/js/components/premium-pdf-viewer.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    
    <!-- Hero Section -->
    <div class="relative rounded-3xl p-8 md:p-12 overflow-hidden bg-gradient-to-br from-indigo-900 via-cyan-800 to-slate-900 text-white shadow-2xl">
        <div class="absolute -right-20 -top-20 opacity-20 pointer-events-none">
            <svg class="w-96 h-96" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15 9L22 12L15 15L12 22L9 15L2 12L9 9L12 2Z"/></svg>
        </div>
        <div class="relative z-10 max-w-2xl">
            <span class="inline-block bg-orange-500 text-white text-xs font-bold px-3 py-1 rounded-full mb-4 shadow-lg shadow-orange-500/30 uppercase tracking-wider">Mạng lưới Tri thức</span>
            <h1 class="text-4xl md:text-5xl font-black mb-4 tracking-tight leading-tight">
                Khám phá Kho Tàng <br/>Tài Nguyên Chuyên Sâu
            </h1>
            <p class="text-lg opacity-80 mb-8 font-medium">
                Nơi hàng ngàn Developer chia sẻ Ebook, Source Code và Tài liệu học tập. Đánh giá, lưu trữ và chia sẻ để kiếm Viral XP!
            </p>
            <div class="flex gap-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button @@click="isUploading = !isUploading" class="bg-white text-cyan-900 hover:bg-slate-50 font-bold px-6 py-3 rounded-xl transition-all shadow-md flex items-center gap-2 group">
                        <img src="/images/frames/frame_attachment_file.svg" class="w-5 h-5 group-hover:-translate-y-1 transition-transform" />
                        Tải lên Tài liệu
                    </button>
                }
                else
                {
                    <a href="/Auth/Login?returnUrl=/hub/resources" class="bg-white text-cyan-900 hover:bg-slate-50 font-bold px-6 py-3 rounded-xl transition-all shadow-md flex items-center gap-2">
                        <img src="/images/icons/course_locked.svg" class="w-5 h-5" />
                        Đăng nhập để Tải lên
                    </a>
                }
                <button class="border border-white/30 text-white hover:bg-white/10 font-bold px-6 py-3 rounded-xl transition-colors">
                    Xem Bảng xếp hạng
                </button>
            </div>
        </div>
    </div>

    <!-- Search and filter header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex-1 w-full relative">
            <input type="text" x-model="searchQuery" placeholder="Tìm kiếm sách, tài liệu, code..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border-none rounded-xl text-sm font-medium text-slate-800 focus:ring-2 focus:ring-cyan-500 outline-none transition-all" />
            <img src="/images/icons/nav_search.svg" class="w-5 h-5 absolute left-3 top-3 opacity-50" />
        </div>
        
        <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mr-2 flex items-center gap-1">
                <img src="/images/icons/course_read_doc.svg" class="w-3.5 h-3.5 text-slate-400" /> Môn học:
            </span>
            <button @@click="activeSubject = 'All'" :class="activeSubject === 'All' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                Tất cả
            </button>
            <button @@click="activeSubject = '.NET Development'" :class="activeSubject === '.NET Development' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                .NET
            </button>
            <button @@click="activeSubject = 'Database Systems'" :class="activeSubject === 'Database Systems' ? 'bg-cyan-600 text-white shadow-sm' : 'bg-slate-50 text-slate-600 hover:bg-slate-100'" class="px-3 py-1.5 rounded-xl text-sm font-medium transition-all">
                Database
            </button>

            <!-- Pipe separator -->
            <div class="w-px h-6 bg-slate-200 mx-2 hidden lg:block"></div>

            <button @@click="activeFormat = 'All'" :class="activeFormat === 'All' ? 'text-indigo-600 bg-indigo-50 font-bold' : 'text-slate-400 hover:text-indigo-600'" class="text-xs px-2 py-1 rounded-md transition-all">Tất cả định dạng</button>
            <button @@click="activeFormat = 'PDF'" :class="activeFormat === 'PDF' ? 'text-indigo-600 bg-indigo-50 font-bold' : 'text-slate-400 hover:text-indigo-600'" class="text-xs px-2 py-1 rounded-md flex items-center gap-1 transition-all"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> PDFs</button>
            <button @@click="activeFormat = 'ZIP'" :class="activeFormat === 'ZIP' ? 'text-indigo-600 bg-indigo-50 font-bold' : 'text-slate-400 hover:text-indigo-600'" class="text-xs px-2 py-1 rounded-md flex items-center gap-1 transition-all"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Source Code</button>
        </div>
    </div>

    <!-- Upload Slide Panel -->
    <div 
        x-show="isUploading"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        class="overflow-hidden" style="display: none;"
    >
        <form class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                    <img src="/images/frames/frame_post_create.svg" class="w-4 h-4" onerror="this.src='/images/icons/social_share.svg'" />
                    Chia sẻ tài liệu & Đề thi thử
                </h3>
                <button type="button" @@click="isUploading = false" class="text-xs text-slate-400 hover:text-slate-600 font-bold">
                    Hủy bỏ
                </button>
            </div>

            <div class="space-y-3">
                <input type="text" required placeholder="Tiêu đề tài liệu (ví dụ: Tổng hợp đề thi thử DSA kỳ 1 năm 2025)" class="w-full bg-slate-50 border-none rounded-xl px-4 py-3 text-slate-800 font-medium placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 transition-all text-sm" />

                <textarea required placeholder="Mô tả nội dung tài liệu, cách tải hoặc tóm tắt các điểm quan trọng..." rows="3" class="w-full bg-slate-50 border-none rounded-xl p-4 text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all text-sm"></textarea>

                <div class="grid grid-cols-4 gap-3">
                    <div class="col-span-2 space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Môn học / Lĩnh vực</label>
                        <select class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value=".NET Development">.NET Development</option>
                            <option value="Database Systems">Database Systems</option>
                            <option value="General Info">General Info</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">Định dạng</label>
                        <select class="w-full bg-slate-50 border-none text-sm px-4 py-2.5 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500">
                            <option value="PDF">PDF</option>
                            <option value="DOCX">DOCX</option>
                            <option value="ZIP">ZIP</option>
                        </select>
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-semibold text-slate-400">File tài liệu</label>
                        <input type="file" id="uploadFile" accept=".pdf,.docx,.zip" class="w-full bg-slate-50 border-none text-sm px-4 py-2 rounded-xl text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500" />
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-2 items-center gap-4">
                <!-- Progress bar area -->
                <div x-show="isUploadingFile" class="flex-1 max-w-xs flex items-center gap-2" style="display: none;">
                    <div class="w-full bg-slate-100 rounded-full h-2.5">
                        <div class="bg-cyan-600 h-2.5 rounded-full transition-all duration-300" :style="`width: ${uploadProgress}%`"></div>
                    </div>
                    <span class="text-xs font-bold text-slate-500" x-text="`${uploadProgress}%`"></span>
                </div>

                <button type="button" @@click="uploadResource()" :disabled="isUploadingFile" :class="isUploadingFile ? 'bg-slate-400 cursor-not-allowed' : 'bg-cyan-600 hover:bg-cyan-700 active:scale-95 shadow-md'" class="text-white font-bold text-sm px-6 py-2 rounded-xl transition-all">
                    <span x-show="!isUploadingFile">Xác nhận tải lên</span>
                    <span x-show="isUploadingFile" class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Đang tải lên...
                    </span>
                </button>
            </div>
        </form>
    </div>

    <!-- Grid of Resources -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @if (Model != null && Model.Any())
        {
            foreach (var res in Model)
            {
                var titleEscaped = Uri.EscapeDataString(res.Title ?? "");
                <div 
                    x-show="(activeSubject === 'All' || activeSubject === '@res.Subject') && (activeFormat === 'All' || activeFormat === '@res.FileType') && ('@res.Title.ToLower()'.includes(searchQuery.toLowerCase()) || '@res.Description?.ToLower()'.includes(searchQuery.toLowerCase()))"
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 scale-95"
                    x-transition:enter-end="opacity-100 scale-100"
                    class="bg-white rounded-2xl border border-slate-100 flex flex-col hover:shadow-xl hover:border-cyan-200 transition-all group overflow-hidden"
                    x-data="{ 
                        isBookmarked: @(res.IsBookmarkedByCurrentUser.ToString().ToLower()),
                        myRating: @res.CurrentUserRating,
                        downloads: @res.DownloadCount,
                        views: @res.ViewCount,
                        voteCount: @res.VoteCount,
                        avgRating: @res.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
                    }"
                >
                    <!-- Header Cover (Thay vì Card ngang, làm Card dọc có banner) -->
                    <div class="h-28 bg-gradient-to-r from-slate-100 to-indigo-50 relative p-4 flex justify-between items-start">
                        <span class="bg-cyan-600 text-white text-[10px] font-bold px-3 py-1 rounded-full shadow-sm">@res.Subject</span>
                        <div class="flex gap-2">
                            <!-- Bookmark & Share buttons -->
                            <button @@click.stop="toggleBookmark(@res.Id)" class="p-2 bg-white rounded-full shadow-sm hover:scale-110 transition-transform" title="Lưu vào Bookmark">
                                <img src="/images/icons/course_bookmark.svg" class="w-4 h-4 transition-all" :class="isBookmarked ? 'opacity-100 drop-shadow-[0_0_4px_rgba(6,182,212,0.8)]' : 'opacity-40'" />
                            </button>
                            <button @@click.stop="openShare('RESOURCE', @res.Id)" class="p-2 bg-white rounded-full shadow-sm hover:scale-110 transition-transform" title="Chia sẻ tài liệu">
                                <img src="/images/icons/social_share.svg" class="w-4 h-4" />
                            </button>
                        </div>
                        
                        <!-- File Type Icon nổi ở góc trái có hiệu ứng glow -->
                        <div class="absolute -bottom-6 left-5 w-12 h-14 bg-white rounded-xl shadow-md flex flex-col items-center justify-center border border-slate-100 text-cyan-600 font-black group-hover:shadow-cyan-100 group-hover:shadow-lg transition-shadow">
                            <img
                                src="/images/icons/@(res.FileType?.ToUpper() == "PDF" ? "course_read_doc" : res.FileType?.ToUpper() == "ZIP" ? "course_code_challenge" : "course_read_doc").svg"
                                class="w-5 h-5 mb-0.5"
                                onerror="this.src='/images/icons/course_read_doc.svg'"
                            />
                            <span class="text-[9px] uppercase tracking-wider">@(res.FileType ?? "PDF")</span>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="p-5 pt-8 flex-1 flex flex-col">
                        <a href="/hub/resources/@res.Id"
                            class="font-extrabold text-slate-800 text-lg mb-2 leading-snug hover:text-cyan-600 transition-colors cursor-pointer line-clamp-2">
                            @res.Title
                        </a>
                        
                        <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed flex-1 mb-4">
                            @res.Description
                        </p>

                        <!-- Thống kê (Stars & Views) -->
                        <div class="bg-slate-50 rounded-xl p-3 mb-4 border border-slate-100 flex items-center justify-between">
                            <div class="flex items-center gap-1 group/rating relative">
                                <!-- Star Rating -->
                                <template x-for="i in 5">
                                    <svg @@click="submitRate(@res.Id, i)" class="w-4 h-4 cursor-pointer hover:scale-125 transition-transform" :class="(myRating >= i || (myRating === 0 && avgRating >= i)) ? 'text-amber-400 fill-amber-400' : 'text-slate-300'" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                                </template>
                                <span class="text-xs font-bold text-slate-500 ml-1">(<span x-text="voteCount"></span>)</span>
                            </div>
                            
                            <div class="flex items-center gap-3 text-slate-400">
                                <span class="flex items-center gap-1 text-xs font-bold">
                                    <img src="/images/icons/nav_profile.svg" class="w-4 h-4 opacity-50" />
                                    <span x-text="views"></span>
                                </span>
                                <span class="flex items-center gap-1 text-xs font-bold text-indigo-500">
                                    <img src="/images/icons/course_download.svg" class="w-4 h-4" />
                                    <span x-text="downloads"></span>
                                </span>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="flex items-center justify-between mt-auto">
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded-full overflow-hidden bg-slate-200">
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@res.UploaderId" alt="Author" />
                                </div>
                                <span class="font-bold text-xs text-slate-600 truncate max-w-[120px]">@(res.Uploader?.FullName ?? "Member")</span>
                            </div>
                            <a href="/hub/resources/@res.Id" class="bg-cyan-50 hover:bg-cyan-600 hover:text-white text-cyan-700 px-4 py-1.5 rounded-lg text-xs font-bold transition-all flex items-center gap-1.5 group/btn">
                                <img src="/images/icons/course_read_doc.svg" class="w-3.5 h-3.5 group-hover/btn:brightness-200 transition-all" />
                                Mở xem
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Empty State: Dùng illustration SVG thay vì icon nhỏ -->
            <div class="col-span-1 md:col-span-2 bg-white border border-slate-100 rounded-2xl p-12 text-center text-slate-400 space-y-4">
                <img src="/images/frames/illu_empty_feed.svg" class="w-20 h-20 mx-auto opacity-60" onerror="this.src='/images/frames/illu_empty_cart.svg'" />
                <p class="font-bold text-slate-500">Chưa có tài liệu nào.</p>
                <p class="text-sm text-slate-400">Hãy là người đầu tiên chia sẻ kiến thức!</p>
            </div>
        }
    </div>



    <!-- Share Modal -->
    <div x-show="isOpen" class="fixed inset-0 z-[10000] flex items-center justify-center bg-black/50 backdrop-blur-sm" style="display: none;" x-transition>
        <div @@click.away="isOpen = false" class="bg-white rounded-3xl w-full max-w-md p-8 space-y-5 shadow-2xl">
            <h3 class="text-xl font-black text-slate-800 flex items-center gap-2">
                <img src="/images/icons/social_share.svg" class="w-5 h-5 text-indigo-600" /> Chuyển tiếp tài liệu
            </h3>
            
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gửi đến</label>
                <select x-model="targetType" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-bold text-slate-700">
                    <option value="Group">Một nhóm học (Group)</option>
                    <option value="User">Tin nhắn cá nhân (User)</option>
                </select>
            </div>
            
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">ID Người nhận / Nhóm</label>
                <input type="number" x-model="targetId" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-bold text-slate-700" placeholder="Nhập ID...">
            </div>
            
            <div class="space-y-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Lời nhắn (Tùy chọn)</label>
                <textarea x-model="message" rows="2" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 text-sm placeholder-slate-400 resize-none" placeholder="Hãy xem tài liệu này..."></textarea>
            </div>
            
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                <button @@click="isOpen = false" class="px-5 py-2.5 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-xl transition-colors">Hủy</button>
                <button @@click="submitShare" :disabled="isSharing" class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 disabled:bg-slate-400 transition-colors font-bold shadow-md flex items-center gap-2">
                    <img src="/images/icons/social_share.svg" class="w-4 h-4 brightness-200" />
                    <span x-text="isSharing ? 'Đang gửi...' : 'Gửi đi'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    async function uploadResource() {
        const title = document.querySelector('input[placeholder*="Tiêu đề"]')?.value?.trim();
        const desc  = document.querySelector('textarea')?.value?.trim();
        const subject = document.querySelector('select')?.value || '.NET Development';
        const fileInput = document.getElementById('uploadFile');
        const file = fileInput?.files[0];
        
        if (!title || !file) {
            window.showToast && window.showToast('⚠️ Vui lòng nhập tiêu đề và chọn file!');
            return;
        }

        const formData = new FormData();
        formData.append('Title', title);
        formData.append('Description', desc);
        formData.append('Subject', subject);
        formData.append('FileType', file.name.split('.').pop().toUpperCase());
        formData.append('File', file);

        // Sử dụng Alpine data context
        const alpineData = Alpine.$data(document.querySelector('[x-data]'));
        alpineData.isUploadingFile = true;
        alpineData.uploadProgress = 0;

        try {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/CommunityApi/ResourceApi', true);
            
            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    alpineData.uploadProgress = Math.round((e.loaded / e.total) * 100);
                }
            };
            
            xhr.onload = function() {
                alpineData.isUploadingFile = false;
                if (xhr.status >= 200 && xhr.status < 300) {
                    const data = JSON.parse(xhr.responseText);
                    window.showToast && window.showToast('✅ ' + data.message);
                    setTimeout(() => location.reload(), 1500);
                } else if (xhr.status === 401) {
                    window.location.href = '/Auth/Login?returnUrl=/hub/resources';
                } else {
                    let err = "Lỗi tải lên.";
                    try { err = JSON.parse(xhr.responseText).message || err; } catch(e){}
                    window.showToast && window.showToast('❌ ' + err);
                }
            };
            
            xhr.onerror = function() {
                alpineData.isUploadingFile = false;
                window.showToast && window.showToast('❌ Lỗi kết nối.');
            };
            
            xhr.send(formData);
        } catch {
            alpineData.isUploadingFile = false;
            window.showToast && window.showToast('❌ Lỗi không xác định.');
        }
    }

    function shareManager() {
        return {
            isOpen: false, isSharing: false, contentType: '', contentId: 0,
            targetType: 'Group', targetId: '', message: '',

            openShare(type, id) {
                this.contentType = type; this.contentId = id;
                this.isOpen = true; this.targetId = ''; this.message = '';
            },

            async submitShare() {
                if (!this.targetId) return;
                this.isSharing = true;
                try {
                    const res = await fetch('/api/ShareApi/share', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            targetType: this.targetType, targetId: parseInt(this.targetId),
                            contentType: this.contentType, contentId: this.contentId, message: this.message
                        })
                    });
                    if (res.ok) {
                        this.isOpen = false;
                        window.showToast && window.showToast('✅ Đã chia sẻ thành công!');
                    } else if (res.status === 401) window.location.href = '/Auth/Login';
                    else window.showToast && window.showToast('❌ Lỗi chia sẻ.');
                } finally { this.isSharing = false; }
            },

            // New API methods
            async toggleBookmark(id) {
                try {
                    const res = await fetch(`/CommunityApi/ResourceApi/${id}/bookmark`, { method: 'POST' });
                    if (res.ok) {
                        this.isBookmarked = !this.isBookmarked;
                        window.showToast && window.showToast('✅ Đã cập nhật bộ sưu tập');
                    } else if (res.status === 401) window.location.href = '/Auth/Login';
                } catch(e) {}
            },

            async submitRate(id, score) {
                try {
                    const res = await fetch(`/CommunityApi/ResourceApi/${id}/rate`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ score: score })
                    });
                    if (res.ok) {
                        this.myRating = score;
                        this.voteCount++;
                        window.showToast && window.showToast(`✅ Đã đánh giá ${score} sao!`);
                    } else if (res.status === 401) window.location.href = '/Auth/Login';
                } catch(e) {}
            },

            async recordView(id) {
                try {
                    await fetch(`/CommunityApi/ResourceApi/${id}/view`, { method: 'POST' });
                    this.views++;
                } catch(e) {}
            }
        };
    }
</script>
