@model IEnumerable<SmartLMS.Models.CommunityQuestion>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Q&A Section";
}

<div class="space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Q&A Hub</h2>
            <p class="text-slate-500">Get answers from mentors and the community.</p>
        </div>
        <button class="bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Ask a Question
        </button>
    </div>

    <!-- Stats Bar -->
    <div class="flex gap-4">
        <button class="flex-1 glass-card p-4 rounded-2xl border-l-4 border-cyan-500 hover:bg-cyan-50 transition-all text-left">
            <span class="text-xs font-bold text-slate-400 uppercase">Total Questions</span>
            <p class="text-2xl font-black text-slate-800">@Model.Count()</p>
        </button>
        <button class="flex-1 glass-card p-4 rounded-2xl border-l-4 border-green-500 hover:bg-green-50 transition-all text-left">
            <span class="text-xs font-bold text-slate-400 uppercase">Solved</span>
            <p class="text-2xl font-black text-slate-800">@Model.Count(q => q.Status == "Solved")</p>
        </button>
        <button class="flex-1 glass-card p-4 rounded-2xl border-l-4 border-red-500 hover:bg-red-50 transition-all text-left">
            <span class="text-xs font-bold text-slate-400 uppercase">Unsolved</span>
            <p class="text-2xl font-black text-slate-800">@Model.Count(q => q.Status == "Unsolved")</p>
        </button>
    </div>

    <!-- Question List -->
    <div class="space-y-4">
        @foreach (var q in Model)
        {
            <div class="glass-card rounded-2xl p-6 hover:shadow-lg transition-all group">
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-slate-200 overflow-hidden">
                            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@q.AuthorId" alt="Author">
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-800">@(q.Author?.FullName ?? "Unknown User")</p>
                            <p class="text-[10px] text-slate-400 font-bold uppercase">@q.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                    @if(q.Status == "Solved") {
                        <span class="bg-green-100 text-green-600 text-[10px] font-black uppercase px-3 py-1 rounded-full flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>
                            Solved
                        </span>
                    } else {
                        <span class="bg-red-100 text-red-600 text-[10px] font-black uppercase px-3 py-1 rounded-full">Unsolved</span>
                    }
                </div>

                <h4 class="text-xl font-bold text-slate-800 group-hover:text-cyan-600 transition-all mb-2">@q.Title</h4>
                <p class="text-slate-500 text-sm line-clamp-2 mb-4">@q.Content</p>

                <div class="flex justify-between items-center pt-4 border-t border-slate-100">
                    <div class="flex gap-4">
                        <span class="text-xs font-bold text-slate-400 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                            @q.Answers.Count Answers
                        </span>
                        @if(q.Answers.Any(a => a.IsVerified)) {
                            <span class="text-xs font-bold text-blue-500 flex items-center gap-1">
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                                Expert Verified
                            </span>
                        }
                    </div>
                    <button class="text-cyan-600 font-bold text-sm hover:underline">View Discussion &rarr;</button>
                </div>
            </div>
        }
    </div>
</div>
