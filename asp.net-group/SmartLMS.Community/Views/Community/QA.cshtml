@model IEnumerable<SmartLMS.Models.CommunityQuestion>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Chuyên mục Hỏi & Đáp";
}

<!-- Thêm Alpine.js cho các hiệu ứng tương tác Dropdown/Modal -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ isAsking: false, expandedQuestionId: null }">
    <!-- Q&A section action header -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-2">
            <i data-lucide="help-circle" class="w-4 h-4 text-cyan-500 animate-pulse"></i>
            <span class="text-sm font-semibold text-slate-700">Chuyên mục Hỏi & Đáp học tập</span>
        </div>

        <button 
            @@click="isAsking = !isAsking"
            class="flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Đặt câu hỏi cho Hub
        </button>
    </div>

    <!-- Ask question form overlay slide -->
    <div 
        x-show="isAsking" 
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="overflow-hidden" style="display: none;"
    >
        <form class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm">Đặt câu hỏi học hỏi</h3>
                <button type="button" @@click="isAsking = false" class="text-xs text-slate-400 hover:text-slate-600 font-bold">
                    Hủy bỏ
                </button>
            </div>

            <div class="space-y-3">
                <input type="text" required placeholder="Tiêu đề câu hỏi ngắn gọn (Ví dụ: Tại sao EF Core báo lỗi Tracking behavior?)" class="w-full bg-slate-50 border-none rounded-xl px-4 py-3 text-slate-800 font-medium placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 transition-all text-sm" />
                <textarea required placeholder="Mô tả lỗi của bạn, đính kèm code block hoặc các bước xảy ra vấn đề..." rows="4" class="w-full bg-slate-50 border-none rounded-xl p-4 text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all text-sm font-mono"></textarea>
                
                <div class="space-y-1">
                    <label class="text-xs font-semibold text-slate-400">Từ khóa ngăn cách bằng dấu phẩy (,)</label>
                    <input type="text" required placeholder="e.g. C#, ASP.NET Core, EF Core" class="w-full bg-slate-50 border-none rounded-xl px-3.5 py-2.5 text-sm text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500" />
                </div>
            </div>

            <div class="flex justify-end pt-1">
                <button type="button" @@click="isAsking = false; window.showToast && window.showToast('Đã ghi nhận câu hỏi, chờ admin phê duyệt!')" class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-sm px-6 py-2 rounded-xl transition-all shadow-md active:scale-95">
                    Đăng câu hỏi
                </button>
            </div>
        </form>
    </div>

    <!-- Questions Stack -->
    <div class="space-y-4">
        @if (Model != null && Model.Any())
        {
            foreach (var q in Model)
            {
                var isSolved = q.Status == "Solved";
                var borderColor = isSolved ? "border-emerald-100/80 bg-emerald-50/10" : "border-slate-100 bg-white";
                
                <div class="rounded-2xl border p-6 transition-all shadow-sm @borderColor">
                    <div class="flex gap-4">
                        
                        <!-- Main body content -->
                        <div class="flex-1 min-w-0 space-y-2">
                            <div class="flex items-center justify-between gap-2 flex-wrap text-xs text-slate-400">
                                <div class="flex items-center gap-1.5 font-medium">
                                    <div class="w-5 h-5 rounded-full overflow-hidden bg-slate-100">
                                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@q.AuthorId" alt="@q.Author?.FullName" />
                                    </div>
                                    <span class="font-bold text-slate-700">@(q.Author?.FullName ?? "Unknown User")</span>
                                    <span class="text-[8px] font-bold px-1 py-0.5 rounded border scale-90 bg-cyan-50 text-cyan-700 border-cyan-100 uppercase">
                                        Member
                                    </span>
                                    <span>&#183;</span>
                                    <span>Hỏi cách đây @q.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>

                                @if (isSolved)
                                {
                                    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1 border border-emerald-200">
                                        <i data-lucide="check-circle" class="w-3 h-3"></i> Đã giải quyết
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-amber-200">
                                        Chờ trả lời
                                    </span>
                                }
                            </div>

                            <h4 class="font-bold text-slate-800 text-base leading-snug hover:text-cyan-600 cursor-pointer transition-colors flex items-center gap-1.5"
                                @@click="expandedQuestionId = expandedQuestionId === @q.Id ? null : @q.Id">
                                @q.Title
                                <span class="text-[10px] text-cyan-500 font-bold opacity-100 transition-opacity">
                                    (Mở bài thảo luận chuyên sâu &rarr;)
                                </span>
                            </h4>

                            <p class="text-slate-600 text-xs font-mono leading-relaxed truncate max-h-6">
                                @q.Content
                            </p>
                        </div>
                    </div>

                    <!-- Sub-Answers Panel details toggling -->
                    <div class="mt-4 pt-4 border-t border-slate-50 flex items-center justify-between text-xs font-bold text-slate-500">
                        <button @@click="expandedQuestionId = expandedQuestionId === @q.Id ? null : @q.Id" class="flex items-center gap-1.5 text-cyan-600 hover:text-cyan-700">
                            <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                            <span>@(q.Answers?.Count ?? 0) Câu trả lời</span>
                        </button>

                        <button @@click="expandedQuestionId = expandedQuestionId === @q.Id ? null : @q.Id" class="text-slate-400 hover:underline">
                            <span x-text="expandedQuestionId === @q.Id ? 'Thu gọn chi tiết' : 'Xem & Trả lời câu hỏi'"></span>
                        </button>
                    </div>

                    <!-- EXPANDED PANEL OF DETAILS -->
                    <div 
                        x-show="expandedQuestionId === @q.Id"
                        x-transition:enter="transition ease-out duration-200"
                        x-transition:enter-start="opacity-0 -translate-y-2"
                        x-transition:enter-end="opacity-100 translate-y-0"
                        class="overflow-hidden mt-4 pt-4 border-t border-slate-100 space-y-4" style="display: none;"
                    >
                        <div class="bg-slate-50/50 p-4 rounded-xl border border-slate-50 text-sm text-slate-700 font-mono whitespace-pre-wrap leading-relaxed">
                            @q.Content
                        </div>

                        <!-- Answers Stack -->
                        @if (q.Answers != null && q.Answers.Any())
                        {
                            <div class="space-y-4 pt-2">
                                <h5 class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Danh sách phản hồi</h5>
                                @foreach (var ans in q.Answers)
                                {
                                    <div class="p-4 rounded-xl border flex gap-3 @(ans.IsVerified ? "bg-emerald-50/40 border-emerald-100/80" : "bg-white border-slate-100")">
                                        <div class="flex flex-col items-center shrink-0">
                                            <button class="p-1 rounded hover:bg-slate-100 text-slate-400"><i data-lucide="chevron-up" class="w-4 h-4"></i></button>
                                            <span class="text-[11px] font-bold text-slate-600">@ans.Votes</span>
                                            <button class="p-1 rounded hover:bg-slate-100 text-slate-400"><i data-lucide="chevron-down" class="w-4 h-4"></i></button>
                                        </div>

                                        <div class="flex-1 min-w-0 space-y-2">
                                            <div class="flex items-center justify-between gap-1.5 flex-wrap text-[10px] text-slate-400">
                                                <div class="flex items-center gap-1.5">
                                                    <div class="w-5 h-5 rounded-full overflow-hidden bg-slate-100">
                                                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@ans.AuthorId" alt="@ans.Author?.FullName" />
                                                    </div>
                                                    <span class="font-bold text-slate-700">@(ans.Author?.FullName ?? "Unknown User")</span>
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    <span class="text-[10px] text-slate-400">@ans.CreatedAt.ToString("dd/MM/yyyy")</span>
                                                    @if(ans.IsVerified) {
                                                        <button class="px-2 py-0.5 rounded-md font-bold text-[9px] uppercase tracking-wider transition-all bg-emerald-600 text-white">
                                                            ✓ Tốt nhất
                                                        </button>
                                                    } else {
                                                        <button class="px-2 py-0.5 rounded-md font-bold text-[9px] uppercase tracking-wider transition-all bg-slate-100 hover:bg-emerald-50 text-slate-500 hover:text-emerald-700">
                                                            Xác nhận Giải Pháp
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <p class="text-slate-600 text-xs font-mono whitespace-pre-wrap leading-relaxed bg-white p-3 rounded-xl border border-slate-50">
                                                @ans.Content
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="space-y-2 pt-2">
                            <label class="text-xs font-bold text-slate-400">Viết câu trả lời của bạn</label>
                            <div class="flex gap-2 items-end">
                                <textarea placeholder="Nhập câu trả lời kỹ thuật chi tiết tại đây (hỗ trợ code)..." rows="2" class="flex-1 bg-slate-50 border border-slate-100 p-3 rounded-xl text-xs outline-none focus:ring-2 focus:ring-cyan-500 placeholder-slate-400 font-mono resize-none"></textarea>
                                <button type="button" @@click="window.showToast && window.showToast('Gửi câu trả lời thành công!')" class="bg-cyan-600 hover:bg-cyan-700 text-white p-3.5 rounded-xl transition-all shadow active:scale-95 shrink-0">
                                    <i data-lucide="send" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white border border-slate-100 rounded-2xl p-12 text-center text-slate-400 space-y-2">
                <i data-lucide="alert-circle" class="mx-auto text-slate-300 w-8 h-8"></i>
                <p class="font-bold">Không tìm thấy câu hỏi học môn học này.</p>
                <p class="text-xs">Hãy chuyển đổi bộ lọc tìm kiếm hoặc tự đặt một câu hỏi mới!</p>
            </div>
        }
    </div>
</div>

<script>
    // Xử lý re-render Lucide icons khi Alpine JS render khối DOM mới
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) {
                    lucide.createIcons();
                }
            }, 50);
        });
    });
</script>
