@model IEnumerable<SmartLMS.Models.CommunityQuestion>
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = "Chuyên mục Hỏi & Đáp";
}

<!-- Thêm Alpine.js cho các hiệu ứng tương tác Dropdown/Modal -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="space-y-6" x-data="{ isAsking: false, expandedQuestionId: null }">
    <!-- Q&A section action header -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-2">
            <img src="/images/icons/badge_verified_answer.svg" class="w-4 h-4 text-cyan-500 animate-pulse" />
            <span class="text-sm font-semibold text-slate-700">Chuyên mục Hỏi & Đáp học tập</span>
        </div>

        <button 
            @@click="isAsking = !isAsking"
            class="flex items-center gap-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-bold px-4 py-2 rounded-xl transition-all shadow-md active:scale-95"
        >
            <i data-lucide="plus" class="w-4 h-4"></i>
            Đặt câu hỏi cho Hub
        </button>
    </div>

    <!-- Ask question form overlay slide -->
    <div 
        x-show="isAsking" 
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="overflow-hidden" style="display: none;"
    >
        <form class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-4">
            <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                <h3 class="font-bold text-slate-800 text-sm">Đặt câu hỏi học hỏi</h3>
                <button type="button" @@click="isAsking = false" class="text-xs text-slate-400 hover:text-slate-600 font-bold">
                    Hủy bỏ
                </button>
            </div>

            <div class="space-y-3">
                <input type="text" id="qa-title" required placeholder="Tiêu đề câu hỏi ngắn gọn (Ví dụ: Tại sao EF Core báo lỗi Tracking behavior?)" class="w-full bg-slate-50 border-none rounded-xl px-4 py-3 text-slate-800 font-medium placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 transition-all text-sm" />
                <textarea id="qa-content" required placeholder="Mô tả lỗi của bạn, đính kèm code block hoặc các bước xảy ra vấn đề..." rows="4" class="w-full bg-slate-50 border-none rounded-xl p-4 text-slate-800 placeholder-slate-400 outline-none focus:ring-2 focus:ring-cyan-500 resize-none transition-all text-sm font-mono"></textarea>
                
                <div class="space-y-1">
                    <label class="text-xs font-semibold text-slate-400">Từ khóa ngăn cách bằng dấu phẩy (,)</label>
                    <input type="text" id="qa-tags" required placeholder="e.g. C#, ASP.NET Core, EF Core" class="w-full bg-slate-50 border-none rounded-xl px-3.5 py-2.5 text-sm text-slate-700 outline-none focus:ring-2 focus:ring-cyan-500" />
                </div>
            </div>

            <div class="flex justify-end pt-1">
                <button type="button" id="btn-submit-qa"
                    @@click="submitQuestion()"
                    class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-sm px-6 py-2 rounded-xl transition-all shadow-md active:scale-95">
                    Đăng câu hỏi
                </button>
            </div>
        </form>
    </div>

    <!-- Questions Stack -->
    <div class="space-y-4">
        @if (Model != null && Model.Any())
        {
            foreach (var q in Model)
            {
                var isSolved = q.Status == "Solved";
                var borderColor = isSolved ? "border-emerald-100/80 bg-emerald-50/10" : "border-slate-100 bg-white";
                
                <div class="rounded-2xl border p-6 transition-all shadow-sm @borderColor">
                    <div class="flex gap-4">
                        
                        <!-- Main body content -->
                        <div class="flex-1 min-w-0 space-y-2">
                            <div class="flex items-center justify-between gap-2 flex-wrap text-xs text-slate-400">
                                <div class="flex items-center gap-1.5 font-medium">
                                    <div class="w-5 h-5 rounded-full overflow-hidden bg-slate-100">
                                        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@q.AuthorId" alt="@q.Author?.FullName" />
                                    </div>
                                    <span class="font-bold text-slate-700">@(q.Author?.FullName ?? "Unknown User")</span>
                                    <span class="text-[8px] font-bold px-1 py-0.5 rounded border scale-90 bg-cyan-50 text-cyan-700 border-cyan-100 uppercase">
                                        Member
                                    </span>
                                    <span>&#183;</span>
                                    <span>Hỏi cách đây @q.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>

                                @if (isSolved)
                                {
                                    <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full flex items-center gap-1 border border-emerald-200">
                                        <img src="/images/icons/course_completed.svg" class="w-3 h-3" /> Đã giải quyết
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-amber-200">
                                        Chờ trả lời
                                    </span>
                                }
                            </div>

                            <a href="/hub/qa/@q.Id" class="font-bold text-slate-800 text-base leading-snug hover:text-cyan-600 transition-colors flex items-center gap-1.5 w-max group/qa block">
                                @q.Title
                                <span class="text-[10px] text-cyan-500 font-bold opacity-0 group-hover/qa:opacity-100 transition-opacity whitespace-nowrap">
                                    (Mở bài thảo luận chuyên sâu &rarr;)
                                </span>
                            </a>

                            <p class="text-slate-600 text-xs font-mono leading-relaxed truncate max-h-6">
                                @q.Content
                            </p>
                        </div>
                    </div>

                    <!-- Sub-Answers Panel details toggling -->
                    <div class="mt-4 pt-4 border-t border-slate-50 flex items-center justify-between text-xs font-bold text-slate-500">
                        <a href="/hub/qa/@q.Id" class="flex items-center gap-1.5 text-cyan-600 hover:text-cyan-700">
                            <img src="/images/icons/comment_reply.svg" class="w-3.5 h-3.5" />
                            <span>@(q.Answers?.Count ?? 0) Câu trả lời</span>
                        </a>

                        <a href="/hub/qa/@q.Id" class="text-slate-400 hover:underline">
                            <span>Xem & Trả lời câu hỏi</span>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white border border-slate-100 rounded-2xl p-12 text-center text-slate-400 space-y-2">
                <i data-lucide="alert-circle" class="mx-auto text-slate-300 w-8 h-8"></i>
                <p class="font-bold">Không tìm thấy câu hỏi học môn học này.</p>
                <p class="text-xs">Hãy chuyển đổi bộ lọc tìm kiếm hoặc tự đặt một câu hỏi mới!</p>
            </div>
        }
    </div>
</div>

<script>
    // Xử lý re-render Lucide icons khi Alpine JS render khối DOM mới
    document.addEventListener('alpine:initialized', () => {
        Alpine.effect(() => {
            setTimeout(() => {
                if(window.lucide) { lucide.createIcons(); }
            }, 50);
        });
    });

    // Lấy AntiForgery token từ cookie (cho POST requests)
    function getToken() {
        return document.querySelector('[name="__RequestVerificationToken"]')?.value || '';
    }

    // Gửi câu hỏi mới lên API
    async function submitQuestion() {
        const title   = document.getElementById('qa-title')?.value?.trim();
        const content = document.getElementById('qa-content')?.value?.trim();
        const tags    = document.getElementById('qa-tags')?.value?.trim();

        if (!title || !content) {
            window.showToast && window.showToast('⚠️ Vui lòng nhập tiêu đề và nội dung!');
            return;
        }

        try {
            const res = await fetch('/api/QaApi/questions', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ title, content, tags }),
            });

            if (res.ok) {
                window.showToast && window.showToast('✅ Câu hỏi đã được gửi! Trang sẽ tải lại...');
                setTimeout(() => location.reload(), 1500);
            } else if (res.status === 401) {
                window.location.href = '/Auth/Login?returnUrl=/hub/qa';
            } else {
                const err = await res.json();
                window.showToast && window.showToast('❌ ' + (err.message || 'Lỗi gửi câu hỏi'));
            }
        } catch {
            window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
        }
    }

    // Gửi câu trả lời
    async function submitAnswer(questionId) {
        const textarea = document.querySelector(`[data-qid="${questionId}"] textarea`);
        const content  = textarea?.value?.trim();

        if (!content) {
            window.showToast && window.showToast('⚠️ Vui lòng nhập nội dung câu trả lời!');
            return;
        }

        try {
            const res = await fetch(`/api/QaApi/questions/${questionId}/answers`, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ content }),
            });

            if (res.ok) {
                window.showToast && window.showToast('✅ Câu trả lời đã được gửi!');
                textarea.value = '';
            } else if (res.status === 401) {
                window.location.href = '/Auth/Login?returnUrl=/hub/qa';
            } else {
                window.showToast && window.showToast('❌ Lỗi gửi câu trả lời.');
            }
        } catch {
            window.showToast && window.showToast('❌ Lỗi kết nối máy chủ.');
        }
    }
</script>
