@model SmartLMS.Models.User
@{
    Layout = "_CommunityLayout";
    ViewData["Title"] = $"Hồ sơ của {Model.FullName}";
    
    var recentPosts = ViewBag.RecentPosts as IEnumerable<SmartLMS.Models.Post> ?? new List<SmartLMS.Models.Post>();
    var badges = ViewBag.Badges as IEnumerable<SmartLMS.Models.UserBadge> ?? new List<SmartLMS.Models.UserBadge>();
    int totalEXP = ViewBag.TotalEXP ?? 0;
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header Card -->
    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-100 relative">
        <div class="h-32 bg-gradient-to-r from-cyan-500 to-blue-600"></div>
        <div class="px-8 pb-8 relative">
            <!-- Avatar -->
            <div class="absolute -top-12 border-4 border-white rounded-full bg-white shadow-md">
                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.FullName ?? "U")&size=96&background=random" class="w-24 h-24 rounded-full object-cover" alt="Avatar" />
            </div>
            
            <div class="mt-14 flex justify-between items-start">
                <div>
                    <h1 class="text-2xl font-black text-slate-800">@Model.FullName</h1>
                    <p class="text-sm text-cyan-600 font-bold uppercase tracking-wider mt-1">@Model.Role</p>
                    <div class="flex items-center gap-4 mt-3 text-sm text-slate-500 font-semibold">
                        <span class="flex items-center gap-1.5"><i data-lucide="mail" class="w-4 h-4"></i> @Model.Email</span>
                        <span class="flex items-center gap-1.5"><i data-lucide="calendar" class="w-4 h-4"></i> Tham gia: @(Model.CreatedDate?.ToString("MM/yyyy") ?? "N/A")</span>
                    </div>
                </div>
                
                <div class="bg-cyan-50 border border-cyan-100 rounded-2xl px-5 py-3 text-center min-w-[120px]">
                    <div class="text-[10px] text-cyan-600 font-black uppercase tracking-widest mb-1">Tổng EXP</div>
                    <div class="text-2xl font-black text-slate-800">@totalEXP</div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Sidebar: Badges & Stats -->
        <div class="space-y-6">
            <!-- Badges -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-widest mb-4 flex items-center gap-2">
                    <i data-lucide="award" class="w-4 h-4 text-amber-500"></i> Huy hiệu đạt được
                </h3>
                
                @if (badges.Any())
                {
                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var badge in badges)
                        {
                            <div class="bg-slate-50 rounded-xl p-3 text-center border border-slate-100 hover:border-amber-200 transition-colors group">
                                <div class="w-10 h-10 mx-auto bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                    <i data-lucide="@(string.IsNullOrEmpty(badge.BadgeIcon) ? "star" : badge.BadgeIcon)" class="w-5 h-5"></i>
                                </div>
                                <div class="text-[10px] font-bold text-slate-700 leading-tight">@badge.BadgeName</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6 text-slate-400">
                        <i data-lucide="shield" class="w-8 h-8 mx-auto opacity-50 mb-2"></i>
                        <p class="text-xs font-semibold">Chưa có huy hiệu nào</p>
                    </div>
                }
            </div>
            
            <!-- Quick Actions -->
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
                <h3 class="text-sm font-black text-slate-800 uppercase tracking-widest mb-4">Tương tác</h3>
                <div class="space-y-2">
                    <button class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-2.5 rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
                        <i data-lucide="user-plus" class="w-4 h-4"></i> Theo dõi
                    </button>
                    <button class="w-full bg-cyan-50 hover:bg-cyan-100 text-cyan-700 font-bold py-2.5 rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
                        <i data-lucide="message-square" class="w-4 h-4"></i> Nhắn tin
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content: Recent Posts -->
        <div class="lg:col-span-2 space-y-6">
            <h3 class="text-lg font-black text-slate-800 flex items-center gap-2">
                <i data-lucide="file-text" class="w-5 h-5 text-cyan-600"></i> Bài viết gần đây
            </h3>
            
            @if (recentPosts.Any())
            {
                <div class="space-y-4">
                    @foreach (var post in recentPosts)
                    {
                        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                            <div class="flex items-start justify-between gap-4 mb-2">
                                <h4 class="font-bold text-slate-800">@post.Title</h4>
                                <span class="text-[9px] bg-cyan-50 text-cyan-600 px-2 py-0.5 rounded uppercase font-black shrink-0">@post.Category</span>
                            </div>
                            <p class="text-xs text-slate-500 line-clamp-2 mb-3">@post.Content</p>
                            <div class="flex items-center justify-between text-[10px] text-slate-400 font-semibold">
                                <span>Đăng lúc @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                <div class="flex items-center gap-3">
                                    <span class="flex items-center gap-1"><i data-lucide="thumbs-up" class="w-3 h-3"></i> @post.VoteCount</span>
                                    <span class="flex items-center gap-1"><i data-lucide="message-circle" class="w-3 h-3"></i> @post.Comments.Count</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-3xl p-12 text-center text-slate-400 border border-slate-100">
                    <i data-lucide="edit-3" class="w-10 h-10 mx-auto opacity-50 mb-3"></i>
                    <p class="font-bold">Chưa có bài viết nào</p>
                    <p class="text-xs mt-1">Người dùng này chưa có đóng góp trên diễn đàn.</p>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        lucide.createIcons();
    });
</script>
